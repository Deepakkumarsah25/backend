<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>VIP Party Live Route</title>

    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f6fa;
        color: #111827;
      }

      .topbar {
        background: linear-gradient(135deg, #0d6efd, #003c99);

        color: white;

        padding: 18px 20px;

        position: sticky;

        top: 0;

        z-index: 1000;

        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      }

      .topbar h1 {
        margin: 0 0 5px;
        font-size: 24px;
      }

      .topbar p {
        margin: 0;
        opacity: 0.9;
        font-size: 14px;
      }

      .container {
        max-width: 1400px;
        margin: auto;
        padding: 18px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 12px;

        margin-bottom: 16px;
      }

      .stat {
        background: #fff;

        border-radius: 14px;

        padding: 16px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      }

      .stat .label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 7px;
      }

      .stat .value {
        font-size: 28px;
        font-weight: 800;
      }

      .blue {
        color: #2563eb;
      }

      .orange {
        color: #ea580c;
      }

      .green {
        color: #16a34a;
      }

      .red {
        color: #dc2626;
      }

      .layout {
        display: grid;

        grid-template-columns:
          minmax(0, 2fr)
          minmax(320px, 1fr);

        gap: 16px;

        align-items: start;
      }

      .card {
        background: #fff;

        border-radius: 14px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);

        overflow: hidden;

        margin-bottom: 16px;
      }

      .card-head {
        padding: 15px 16px;

        border-bottom: 1px solid #e5e7eb;

        font-weight: 800;
      }

      #map {
        width: 100%;
        height: 560px;
      }

      .vehicle-box {
        padding: 16px;

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 10px;
      }

      .info {
        background: #f8fafc;

        padding: 12px;

        border-radius: 10px;
      }

      .info small {
        display: block;

        color: #64748b;

        margin-bottom: 4px;
      }

      .route-path {
        padding: 16px;
      }

      .path-item {
        display: flex;

        align-items: flex-start;

        gap: 10px;

        padding: 9px 0;

        border-bottom: 1px dashed #e5e7eb;
      }

      .path-item:last-child {
        border-bottom: none;
      }

      .dot {
        width: 12px;
        height: 12px;

        min-width: 12px;

        border-radius: 50%;

        margin-top: 4px;
      }

      .start {
        background: #ec4899;
      }

      .way {
        background: #2563eb;
      }

      .end {
        background: #16a34a;
      }

      .actions {
        display: flex;

        gap: 8px;

        flex-wrap: wrap;

        padding: 0 16px 16px;
      }

      .btn {
        display: inline-block;

        text-decoration: none;

        border: none;

        border-radius: 9px;

        padding: 11px 14px;

        cursor: pointer;

        font-weight: 700;

        color: #fff;
      }

      .btn-blue {
        background: #2563eb;
      }

      .btn-green {
        background: #16a34a;
      }

      .btn-gray {
        background: #475569;
      }

      .workers {
        max-height: 560px;

        overflow: auto;
      }

      .worker {
        padding: 12px 14px;

        border-bottom: 1px solid #eef2f7;
      }

      .worker-top {
        display: flex;

        justify-content: space-between;

        gap: 10px;
      }

      .worker-name {
        font-weight: 700;
      }

      .badge {
        padding: 4px 7px;

        border-radius: 999px;

        font-size: 11px;

        font-weight: 700;

        white-space: nowrap;
      }

      .badge-near {
        background: #dcfce7;
        color: #166534;
      }

      .badge-far {
        background: #f1f5f9;
        color: #64748b;
      }

      .worker-meta {
        font-size: 12px;

        color: #64748b;

        margin-top: 5px;

        line-height: 1.5;
      }

      .email-state {
        margin-top: 7px;

        font-size: 12px;

        font-weight: 700;
      }

      .last-update {
        padding: 0 16px 14px;

        color: #64748b;

        font-size: 12px;
      }

      @media (max-width: 900px) {
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .layout {
          grid-template-columns: 1fr;
        }

        #map {
          height: 440px;
        }

        .workers {
          max-height: none;
        }
      }

      @media (max-width: 520px) {
        .container {
          padding: 10px;
        }

        .stat {
          padding: 12px;
        }

        .stat .value {
          font-size: 23px;
        }

        .vehicle-box {
          grid-template-columns: 1fr;
        }

        #map {
          height: 380px;
        }
      }
    </style>

    <style>
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 14px;
      }
      .stat {
        background: #fff;
        border-radius: 14px;
        padding: 16px;
        min-height: 105px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      }
      .stat .label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 9px;
      }
      .stat .value {
        font-size: 20px;
        font-weight: 800;
        line-height: 1.3;
        word-break: break-word;
      }
      .green {
        color: #16a34a;
      }
      .blue {
        color: #2563eb;
      }
      .nav-link {
        display: inline-block;
        background: #16a34a;
        color: #fff !important;
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 800;
      }
      .refresh-btn {
        border: 0;
        background: #2563eb;
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
      }
      .map-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      }
      .map-head {
        padding: 15px 16px;
        font-weight: 800;
        border-bottom: 1px solid #e5e7eb;
      }
      #map {
        width: 100%;
        height: 600px;
      }
      @media (max-width: 900px) {
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        #map {
          height: 500px;
        }
      }
      @media (max-width: 520px) {
        .container {
          padding: 10px;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
          gap: 8px;
        }
        .stat {
          padding: 12px;
          min-height: 100px;
        }
        .stat .value {
          font-size: 17px;
        }
        .nav-link,
        .refresh-btn {
          font-size: 12px;
          padding: 9px 10px;
        }
        #map {
          height: 430px;
        }
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <h1>🚗 VIP Party Live Route</h1>
      <p id="routeTitle"><%= route.routeName %></p>
    </div>

    <div class="container">
      <div class="stats">
        <div class="stat">
          <div class="label">Live Speed</div>
          <div class="value green" id="liveSpeed">0.0 km/h</div>
        </div>

        <div class="stat">
          <div class="label">Navigation</div>
          <a
            id="navigationBtn"
            class="nav-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            >🧭 Navigate</a
          >
        </div>

        <div class="stat">
          <div class="label">From → To</div>
          <div class="value blue" id="journey">Loading...</div>
        </div>

        <div class="stat">
          <div class="label">Live Update</div>
          <button type="button" class="refresh-btn" onclick="loadStatus()">
            🔄 Refresh
          </button>
        </div>
      </div>

      <div class="map-card">
        <div class="map-head">📍 Live Vehicle Route</div>
        <div id="map"></div>
      </div>
    </div>

    <script>
      const ROUTE_ID = "<%= route._id %>";

      const map = L.map("map").setView([23.2599, 77.4126], 6);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors",
      }).addTo(map);

      let vehicleMarker = null;
      let plannedRouteLine = null;
      let travelledRouteLine = null;
      let travelledPoints = [];
      let previousPosition = null;
      let animationFrame = null;
      let firstPosition = true;

      const vehicleIcon = L.divIcon({
        className: "",
        html: `
        <div style="
          width:38px;height:38px;background:#dc2626;
          border:3px solid #fff;border-radius:50%;
          box-shadow:0 0 0 4px rgba(220,38,38,.2),
                     0 4px 12px rgba(0,0,0,.25);
          display:flex;align-items:center;justify-content:center;
          font-size:20px;
        ">🚗</div>
      `,
        iconSize: [38, 38],
        iconAnchor: [19, 19],
      });

      function validPoint(lat, lng) {
        return (
          Number.isFinite(Number(lat)) &&
          Number.isFinite(Number(lng)) &&
          !(Number(lat) === 0 && Number(lng) === 0)
        );
      }

      function updateNavigation(route) {
        if (!validPoint(route.endLat, route.endLng)) return;

        document.getElementById("navigationBtn").href =
          `https://www.google.com/maps/dir/?api=1&destination=${route.endLat},${route.endLng}&travelmode=driving`;
      }

      function animateVehicle(fromLat, fromLng, toLat, toLng) {
        if (animationFrame) cancelAnimationFrame(animationFrame);

        const start = performance.now();
        const duration = 4500;

        function frame(now) {
          const progress = Math.min((now - start) / duration, 1);
          const lat = fromLat + (toLat - fromLat) * progress;
          const lng = fromLng + (toLng - fromLng) * progress;

          if (vehicleMarker) vehicleMarker.setLatLng([lat, lng]);

          if (progress < 1) {
            animationFrame = requestAnimationFrame(frame);
          }
        }

        animationFrame = requestAnimationFrame(frame);
      }

      function updateVehicle(route) {
        if (!validPoint(route.currentLat, route.currentLng)) return;

        const lat = Number(route.currentLat);
        const lng = Number(route.currentLng);

        document.getElementById("liveSpeed").textContent =
          `${Number(route.currentSpeed || 0).toFixed(1)} km/h`;

        document.getElementById("journey").textContent =
          `${route.startLocation || "Start"} → ${route.endLocation || "Destination"}`;

        updateNavigation(route);

        if (!vehicleMarker) {
          vehicleMarker = L.marker([lat, lng], { icon: vehicleIcon }).addTo(
            map,
          );
          previousPosition = { lat, lng };
          travelledPoints = [[lat, lng]];

          travelledRouteLine = L.polyline(travelledPoints, {
            color: "#16a34a",
            weight: 7,
            opacity: 0.95,
          }).addTo(map);

          map.setView([lat, lng], 13);
          firstPosition = false;
          return;
        }

        if (previousPosition.lat !== lat || previousPosition.lng !== lng) {
          travelledPoints.push([lat, lng]);

          if (travelledRouteLine) {
            travelledRouteLine.setLatLngs(travelledPoints);
          }

          animateVehicle(previousPosition.lat, previousPosition.lng, lat, lng);

          previousPosition = { lat, lng };

          map.panTo([lat, lng], {
            animate: true,
            duration: 1,
          });
        }
      }

      async function drawPlannedRoute(route) {
        const points = [];

        if (validPoint(route.startLat, route.startLng)) {
          points.push({
            lat: Number(route.startLat),
            lng: Number(route.startLng),
          });
        }

        (route.wayPointCoords || []).forEach((point) => {
          const lat = Number(point.lat);
          const lng = Number(point.lng ?? point.lon);

          if (validPoint(lat, lng)) {
            points.push({ lat, lng });
          }
        });

        if (validPoint(route.endLat, route.endLng)) {
          points.push({
            lat: Number(route.endLat),
            lng: Number(route.endLng),
          });
        }

        if (points.length < 2) return;

        const coordString = points
          .map((point) => `${point.lng},${point.lat}`)
          .join(";");

        try {
          const response = await fetch(
            `https://router.project-osrm.org/route/v1/driving/${coordString}?overview=full&geometries=geojson`,
          );

          const data = await response.json();

          if (!data.routes?.length) return;

          const latLngs = data.routes[0].geometry.coordinates.map((point) => [
            point[1],
            point[0],
          ]);

          if (plannedRouteLine) {
            map.removeLayer(plannedRouteLine);
          }

          plannedRouteLine = L.polyline(latLngs, {
            color: "#64748b",
            weight: 5,
            opacity: 0.55,
            dashArray: "8 8",
          }).addTo(map);
        } catch (error) {
          console.error("PLANNED ROUTE ERROR:", error);
        }
      }

      async function loadStatus() {
        try {
          const response = await fetch(
            `/api/tracking/status/${ROUTE_ID}?_=${Date.now()}`,
          );

          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(data.message || "Unable to load tracking");
          }

          const route = data.route;

          document.getElementById("routeTitle").textContent =
            `${route.routeName} • ${route.status}`;

          updateVehicle(route);

          await drawPlannedRoute(route);
        } catch (error) {
          console.error("TRACK STATUS ERROR:", error);
        }
      }

      loadStatus();

      setInterval(loadStatus, 5000);
    </script>
  </body>
</html>
