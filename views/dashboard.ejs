<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Vikassheel Insaan Party</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

    <!-- ==================== HEADER ==================== -->
    <%- include('common/header.ejs') %>

    <!-- ==================== SIDEBAR ==================== -->
    <%- include('common/sidebar.ejs') %>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="main-content">
        <div class="dashboard-container">
            
            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Dashboard</h1>
                    <p class="page-subtitle">
                        Welcome back, <strong><%= locals.admin ? locals.admin.name : 'Admin' %></strong> 
                        (<%= locals.admin ? locals.admin.email : 'admin@vipparty.com' %>) &bull; Multi-Admin Activity Tracking Active
                    </p>
                </div>
            </div>

            <!-- =========================================================
                 RECENT ADMIN UPDATES (LAST 2 EDITORS AUDIT TRAIL)
            ========================================================= -->
            <section class="admin-audit-section" id="adminAuditSection">
                <div class="audit-section-header">
                    <div class="audit-title-group">
                        <div class="audit-badge-pill">
                            <i class="fa-solid fa-users-gear"></i> Multi-Admin Audit Trail
                        </div>
                        <h2 class="audit-section-title">Recent Modifications by Admins</h2>
                        <p class="audit-section-desc">
                            Click the button to open and view the last 2 administrators who updated or changed sections in the admin panel.
                        </p>
                    </div>

                    <div class="audit-header-actions" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <a href="/activity-logs" class="btn-toggle-audit" style="text-decoration: none; background: #0b4ea2; color: #ffffff; border-color: #0b4ea2; display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <span>10-Day Activity Log</span>
                            <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 11px;"></i>
                        </a>
                        <button type="button" class="btn-toggle-audit" id="btnToggleAudit" onclick="toggleAuditDrawer()">
                            <i class="fa-solid fa-users-viewfinder"></i>
                            <span id="btnAuditText">View Last 2 Users Data</span>
                            <i class="fa-solid fa-chevron-down" id="chevronAuditIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Collapsible Drawer (Hidden by default, opens on click) -->
                <div class="audit-drawer-container" id="auditDrawerContainer" style="display: none;">
                    <div class="audit-drawer-bar">
                        <div class="audit-drawer-bar-title">
                            <span class="pulse-indicator"></span>
                            <strong>Audit Trail:</strong> Last 2 Active Users Modification Details
                        </div>
                        <button type="button" class="btn-drawer-close" onclick="toggleAuditDrawer()" title="Close details">
                            <i class="fa-solid fa-xmark"></i> Hide Details
                        </button>
                    </div>

                    <div class="audit-cards-grid">
                        <!-- PERSON 1: Most Recent Modifier -->
                        <% if (lastTwoEditors && lastTwoEditors[0]) { %>
                            <div class="modifier-card modifier-card-latest">
                                <div class="modifier-header">
                                    <span class="modifier-rank-badge rank-1">
                                        <i class="fa-solid fa-crown"></i> Latest Modifier (1st Person)
                                    </span>
                                    <span class="time-chip" title="<%= lastTwoEditors[0].exactTime %>">
                                        <i class="fa-regular fa-clock"></i> <%= lastTwoEditors[0].timeAgo %>
                                    </span>
                                </div>

                                <div class="modifier-user-row">
                                    <div class="modifier-avatar avatar-latest">
                                        <%= lastTwoEditors[0].adminName ? lastTwoEditors[0].adminName.substring(0, 2).toUpperCase() : 'AD' %>
                                    </div>
                                    <div class="modifier-info">
                                        <h4 class="modifier-name"><%= lastTwoEditors[0].adminName || 'Admin' %></h4>
                                        <div class="modifier-email-wrap">
                                            <i class="fa-solid fa-envelope"></i>
                                            <span class="modifier-email"><%= lastTwoEditors[0].adminEmail %></span>
                                        </div>
                                    </div>
                                    <span class="role-badge">
                                        <%= lastTwoEditors[0].adminRole || 'Admin' %>
                                    </span>
                                </div>

                                <div class="modifier-body">
                                    <div class="section-tag-row">
                                        <span class="section-label-prefix">Changed Section:</span>
                                        <span class="section-tag section-tag-active">
                                            <i class="<%= lastTwoEditors[0].sectionIcon || 'fa-solid fa-pen-to-square' %>"></i>
                                            <strong><%= lastTwoEditors[0].section %></strong>
                                        </span>
                                    </div>

                                    <div class="change-detail-box">
                                        <div class="change-action-title">
                                            <i class="fa-solid fa-circle-check"></i> <%= lastTwoEditors[0].action %>
                                        </div>
                                        <% if (lastTwoEditors[0].details) { %>
                                            <p class="change-desc"><%= lastTwoEditors[0].details %></p>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="modifier-footer">
                                    <div class="timestamp-subtext">
                                        <i class="fa-solid fa-calendar-days"></i> <%= lastTwoEditors[0].exactTime %>
                                    </div>
                                    <span class="status-live-chip">
                                        <span class="dot-live"></span> Most Recent Update
                                    </span>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="modifier-card">
                                <p style="color: #64748b; font-size: 13px;">No admin modifications recorded yet.</p>
                            </div>
                        <% } %>

                        <!-- PERSON 2: 2nd Last / Previous Modifier -->
                        <% if (lastTwoEditors && lastTwoEditors[1]) { %>
                            <div class="modifier-card modifier-card-previous">
                                <div class="modifier-header">
                                    <span class="modifier-rank-badge rank-2">
                                        <i class="fa-solid fa-clock-rotate-left"></i> Previous Modifier (2nd Person)
                                    </span>
                                    <span class="time-chip" title="<%= lastTwoEditors[1].exactTime %>">
                                        <i class="fa-regular fa-clock"></i> <%= lastTwoEditors[1].timeAgo %>
                                    </span>
                                </div>

                                <div class="modifier-user-row">
                                    <div class="modifier-avatar avatar-previous">
                                        <%= lastTwoEditors[1].adminName ? lastTwoEditors[1].adminName.substring(0, 2).toUpperCase() : 'AD' %>
                                    </div>
                                    <div class="modifier-info">
                                        <h4 class="modifier-name"><%= lastTwoEditors[1].adminName || 'Admin' %></h4>
                                        <div class="modifier-email-wrap">
                                            <i class="fa-solid fa-envelope"></i>
                                            <span class="modifier-email"><%= lastTwoEditors[1].adminEmail %></span>
                                        </div>
                                    </div>
                                    <span class="role-badge">
                                        <%= lastTwoEditors[1].adminRole || 'Admin' %>
                                    </span>
                                </div>

                                <div class="modifier-body">
                                    <div class="section-tag-row">
                                        <span class="section-label-prefix">Changed Section:</span>
                                        <span class="section-tag section-tag-muted">
                                            <i class="<%= lastTwoEditors[1].sectionIcon || 'fa-solid fa-pen-to-square' %>"></i>
                                            <strong><%= lastTwoEditors[1].section %></strong>
                                        </span>
                                    </div>

                                    <div class="change-detail-box">
                                        <div class="change-action-title">
                                            <i class="fa-solid fa-circle-check"></i> <%= lastTwoEditors[1].action %>
                                        </div>
                                        <% if (lastTwoEditors[1].details) { %>
                                            <p class="change-desc"><%= lastTwoEditors[1].details %></p>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="modifier-footer">
                                    <div class="timestamp-subtext">
                                        <i class="fa-solid fa-calendar-days"></i> <%= lastTwoEditors[1].exactTime %>
                                    </div>
                                    <span class="status-prior-chip">
                                        <span class="dot-prior"></span> Previous Update
                                    </span>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="modifier-card" style="display: flex; align-items: center; justify-content: center; text-align: center; padding: 40px 20px;">
                                <div>
                                    <i class="fa-solid fa-user-clock" style="font-size: 36px; color: #94a3b8; margin-bottom: 10px;"></i>
                                    <h4 style="font-size: 15px; color: #1e293b; margin-bottom: 4px;">Awaiting 2nd Admin Activity</h4>
                                    <p style="font-size: 12.5px; color: #64748b;">Log in with another email or make a second change to compare the last 2 editors.</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-number">1,284</h3>
                        <p class="stat-label">Total Member</p>
                        <span class="stat-trend positive">
                            <i class="fas fa-arrow-up"></i> 12.5%
                        </span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="fas fa-route"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-number">46</h3>
                        <p class="stat-label">Active Routes</p>
                        <span class="stat-trend positive">
                            <i class="fas fa-arrow-up"></i> 8.3%
                        </span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <i class="fas fa-car"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-number">32</h3>
                        <p class="stat-label">Active Drivers</p>
                        <span class="stat-trend neutral">
                            <i class="fas fa-minus"></i> 0%
                        </span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-number">89</h3>
                        <p class="stat-label">Live Updates</p>
                        <span class="stat-trend positive">
                            <i class="fas fa-arrow-up"></i> 23.7%
                        </span>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="dashboard-grid">
                <!-- Chart Card -->
                <div class="card chart-card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">Worker Activity Overview</h3>
                            <p class="card-subtitle">Last 7 days performance</p>
                        </div>
                        <div class="card-actions">
                            <select class="filter-select">
                                <option>This Week</option>
                                <option>This Month</option>
                                <option>This Year</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart-placeholder">
                            <div class="bar-chart">
                                <div class="bar-item">
                                    <div class="bar" style="height: 65%;"></div>
                                    <span class="bar-label">Mon</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 80%;"></div>
                                    <span class="bar-label">Tue</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 45%;"></div>
                                    <span class="bar-label">Wed</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 90%;"></div>
                                    <span class="bar-label">Thu</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 70%;"></div>
                                    <span class="bar-label">Fri</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 55%;"></div>
                                    <span class="bar-label">Sat</span>
                                </div>
                                <div class="bar-item">
                                    <div class="bar" style="height: 85%;"></div>
                                    <span class="bar-label">Sun</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions-section">
                <h3 class="section-title">Quick Actions</h3>
                <div class="quick-actions-grid">
                    <a href="/member" class="quick-action-card">
                        <div class="qa-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h4>Add Worker</h4>
                        <p>Register new party worker</p>
                    </a>
                    <a href="/route" class="quick-action-card">
                        <div class="qa-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <i class="fas fa-route"></i>
                        </div>
                        <h4>Manage Routes</h4>
                        <p>Add or update routes</p>
                    </a>
                    <a href="/driver" class="quick-action-card">
                        <div class="qa-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                            <i class="fas fa-car"></i>
                        </div>
                        <h4>Driver Management</h4>
                        <p>Add or manage drivers</p>
                    </a>
                    <a href="/bainar" class="quick-action-card">
                        <div class="qa-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                            <i class="fas fa-bullhorn"></i>
                        </div>
                        <h4>Live Updates</h4>
                        <p>Post live party updates</p>
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- ==================== SCRIPTS ==================== -->
    <script>
        function toggleAuditDrawer() {
            const drawer = document.getElementById('auditDrawerContainer');
            const btnText = document.getElementById('btnAuditText');
            const chevron = document.getElementById('chevronAuditIcon');
            const btn = document.getElementById('btnToggleAudit');

            if (!drawer) return;

            const isCurrentlyHidden = drawer.style.display === 'none' || window.getComputedStyle(drawer).display === 'none';

            if (isCurrentlyHidden) {
                drawer.style.display = 'block';
                drawer.classList.remove('closed');
                drawer.classList.add('open');
                if (btnText) btnText.textContent = 'Hide Last 2 Users Data';
                if (chevron) {
                    chevron.classList.remove('fa-chevron-down');
                    chevron.classList.add('fa-chevron-up');
                }
                if (btn) btn.classList.add('active');
                
                // Smooth scroll to the audit section if not fully in view
                drawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                drawer.style.display = 'none';
                drawer.classList.remove('open');
                drawer.classList.add('closed');
                if (btnText) btnText.textContent = 'View Last 2 Users Data';
                if (chevron) {
                    chevron.classList.remove('fa-chevron-up');
                    chevron.classList.add('fa-chevron-down');
                }
                if (btn) btn.classList.remove('active');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('responsiveSidebar');
            const isMobile = window.innerWidth <= 992;
            
            if (!isMobile) {
                document.body.classList.remove('sidebar-collapsed');
            } else {
                if (sidebar) {
                    sidebar.classList.remove('sidebar-open');
                }
            }
        });
    </script>
</body>
</html>