<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Event - <%= event.title %> | VIP Admin</title>

  <!-- Sidebar & Header CSS -->
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/sidebar.css" />

  <!-- Font Awesome 6.5.2 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Inter, Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    /* =========================
       MAIN WRAPPER
    ========================= */
    .events-page-wrap {
      padding: 24px 30px;
      width: 100%;
      box-sizing: border-box;
      max-width: 1500px;
      margin: 0 auto;
    }

    /* =========================
       HEADER
    ========================= */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
      flex-wrap: wrap;
    }

    .title {
      font-size: 28px;
      font-weight: 800;
      margin: 0;
      color: #172033;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .subtitle {
      color: #64748b;
      margin-top: 6px;
      font-size: 14px;
    }

    .header-right {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    /* =========================
       CARD
    ========================= */
    .card {
      background: #ffffff;
      border-radius: 20px;
      padding: 28px;
      margin-bottom: 25px;
      box-shadow: 0 5px 25px rgba(15, 23, 42, 0.07);
      border: 1px solid #edf1f6;
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-bottom: 18px;
      margin-bottom: 24px;
      border-bottom: 1px solid #edf1f6;
    }

    .card-header-icon {
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: #eaf2ff;
      color: #1d4ed8;
      font-size: 20px;
      flex-shrink: 0;
    }

    .card-header h2 {
      margin: 0;
      font-size: 20px;
      font-weight: 800;
      color: #172033;
    }

    .card-header p {
      margin: 4px 0 0;
      color: #94a3b8;
      font-size: 13px;
    }

    /* =========================
       FORM GRID
    ========================= */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .full {
      grid-column: 1 / -1;
    }

    .form-group {
      width: 100%;
    }

    label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 8px;
      color: #334155;
    }

    .required {
      color: #dc2626;
    }

    .optional {
      color: #94a3b8;
      font-size: 11px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="date"],
    input[type="time"],
    textarea,
    select {
      width: 100%;
      border: 1px solid #dbe2ea;
      border-radius: 12px;
      padding: 13px 15px;
      font-size: 14px;
      outline: none;
      background: #fff;
      color: #172033;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #1d4ed8;
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
    }

    textarea {
      min-height: 140px;
      resize: vertical;
      line-height: 1.6;
    }

    .full-description {
      min-height: 200px;
    }

    .field-help {
      margin-top: 6px;
      font-size: 11px;
      color: #94a3b8;
    }

    .counter {
      color: #94a3b8;
      font-size: 11px;
      font-weight: 600;
    }

    /* =========================
       COLOR PICKER
    ========================= */
    .color-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .color-input {
      width: 58px;
      height: 46px;
      padding: 4px;
      border: 1px solid #dbe2ea;
      border-radius: 12px;
      cursor: pointer;
      background: #fff;
    }

    .color-value {
      font-size: 13px;
      color: #334155;
      font-weight: 800;
      font-family: monospace;
      padding: 6px 10px;
      background: #f1f5f9;
      border-radius: 8px;
    }

    .color-presets {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      align-items: center;
    }

    .color-preset-dot {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      cursor: pointer;
      border: 2px solid #fff;
      box-shadow: 0 2px 5px rgba(0,0,0,0.15);
      transition: transform 0.15s;
    }

    .color-preset-dot:hover {
      transform: scale(1.15);
    }

    /* =========================
       EXISTING IMAGES GALLERY
    ========================= */
    .existing-gallery-section {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 20px;
    }

    .existing-gallery-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .existing-gallery-title {
      font-size: 13px;
      font-weight: 800;
      color: #1e293b;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .existing-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
    }

    .existing-gallery-item {
      position: relative;
      height: 120px;
      border-radius: 12px;
      overflow: hidden;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    .existing-gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .existing-cover-badge {
      position: absolute;
      top: 6px;
      left: 6px;
      padding: 4px 8px;
      background: #1d4ed8;
      color: #fff;
      border-radius: 6px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .existing-photo-num {
      position: absolute;
      bottom: 6px;
      right: 6px;
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
    }

    /* =========================
       NEW IMAGE UPLOAD
    ========================= */
    .upload-box {
      border: 2px dashed #cbd5e1;
      border-radius: 16px;
      padding: 25px;
      text-align: center;
      background: #fafcff;
      transition: 0.2s;
      cursor: pointer;
    }

    .upload-box:hover {
      border-color: #1d4ed8;
      background: #f1f5ff;
    }

    .upload-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: #eaf2ff;
      color: #1d4ed8;
      font-size: 22px;
    }

    .upload-title {
      font-size: 15px;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 4px;
    }

    .upload-description {
      color: #94a3b8;
      font-size: 12px;
    }

    .upload-input {
      margin-top: 14px;
      cursor: pointer;
    }

    .image-count {
      margin-top: 10px;
      font-size: 12px;
      font-weight: 800;
      color: #1d4ed8;
    }

    .preview-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
      margin-top: 16px;
    }

    .preview-item {
      position: relative;
      height: 120px;
      border-radius: 12px;
      overflow: hidden;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
    }

    .preview-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cover-label {
      position: absolute;
      top: 6px;
      left: 6px;
      padding: 4px 8px;
      background: #1d4ed8;
      color: #fff;
      border-radius: 6px;
      font-size: 9px;
      font-weight: 800;
      z-index: 2;
    }

    .image-number {
      position: absolute;
      bottom: 6px;
      left: 6px;
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
    }

    /* =========================
       CHECKBOXES
    ========================= */
    .check-boxes {
      display: flex;
      gap: 25px;
      flex-wrap: wrap;
      padding: 16px 20px;
      background: #f8fafc;
      border-radius: 14px;
      border: 1px solid #edf1f6;
    }

    .check-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      font-size: 14px;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
    }

    .check-label input[type="checkbox"] {
      width: 19px;
      height: 19px;
      accent-color: #1d4ed8;
      cursor: pointer;
    }

    /* =========================
       BUTTONS
    ========================= */
    .form-actions {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 24px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      border: none;
      font-family: inherit;
    }

    .btn-primary {
      background: #1d4ed8;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(29, 78, 216, 0.25);
    }

    .btn-primary:hover {
      background: #1e40af;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(29, 78, 216, 0.35);
    }

    .btn-secondary {
      background: #ffffff;
      color: #475569;
      border: 1px solid #dbe2ea;
    }

    .btn-secondary:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    /* =========================
       RESPONSIVE
    ========================= */
    @media (max-width: 900px) {
      .events-page-wrap {
        padding: 16px;
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .card {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

  <!-- Admin Navigation Partials -->
  <%- include("../common/header.ejs") %>
  <%- include("../common/sidebar.ejs") %>

  <!-- Main Content Wrap -->
  <main class="main-content">
    <div class="events-page-wrap">

      <!-- =========================================
           PAGE HEADER & BREADCRUMB
      ========================================== -->
      <div class="header">
        <div>
          <h1 class="title">
            <i class="fa-solid fa-pen-to-square" style="color:#1d4ed8;"></i>
            Edit Event
          </h1>
          <div class="subtitle">
            Update event details, location, schedule, and photos for the VIP mobile application & website
          </div>
        </div>

        <div class="header-right">
          <a href="/admin/events" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to All Events
          </a>
        </div>
      </div>

      <!-- =========================================
           EDIT EVENT FORM CARD
      ========================================== -->
      <div class="card">
        <div class="card-header">
          <div class="card-header-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <h2>Edit Event Details</h2>
            <p>ID: <%= event._id %> | Created: <%= event.createdAt ? new Date(event.createdAt).toLocaleDateString('en-IN') : 'N/A' %></p>
          </div>
        </div>

        <form
          id="editEventForm"
          action="/admin/events/update/<%= event._id %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="form-grid">

            <!-- Title -->
            <div class="form-group full">
              <label for="title">
                <span>Event Title <span class="required">*</span></span>
                <span class="counter" id="titleCounter">0 / 150</span>
              </label>
              <input
                id="title"
                type="text"
                name="title"
                maxlength="150"
                value="<%= event.title %>"
                placeholder="Example: National Executive Meeting 2026"
                required
              />
              <div class="field-help">This title appears prominently on event cards in both the app and website.</div>
            </div>

            <!-- Location -->
            <div class="form-group">
              <label for="location">
                <span>Location <span class="required">*</span></span>
              </label>
              <input
                id="location"
                type="text"
                name="location"
                value="<%= event.location %>"
                placeholder="City, District, Ground or Hall"
                required
              />
              <div class="field-help">Example: Gandhi Maidan, Patna or Bhopal</div>
            </div>

            <!-- Event Date -->
            <div class="form-group">
              <label for="eventDate">
                <span>Event Date <span class="required">*</span></span>
              </label>
              <%
                let dateVal = '';
                try {
                  if (event.eventDate) {
                    dateVal = new Date(event.eventDate).toISOString().slice(0, 10);
                  }
                } catch(e) {}
              %>
              <input
                id="eventDate"
                type="date"
                name="eventDate"
                value="<%= dateVal %>"
                required
              />
              <div class="field-help">Scheduled date of the event.</div>
            </div>

            <!-- Event Time -->
            <div class="form-group">
              <label for="eventTime">
                <span>Event Time <span class="optional">Optional</span></span>
              </label>
              <input
                id="eventTime"
                type="text"
                name="eventTime"
                value="<%= event.eventTime || '' %>"
                placeholder="Example: 04:55 PM or 10:30 AM"
              />
              <div class="field-help">Start time or schedule details (e.g. 10:30 AM).</div>
            </div>

            <!-- Tag & Tag Color -->
            <div class="form-group">
              <label for="tag">
                <span>Category Tag <span class="optional">Optional</span></span>
              </label>
              <input
                id="tag"
                type="text"
                name="tag"
                value="<%= event.tag || 'Event' %>"
                placeholder="Event, Rally, Meeting, Press Conference"
              />
              <div class="field-help">A badge tag displayed over the event card.</div>
            </div>

            <div class="form-group">
              <label for="tagColor">
                <span>Tag Badge Color</span>
              </label>
              <div class="color-wrapper">
                <input
                  id="tagColor"
                  class="color-input"
                  type="color"
                  name="tagColor"
                  value="<%= event.tagColor || '#1d4ed8' %>"
                />
                <span class="color-value" id="colorValue"><%= event.tagColor || '#1d4ed8' %></span>
              </div>
              <div class="color-presets">
                <div class="color-preset-dot" style="background:#1d4ed8;" onclick="setPresetColor('#1d4ed8')" title="Royal Blue"></div>
                <div class="color-preset-dot" style="background:#d71d55;" onclick="setPresetColor('#d71d55')" title="Rose Pink"></div>
                <div class="color-preset-dot" style="background:#059669;" onclick="setPresetColor('#059669')" title="Emerald Green"></div>
                <div class="color-preset-dot" style="background:#d97706;" onclick="setPresetColor('#d97706')" title="Amber Orange"></div>
                <div class="color-preset-dot" style="background:#7c3aed;" onclick="setPresetColor('#7c3aed')" title="Purple"></div>
                <div class="color-preset-dot" style="background:#dc2626;" onclick="setPresetColor('#dc2626')" title="Red"></div>
              </div>
            </div>

            <!-- Description -->
            <div class="form-group full">
              <label for="description">
                <span>Event Description <span class="optional">Optional</span></span>
                <span class="counter" id="descCounter">0 / 5000</span>
              </label>
              <textarea
                id="description"
                name="description"
                class="full-description"
                maxlength="5000"
                placeholder="Detailed event program, agenda, organizers, and invitation details..."
              ><%= event.description || '' %></textarea>
              <div class="field-help">Full description for event details view. Line breaks will be preserved.</div>
            </div>

            <!-- Existing Images Section -->
            <div class="form-group full">
              <% const existingImages = Array.isArray(event.images) ? event.images.filter(Boolean) : []; %>
              <div class="existing-gallery-section">
                <div class="existing-gallery-header">
                  <div class="existing-gallery-title">
                    <i class="fa-solid fa-images" style="color:#1d4ed8;"></i>
                    Current Photo Gallery (<%= existingImages.length %> <%= existingImages.length === 1 ? 'image' : 'images' %>)
                  </div>
                  <span style="font-size:12px; color:#64748b; font-weight:600;">
                    First image serves as the Main Cover
                  </span>
                </div>

                <% if (existingImages.length > 0) { %>
                  <div class="existing-gallery-grid">
                    <% existingImages.forEach((img, idx) => { %>
                      <div class="existing-gallery-item">
                        <img src="<%= img %>" alt="Event photo <%= idx + 1 %>" loading="lazy">
                        <% if (idx === 0) { %>
                          <div class="existing-cover-badge">
                            <i class="fa-solid fa-star"></i> COVER
                          </div>
                        <% } %>
                        <div class="existing-photo-num"><%= idx + 1 %></div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p style="margin:0; font-size:13px; color:#94a3b8; font-style:italic;">No photos currently attached to this event.</p>
                <% } %>
              </div>
            </div>

            <!-- Upload Replacement Images -->
            <div class="form-group full">
              <label>
                <span>Upload New Gallery Photos <span class="optional">Leave blank to keep existing photos</span></span>
                <span style="font-size:11px; color:#94a3b8;">Max 10 images (JPEG, PNG, WEBP, max 5MB each)</span>
              </label>

              <div class="upload-box" onclick="document.getElementById('eventImages').click();">
                <div class="upload-icon">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <div class="upload-title">Click to browse or drag & drop replacement photos</div>
                <div class="upload-description">
                  Selecting new photos will replace the current gallery upon saving.
                </div>

                <input
                  id="eventImages"
                  class="upload-input"
                  type="file"
                  name="images"
                  multiple
                  accept="image/jpeg,image/jpg,image/png,image/webp"
                  style="display:none;"
                />

                <div class="image-count" id="imageCount">
                  No replacement images selected
                </div>

                <div class="preview-container" id="imagePreview"></div>
              </div>
            </div>

            <!-- Status Checkboxes -->
            <div class="form-group full">
              <div class="check-boxes">
                <label class="check-label">
                  <input
                    type="checkbox"
                    name="published"
                    <%= event.published ? 'checked' : '' %>
                  />
                  <span>Published (Visible to public in Mobile App & Website)</span>
                </label>

                <label class="check-label">
                  <input
                    type="checkbox"
                    name="featured"
                    <%= event.featured ? 'checked' : '' %>
                  />
                  <span>Featured (Highlighted prominently with gold star badge)</span>
                </label>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-group full">
              <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="submitBtn">
                  <i class="fa-solid fa-floppy-disk"></i>
                  Save & Update Event
                </button>
                <a href="/admin/events" class="btn btn-secondary">
                  <i class="fa-solid fa-xmark"></i>
                  Cancel
                </a>
              </div>
            </div>

          </div>
        </form>
      </div>

    </div>
  </main>

  <!-- =========================================
       CLIENT-SIDE SCRIPTS
  ========================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const titleInput = document.getElementById('title');
      const titleCounter = document.getElementById('titleCounter');
      const descInput = document.getElementById('description');
      const descCounter = document.getElementById('descCounter');
      const colorInput = document.getElementById('tagColor');
      const colorVal = document.getElementById('colorValue');
      const eventImages = document.getElementById('eventImages');
      const imagePreview = document.getElementById('imagePreview');
      const imageCount = document.getElementById('imageCount');

      // Update counters
      function updateCounter(input, display, max) {
        if (!input || !display) return;
        const len = input.value.length;
        display.textContent = `${len} / ${max}`;
      }

      if (titleInput && titleCounter) {
        updateCounter(titleInput, titleCounter, 150);
        titleInput.addEventListener('input', () => updateCounter(titleInput, titleCounter, 150));
      }

      if (descInput && descCounter) {
        updateCounter(descInput, descCounter, 5000);
        descInput.addEventListener('input', () => updateCounter(descInput, descCounter, 5000));
      }

      // Color picker sync
      if (colorInput && colorVal) {
        colorInput.addEventListener('input', function () {
          colorVal.textContent = this.value;
        });
      }

      window.setPresetColor = function (hex) {
        if (colorInput) colorInput.value = hex;
        if (colorVal) colorVal.textContent = hex;
      };

      // File selection preview
      if (eventImages && imagePreview && imageCount) {
        eventImages.addEventListener('change', function () {
          imagePreview.innerHTML = '';
          const files = Array.from(this.files || []);

          if (files.length === 0) {
            imageCount.textContent = 'No replacement images selected';
            return;
          }

          if (files.length > 10) {
            alert('A maximum of 10 images can be uploaded.');
            this.value = '';
            imageCount.textContent = 'No replacement images selected';
            return;
          }

          imageCount.textContent = `${files.length} replacement ${files.length === 1 ? 'image' : 'images'} selected (first will be cover)`;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];

          files.forEach(function (file, index) {
            if (!allowedTypes.includes(file.type)) {
              alert(`${file.name} is not a supported image format.`);
              return;
            }

            if (file.size > 5 * 1024 * 1024) {
              alert(`${file.name} is larger than 5 MB.`);
              return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
              const item = document.createElement('div');
              item.className = 'preview-item';
              item.innerHTML = `
                <img src="${e.target.result}" alt="Preview ${index + 1}" />
                ${index === 0 ? '<div class="cover-label"><i class="fa-solid fa-star"></i> NEW COVER</div>' : ''}
                <div class="image-number">${index + 1}</div>
              `;
              imagePreview.appendChild(item);
            };
            reader.readAsDataURL(file);
          });
        });
      }
    });
  </script>
</body>
</html>
