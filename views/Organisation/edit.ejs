<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Organisation Member</title>

<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/sidebar.css">

<style>

.content{
    margin-left:260px;
    padding:30px;
}

.card{
    max-width:800px;
    background:#fff;
    padding:25px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.1);
}

h2{
    margin-bottom:20px;
}

label{
    display:block;
    margin-top:15px;
    font-weight:bold;
}

input,
textarea,
select{
    width:100%;
    padding:12px;
    margin-top:6px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:15px;
}

textarea{
    resize:none;
    height:100px;
}

button{
    margin-top:25px;
    background:#0d6efd;
    color:#fff;
    border:none;
    padding:12px 25px;
    border-radius:6px;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:#0b5ed7;
}

.preview{
    margin-top:10px;
}

.preview img{
    width:120px;
    border-radius:8px;
    border:1px solid #ddd;
}

.error-text{
    color:#dc3545;
    font-size:13px;
    margin-top:4px;
    display:none;
}

input.invalid,
textarea.invalid,
select.invalid{
    border-color:#dc3545;
}

</style>

</head>

<body>

<%- include("../common/sidebar") %>

<div class="content">

<div class="card">

<h2>Edit Organisation Member</h2>

<form
id="orgForm"
action="/organisation/update/<%= organisation._id %>"
method="POST"
enctype="multipart/form-data"
novalidate
>

<label>Category</label>

<select name="category" id="category" required>

<option value="">Select Category</option>

<option value="State President" <%= organisation.category==="State President" ? "selected" : "" %>>State President</option>

<option value="State Office Bearers" <%= organisation.category==="State Office Bearers" ? "selected" : "" %>>State Office Bearers</option>

<option value="District Presidents" <%= organisation.category==="District Presidents" ? "selected" : "" %>>District Presidents</option>

<option value="State Executive Members" <%= organisation.category==="State Executive Members" ? "selected" : "" %>>State Executive Members</option>

<option value="Spokespersons" <%= organisation.category==="Spokespersons" ? "selected" : "" %>>Spokespersons</option>

<option value="Morchas & Cells" <%= organisation.category==="Morchas & Cells" ? "selected" : "" %>>Morchas & Cells</option>

<option value="Permanent Invitees" <%= organisation.category==="Permanent Invitees" ? "selected" : "" %>>Permanent Invitees</option>

<option value="Special Invitees" <%= organisation.category==="Special Invitees" ? "selected" : "" %>>Special Invitees</option>

<option value="Committees" <%= organisation.category==="Committees" ? "selected" : "" %>>Committees</option>

<option value="State Prabhari" <%= organisation.category==="State Prabhari" ? "selected" : "" %>>State Prabhari</option>

<option value="State General Secretary (ORG.)" <%= organisation.category==="State General Secretary (ORG.)" ? "selected" : "" %>>State General Secretary (ORG.)</option>

<option value="Departments" <%= organisation.category==="Departments" ? "selected" : "" %>>Departments</option>

</select>
<span class="error-text" id="categoryError">Please select a category.</span>

<label>Name</label>

<input
type="text"
name="name"
id="name"
value="<%= organisation.name %>"
minlength="3"
maxlength="60"
required
>
<span class="error-text" id="nameError">Name should be 3–60 letters (spaces allowed).</span>

<label>Designation</label>

<input
type="text"
name="designation"
id="designation"
value="<%= organisation.designation %>"
minlength="2"
maxlength="80"
required
>
<span class="error-text" id="designationError">Designation should be 2–80 characters.</span>

<label>Address</label>

<textarea name="address" id="address" maxlength="250"><%= organisation.address %></textarea>
<span class="error-text" id="addressError">Address must be under 250 characters.</span>

<label>Phone</label>

<input
type="text"
name="phone"
id="phone"
value="<%= organisation.phone %>"
maxlength="10"
inputmode="numeric"
>
<span class="error-text" id="phoneError">Enter a valid 10-digit phone number.</span>

<label>Email</label>

<input
type="email"
name="email"
id="email"
value="<%= organisation.email %>"
>
<span class="error-text" id="emailError">Enter a valid email address.</span>

<label>Fax</label>

<input
type="text"
name="fax"
id="fax"
value="<%= organisation.fax %>"
maxlength="20"
>
<span class="error-text" id="faxError">Fax should be under 20 characters.</span>

<label>Current Photo</label>

<div class="preview">
<img
  src="<%= organisation.imageUrl %>"
  alt="Organisation Image"
  width="120"
>
</div>

<label>Change Photo</label>

<input
type="file"
name="image"
id="image"
accept="image/*"
>
<span class="error-text" id="imageError">Please select a valid image (max 5 MB).</span>

<button type="submit">
Update Organisation
</button>

</form>

</div>

</div>

<script>

const form = document.getElementById("orgForm");

const fields = {
  category: {
    el: document.getElementById("category"),
    error: document.getElementById("categoryError"),
    validate: (v) => v.trim() !== "",
  },
  name: {
    el: document.getElementById("name"),
    error: document.getElementById("nameError"),
    validate: (v) => /^[A-Za-zÀ-ÿ\s.'-]{3,60}$/.test(v.trim()),
  },
  designation: {
    el: document.getElementById("designation"),
    error: document.getElementById("designationError"),
    validate: (v) => v.trim().length >= 2 && v.trim().length <= 80,
  },
  address: {
    el: document.getElementById("address"),
    error: document.getElementById("addressError"),
    validate: (v) => v.trim().length <= 250,
  },
  phone: {
    el: document.getElementById("phone"),
    error: document.getElementById("phoneError"),
    validate: (v) => v.trim() === "" || /^[6-9]\d{9}$/.test(v.trim()),
  },
  email: {
    el: document.getElementById("email"),
    error: document.getElementById("emailError"),
    validate: (v) =>
      v.trim() === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),
  },
  fax: {
    el: document.getElementById("fax"),
    error: document.getElementById("faxError"),
    validate: (v) => v.trim().length <= 20,
  },
};

function validateField(key) {
  const field = fields[key];
  const value = field.el.value;
  const isValid = field.validate(value);

  if (isValid) {
    field.el.classList.remove("invalid");
    field.error.style.display = "none";
  } else {
    field.el.classList.add("invalid");
    field.error.style.display = "block";
  }

  return isValid;
}

Object.keys(fields).forEach((key) => {
  fields[key].el.addEventListener("input", () => validateField(key));
  fields[key].el.addEventListener("blur", () => validateField(key));
});

// Image validation (optional on edit — only checked if user picks a new file)
const imageInput = document.getElementById("image");
const imageError = document.getElementById("imageError");

imageInput.addEventListener("change", function () {
  if (this.files.length) {
    const file = this.files[0];
    const maxSize = 5 * 1024 * 1024; // 5 MB

    if (!file.type.startsWith("image/")) {
      imageError.textContent = "Please select an image file.";
      imageError.style.display = "block";
      this.value = "";
    } else if (file.size > maxSize) {
      imageError.textContent = "Image size must be under 5 MB.";
      imageError.style.display = "block";
      this.value = "";
    } else {
      imageError.style.display = "none";
    }
  }
});

form.addEventListener("submit", function (e) {
  let isFormValid = true;

  Object.keys(fields).forEach((key) => {
    if (!validateField(key)) {
      isFormValid = false;
    }
  });

  if (!isFormValid) {
    e.preventDefault();
  }
});

</script>

</body>
</html>