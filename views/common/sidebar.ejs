<!-- =========================================================
     SIDEBAR INTERACTIVE JAVASCRIPT (ZERO COMPANE & STABLE SCROLL)
========================================================= -->
<script>
  (function () {
    const sidebar = document.getElementById("responsiveSidebar");
    const scrollContainer = document.getElementById("sidebarScrollContent");
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const backdrop = document.getElementById("sidebarBackdrop");
    const collapseBtn = document.getElementById("desktopCollapse");

    if (!sidebar) return;

    const parents = sidebar.querySelectorAll(".sidebar-parent");
    const submenuLinks = sidebar.querySelectorAll(".sidebar-submenu a");
    const directLinks = sidebar.querySelectorAll(".direct-link");
    const currentPath = window.location.pathname;

    const storageKeyGroups = "vip_admin_open_groups";
    const storageKeyScroll = "vip_admin_sidebar_scroll";
    const storageKeyCollapsed = "vip_admin_sidebar_collapsed";

    // 1. RESTORE DESKTOP COLLAPSE STATE
    try {
      const isCollapsed = localStorage.getItem(storageKeyCollapsed) === "true";
      if (isCollapsed && window.innerWidth > 992) {
        sidebar.classList.add("collapsed");
        document.body.classList.add("sidebar-collapsed");
      }
    } catch (e) {}

    // 2. RESTORE SCROLL POSITION INSTANTLY
    try {
      const savedScroll = sessionStorage.getItem(storageKeyScroll);
      if (savedScroll && scrollContainer) {
        scrollContainer.scrollTop = parseInt(savedScroll, 10);
      }
    } catch (e) {}

    // Save scroll on user scroll
    if (scrollContainer) {
      scrollContainer.addEventListener(
        "scroll",
        function () {
          try {
            sessionStorage.setItem(storageKeyScroll, scrollContainer.scrollTop);
          } catch (e) {}
        },
        { passive: true }
      );
    }

    // 3. DETERMINE ACTIVE LINK
    function isCurrentPath(href) {
      if (!href || href === "#") return false;
      try {
        const linkUrl = new URL(href, window.location.origin);
        if (linkUrl.pathname === currentPath) {
          const linkParams = linkUrl.searchParams;
          const currentParams = new URLSearchParams(window.location.search);

          if (linkParams.has("type")) {
            return linkParams.get("type") === (currentParams.get("type") || "all");
          }
          if (linkUrl.pathname === "/admin/forms") {
            return (currentParams.get("type") || "all") === "all";
          }
          return true;
        }
        return currentPath.startsWith(linkUrl.pathname + "/");
      } catch (e) {
        return false;
      }
    }

    // Direct links active highlight
    directLinks.forEach(function (link) {
      if (isCurrentPath(link.getAttribute("href"))) {
        link.classList.add("active");
      }
    });

    // Submenu links active highlight & find active parent
    let activeParentGroup = null;
    submenuLinks.forEach(function (link) {
      if (isCurrentPath(link.getAttribute("href"))) {
        link.classList.add("active");
        const parentItem = link.closest(".has-submenu");
        if (parentItem) {
          activeParentGroup = parentItem;
        }
      }
    });

    // 4. RESTORE OPEN GROUPS FROM SESSION STORAGE
    let savedOpenGroups = [];
    try {
      savedOpenGroups = JSON.parse(sessionStorage.getItem(storageKeyGroups) || "[]");
      if (!Array.isArray(savedOpenGroups)) savedOpenGroups = [];
    } catch (e) {
      savedOpenGroups = [];
    }

    // Assign keys & open initial groups INSTANTLY (without transition)
    parents.forEach(function (btn, idx) {
      const parentItem = btn.closest(".has-submenu");
      if (!parentItem) return;
      const key = "grp-" + idx;
      parentItem.dataset.groupKey = key;

      // Group should be open if active link is inside it OR user previously opened it
      const shouldBeOpen = (activeParentGroup === parentItem) || savedOpenGroups.includes(key);
      if (shouldBeOpen) {
        parentItem.classList.add("submenu-open");
        btn.classList.add("active-parent");
        btn.setAttribute("aria-expanded", "true");
      }
    });

    // Save open state helper
    function persistOpenGroups() {
      try {
        const openKeys = [];
        sidebar.querySelectorAll(".has-submenu.submenu-open").forEach(function (item) {
          if (item.dataset.groupKey) openKeys.push(item.dataset.groupKey);
        });
        sessionStorage.setItem(storageKeyGroups, JSON.stringify(openKeys));
      } catch (e) {}
    }

    // Persist immediately on load
    persistOpenGroups();

    // 5. ENABLE TRANSITIONS AFTER INITIAL PAINT (Zero-flash & Zero-compane)
    requestAnimationFrame(function () {
      setTimeout(function () {
        sidebar.classList.remove("no-transition");
      }, 50);
    });

    // 6. ACCORDION CLICK HANDLER (Fluid & solid, zero layout shifts)
    parents.forEach(function (btn) {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        const currentItem = btn.closest(".has-submenu");
        if (!currentItem) return;
    if (currentPath.startsWith("/admin/downloads")) {
      const dlItem = document.getElementById("sidebarDownloadMenu");
      if (dlItem) {
        dlItem.classList.add("submenu-open");
        const btn = dlItem.querySelector(".sidebar-parent");
        if (btn) {
          btn.classList.add("active-parent");
          btn.setAttribute("aria-expanded", "true");
        }
      }
    }

    /* ==========================================
     ACCORDION
  ========================================== */

        const isOpen = currentItem.classList.contains("submenu-open");
        currentItem.classList.toggle("submenu-open", !isOpen);
        btn.classList.toggle("active-parent", !isOpen);
        btn.setAttribute("aria-expanded", String(!isOpen));

        persistOpenGroups();
      });
    });

    // 7. SAVE SCROLL BEFORE ANY NAVIGATION
    submenuLinks.forEach(function (link) {
      link.addEventListener("click", function () {
        try {
          if (scrollContainer) {
            sessionStorage.setItem(storageKeyScroll, scrollContainer.scrollTop);
          }
        } catch (e) {}

        if (window.innerWidth <= 992) {
          closeSidebar();
        }
      });
    });

    directLinks.forEach(function (link) {
      link.addEventListener("click", function () {
        try {
          if (scrollContainer) {
            sessionStorage.setItem(storageKeyScroll, scrollContainer.scrollTop);
          }
        } catch (e) {}

        if (window.innerWidth <= 992) {
          closeSidebar();
        }
      });
    });

    // 8. MOBILE DRAWER CONTROLS
    function openSidebar() {
      sidebar.classList.add("sidebar-open");
      if (backdrop) backdrop.classList.add("active");
      document.body.classList.add("sidebar-mobile-open");
    }

    function closeSidebar() {
      sidebar.classList.remove("sidebar-open");
      if (backdrop) backdrop.classList.remove("active");
      document.body.classList.remove("sidebar-mobile-open");
    }

    if (toggleBtn) toggleBtn.addEventListener("click", openSidebar);
    if (closeBtn) closeBtn.addEventListener("click", closeSidebar);
    if (backdrop) backdrop.addEventListener("click", closeSidebar);

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && sidebar.classList.contains("sidebar-open")) {
        closeSidebar();
      }
    });

    // 9. DESKTOP COLLAPSE TRIGGER
    if (collapseBtn) {
      collapseBtn.addEventListener("click", function () {
        if (window.innerWidth <= 992) return;

        sidebar.classList.toggle("collapsed");
        const isCollapsed = sidebar.classList.contains("collapsed");
        document.body.classList.toggle("sidebar-collapsed", isCollapsed);

        try {
          localStorage.setItem(storageKeyCollapsed, String(isCollapsed));
        } catch (e) {}
      });
    }

    // 10. WINDOW RESIZE SAFETY
    window.addEventListener("resize", function () {
      if (window.innerWidth > 992) {
        sidebar.classList.remove("sidebar-open");
        if (backdrop) backdrop.classList.remove("active");
        document.body.classList.remove("sidebar-mobile-open");
      }
    });
  })();
</script>
