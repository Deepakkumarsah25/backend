<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sidebar = document.getElementById("responsiveSidebar");
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const backdrop = document.getElementById("sidebarBackdrop");
    const collapseBtn = document.getElementById("desktopCollapse");

    const parents = document.querySelectorAll(".sidebar-parent");
    const submenuLinks = document.querySelectorAll(".sidebar-submenu a");
    const directLinks = document.querySelectorAll(".direct-link");

    const currentPath = window.location.pathname;

    /* ==========================================
     ACTIVE LINK
  ========================================== */

    function isCurrentPath(href) {
      if (!href || href === "#") {
        return false;
      }

      if (href === currentPath) {
        return true;
      }

      return currentPath.startsWith(href + "/");
    }

    /* ==========================================
     DIRECT LINKS ACTIVE
  ========================================== */

    directLinks.forEach(function (link) {
      const href = link.getAttribute("href");

      if (isCurrentPath(href)) {
        link.classList.add("active");
      }
    });

    /* ==========================================
     SUBMENU ACTIVE
  ========================================== */

    submenuLinks.forEach(function (link) {
      const href = link.getAttribute("href");

      if (isCurrentPath(href)) {
        link.classList.add("active");

        const parentItem = link.closest(".has-submenu");

        if (parentItem) {
          parentItem.classList.add("submenu-open");

          const parentButton = parentItem.querySelector(".sidebar-parent");

          if (parentButton) {
            parentButton.classList.add("active-parent");
            parentButton.setAttribute("aria-expanded", "true");
          }
        }
      }
    });

    /* ==========================================
     ACCORDION
  ========================================== */

    parents.forEach(function (parent) {
      parent.addEventListener("click", function () {
        const currentItem = parent.closest(".has-submenu");
        const isOpen = currentItem.classList.contains("submenu-open");

        /* Close all other menus */

        document
          .querySelectorAll(".has-submenu.submenu-open")
          .forEach(function (item) {
            if (item !== currentItem) {
              item.classList.remove("submenu-open");

              const button = item.querySelector(".sidebar-parent");

              if (button) {
                button.setAttribute("aria-expanded", "false");
              }
            }
          });

        /* Toggle current */

        if (isOpen) {
          currentItem.classList.remove("submenu-open");
          parent.setAttribute("aria-expanded", "false");
        } else {
          currentItem.classList.add("submenu-open");
          parent.setAttribute("aria-expanded", "true");
        }
      });
    });

    /* ==========================================
     MOBILE SIDEBAR
  ========================================== */

    function openSidebar() {
      sidebar.classList.add("sidebar-open");
      backdrop.classList.add("active");

      document.body.classList.add("sidebar-mobile-open");
    }

    function closeSidebar() {
      sidebar.classList.remove("sidebar-open");
      backdrop.classList.remove("active");

      document.body.classList.remove("sidebar-mobile-open");
    }

    if (toggleBtn) {
      toggleBtn.addEventListener("click", openSidebar);
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", closeSidebar);
    }

    if (backdrop) {
      backdrop.addEventListener("click", closeSidebar);
    }

    /* Close mobile sidebar after selecting page */

    submenuLinks.forEach(function (link) {
      link.addEventListener("click", function () {
        if (window.innerWidth <= 992) {
          closeSidebar();
        }
      });
    });

    directLinks.forEach(function (link) {
      link.addEventListener("click", function () {
        if (window.innerWidth <= 992) {
          closeSidebar();
        }
      });
    });

    /* ==========================================
     ESCAPE KEY
  ========================================== */

    document.addEventListener("keydown", function (event) {
      if (
        event.key === "Escape" &&
        sidebar.classList.contains("sidebar-open")
      ) {
        closeSidebar();
      }
    });

    /* ==========================================
     DESKTOP COLLAPSE
  ========================================== */

    if (collapseBtn) {
      collapseBtn.addEventListener("click", function () {
        if (window.innerWidth <= 992) {
          return;
        }

        sidebar.classList.toggle("collapsed");

        const icon = collapseBtn.querySelector("i");

        if (sidebar.classList.contains("collapsed")) {
          icon.className = "fa-solid fa-chevron-right";

          document.body.classList.add("sidebar-collapsed");
        } else {
          icon.className = "fa-solid fa-chevron-left";

          document.body.classList.remove("sidebar-collapsed");
        }
      });
    }

    /* ==========================================
     RESIZE SAFETY
  ========================================== */

    window.addEventListener("resize", function () {
      if (window.innerWidth > 992) {
        sidebar.classList.remove("sidebar-open");
        backdrop.classList.remove("active");
        document.body.classList.remove("sidebar-mobile-open");
      }
    });
  });
</script>
