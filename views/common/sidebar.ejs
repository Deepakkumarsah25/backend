<script>
  document.addEventListener("DOMContentLoaded", function () {
    // ✅ Sidebar Active Link Highlight
    const sidebarLinks = document.querySelectorAll(".sidebar-link-item");
    const currentUrl = window.location.pathname;

    sidebarLinks.forEach((link) => {
      const linkHref = link.getAttribute("href");
      if (
        linkHref === currentUrl ||
        (currentUrl === "/courses/" && linkHref === "/courses/")
      ) {
        link.classList.add("active");
      } else {
        link.classList.remove("active");
      }
    });

    // Mobile toggle functionality
    const sidebar = document.getElementById("responsiveSidebar");
    const toggleBtn = document.getElementById("sidebarToggle");
    const closeBtn = document.getElementById("sidebarClose");
    const backdrop = document.getElementById("sidebarBackdrop");

    function openSidebar() {
      sidebar.classList.add("sidebar-open");
      backdrop.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    function closeSidebar() {
      sidebar.classList.remove("sidebar-open");
      backdrop.classList.remove("active");
      document.body.style.overflow = "";
    }

    if (toggleBtn) {
      toggleBtn.addEventListener("click", openSidebar);
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", closeSidebar);
    }

    if (backdrop) {
      backdrop.addEventListener("click", closeSidebar);
    }

    // Close on escape key
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && sidebar.classList.contains("sidebar-open")) {
        closeSidebar();
      }
    });

    // Desktop collapse functionality (optional)
    const collapseTrigger = document.getElementById("desktopCollapse");
    if (collapseTrigger) {
      collapseTrigger.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        const icon = this.querySelector("i");
        if (sidebar.classList.contains("collapsed")) {
          icon.className = "fas fa-chevron-right";
          document.body.classList.add("sidebar-collapsed");
        } else {
          icon.className = "fas fa-chevron-left";
          document.body.classList.remove("sidebar-collapsed");
        }
      });
    }
  });
</script>
