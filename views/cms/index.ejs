<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CMS Management</title>

  <style>
    .cms-container{
      margin-left:300px;
      margin-top:90px;
      padding:30px;
    }

    .cms-title{
      font-size:32px;
      font-weight:700;
      color:#2d1b3d;
      margin-bottom:30px;
    }

    .cms-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:20px;
    }

    .cms-card{
      background:white;
      border-radius:16px;
      padding:25px;
      box-shadow:0 5px 20px rgba(0,0,0,.08);
    }

    .cms-card h3{
      margin-bottom:10px;
      color:#2d1b3d;
    }

    .cms-card p{
      color:#666;
      margin-bottom:20px;
    }

    .cms-btn{
      display:inline-block;
      padding:10px 20px;
      border-radius:10px;
      text-decoration:none;
      background:#4a1a6b;
      color:white;
      font-weight:600;
    }

    .cms-btn:hover{
      background:#2d1b3d;
    }

    @media(max-width:992px){
      .cms-container{
        margin-left:0;
        padding:20px;
        margin-top:100px;
      }
    }
  </style>
</head>

<body>

<%- include("../common/header.ejs") %>
<%- include("../common/sidebar.ejs") %>

<div class="cms-container">

  <h1 class="cms-title">
    CMS Management
  </h1>

  <div class="cms-grid">

    <div class="cms-card">
      <h3>Our Philosophy</h3>
      <p>Manage Our Philosophy page content.</p>
      <a href="/cms/our-philosophy" class="cms-btn">
        Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>History and Development of VIP</h3>
      <p>Manage History and Development of VIP page contant.</p>
      <a href="/cms/history-vip" class="cms-btn">
        Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>History Of Party</h3>
      <p>Manage History Of Party page.</p>
      <a href="/cms/history-party" class="cms-btn">
        Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>Journey Of Mukesh Sahani</h3>
      <p>Manage Journey page content.</p>
<a href="/cms/journey-mukesh-sahani" class="cms-btn"> 
         Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>Mission & Vision</h3>
      <p>Manage Mission & Vision page.</p>
      <a href="/cms/mission-vision" class="cms-btn">
        Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>Our Ideology</h3>
      <p>Manage ideology content.</p>
      <a href="/cms/our-ideology" class="cms-btn">
        Edit Page
      </a>
    </div>

    <div class="cms-card">
      <h3>Nishad Vikas Sangh</h3>
      <p>Manage Nishad Vikas Sangh page.</p>
<a href="/cms/nishad-vikas-sangh" class="cms-btn">
          Edit Page
      </a>
    </div>

  </div>

</div>

</body>
</html>