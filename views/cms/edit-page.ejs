<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>CMS Editor</title>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  background: #f5f5f7;
  font-family: Arial, sans-serif;
}

.cms-editor {
  margin-left: 300px;
  margin-top: 90px;
  padding: 30px;
}

.editor-card {
  background: #fff;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 4px 15px rgba(0,0,0,.08);
  margin-bottom: 25px;
}

.editor-title {
  font-size: 28px;
  font-weight: 700;
  color: #2d1b3d;
  margin-bottom: 20px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 600;
  color: #333;
}

.form-control {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 15px;
  outline: none;
}

.form-control:focus {
  border-color: #4a1a6b;
}

textarea.form-control {
  min-height: 120px;
  resize: vertical;
}

.save-btn {
  background: #4a1a6b;
  color: #fff;
  border: none;
  padding: 12px 25px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  transition: all .3s ease;
}

.save-btn:hover {
  background: #2d1b3d;
  transform: translateY(-2px);
}

.edit-btn {
  background: #0d6efd;
}

.edit-btn:hover {
  background: #0b5ed7;
}

.cancel-btn {
  background: #6c757d;
  margin-left: 10px;
}

.cancel-btn:hover {
  background: #5c636a;
}

.section-card {
  background: #fafafa;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 15px;
  border: 1px solid #eee;
}

.section-card h3 {
  color: #2d1b3d;
}

.section-card p {
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
}

.delete-btn {
  display: inline-block;
  background: #dc3545;
  color: white;
  text-decoration: none;
  padding: 12px 16px;
  border-radius: 10px;
  font-weight: 600;
}

.delete-btn:hover {
  background: #b02a37;
}

img.preview {
  width: 150px;
  height: 150px;
  object-fit: cover;
  border-radius: 10px;
  margin-top: 10px;
}

.edit-box {
  display: none;
  margin-top: 20px;
  padding: 20px;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 12px;
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 15px;
}

.empty-message {
  background: #fff;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
  color: #666;
}

@media (max-width: 992px) {

  .cms-editor {
    margin-left: 0;
    margin-top: 100px;
    padding: 20px;
  }

}

</style>

</head>


<body>

<%- include("../common/header.ejs") %>

<%- include("../common/sidebar.ejs") %>


<div class="cms-editor">


<!-- ==================================================
     PAGE HEADER
================================================== -->

<div class="editor-card">

<h1 class="editor-title">

📄 <%= page.title || page.pageKey %>

</h1>

<p style="color:#666;">

Manage content for this page

</p>

</div>


<!-- ==================================================
     PAGE INFORMATION
================================================== -->

<div class="editor-card">

<h2>
Page Information
</h2>

<form
  action="/cms/<%= page.pageKey %>/update"
  method="POST"
>

<div class="form-group">

<label>
Page Title
</label>

<input
  type="text"
  name="title"
  class="form-control"
  value="<%= page.title || '' %>"
  required
>

</div>


<div class="form-group">

<label>
Intro Text
</label>

<textarea
  name="introText"
  class="form-control"
><%= page.introText || '' %></textarea>

</div>


<button
  type="submit"
  class="save-btn"
>

💾 Save Page Information

</button>

</form>

</div>


<!-- ==================================================
     ADD NEW SECTION
================================================== -->

<div class="editor-card">

<h2>
➕ Add New Section
</h2>

<form
  action="/cms/<%= page.pageKey %>/section/add"
  method="POST"
  enctype="multipart/form-data"
>

<div class="form-group">

<label>
Section Heading
</label>

<input
  type="text"
  name="heading"
  class="form-control"
  placeholder="Example: 2017"
  required
>

</div>


<div class="form-group">

<label>
Description
</label>

<textarea
  name="description"
  class="form-control"
  placeholder="Enter section description"
  required
></textarea>

</div>


<div class="form-group">

<label>
Section Image
</label>

<input
  type="file"
  name="image"
  class="form-control"
  accept="image/*"
>

</div>


<div class="form-group">

<label>
Display Order
</label>

<input
  type="number"
  name="order"
  class="form-control"
  value="0"
  min="0"
>

</div>


<button
  type="submit"
  class="save-btn"
>

➕ Add Section

</button>

</form>

</div>


<!-- ==================================================
     EXISTING SECTIONS
================================================== -->

<h2 class="editor-title">

📚 Existing Sections

</h2>


<% if (
  page.sections &&
  page.sections.length > 0
) { %>


<% page.sections.forEach(
  section => {
%>


<div class="section-card">


<h3>

<%= section.heading %>

</h3>


<p>

<%= section.description %>

</p>


<% if (section.image) { %>

<img
  src="<%= section.image %>"
  class="preview"
  alt="Section Image"
>

<% } %>


<div class="section-actions">


<button
  type="button"
  class="save-btn edit-btn"
  onclick="toggleEdit('<%= section._id %>')"
>

✏️ Edit Section

</button>


<a
  href="/cms/<%= page.pageKey %>/section/delete/<%= section._id %>"
  class="delete-btn"
  onclick="return confirm('Are you sure you want to delete this section?')"
>

🗑 Delete Section

</a>


</div>


<!-- ==================================================
     EDIT SECTION FORM
================================================== -->

<div
  id="edit-<%= section._id %>"
  class="edit-box"
>

<h3>

✏️ Edit Section

</h3>


<form
  action="/cms/<%= page.pageKey %>/section/edit/<%= section._id %>"
  method="POST"
  enctype="multipart/form-data"
>


<div class="form-group">

<label>
Heading
</label>

<input
  type="text"
  name="heading"
  value="<%= section.heading || '' %>"
  class="form-control"
  required
>

</div>


<div class="form-group">

<label>
Description
</label>

<textarea
  name="description"
  class="form-control"
  required
><%= section.description || '' %></textarea>

</div>


<div class="form-group">

<label>
Change Image
</label>

<input
  type="file"
  name="image"
  class="form-control"
  accept="image/*"
>

</div>


<div class="form-group">

<label>
Display Order
</label>

<input
  type="number"
  name="order"
  value="<%= section.order ?? 0 %>"
  class="form-control"
  min="0"
>

</div>


<button
  type="submit"
  class="save-btn"
>

💾 Update Section

</button>


<button
  type="button"
  class="save-btn cancel-btn"
  onclick="toggleEdit('<%= section._id %>')"
>

Cancel

</button>


</form>

</div>


</div>


<%
  });
%>


<% } else { %>


<div class="empty-message">

No sections added yet.

</div>


<% } %>


</div>


<script>

function toggleEdit(id) {

  const box =
    document.getElementById(
      "edit-" + id
    );

  if (!box) {

    console.log(
      "Edit box not found:",
      id
    );

    return;
  }

  if (
    box.style.display === "none" ||
    box.style.display === ""
  ) {

    box.style.display =
      "block";

  } else {

    box.style.display =
      "none";

  }

}

</script>


</body>

</html>