<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CMS Editor</title>

<style>

.cms-editor{
  margin-left:300px;
  margin-top:90px;
  padding:30px;
}

.editor-card{
  background:#fff;
  border-radius:16px;
  padding:25px;
  box-shadow:0 4px 15px rgba(0,0,0,.08);
  margin-bottom:25px;
}

.editor-title{
  font-size:28px;
  font-weight:700;
  color:#2d1b3d;
  margin-bottom:20px;
}

.form-group{
  margin-bottom:20px;
}

.form-group label{
  display:block;
  margin-bottom:8px;
  font-weight:600;
}

.form-control{
  width:100%;
  padding:12px;
  border:1px solid #ddd;
  border-radius:10px;
  box-sizing:border-box;
}

textarea.form-control{
  min-height:120px;
}

.save-btn{
  background:#4a1a6b;
  color:#fff;
  border:none;
  padding:12px 25px;
  border-radius:10px;
  cursor:pointer;
  font-weight:600;
}

.save-btn:hover{
  background:#2d1b3d;
}

.section-card{
  background:#fafafa;
  border-radius:12px;
  padding:20px;
  margin-bottom:15px;
  border:1px solid #eee;
}

.delete-btn{
  display:inline-block;
  background:#dc3545;
  color:white;
  text-decoration:none;
  padding:8px 16px;
  border-radius:8px;
}

.delete-btn:hover{
  background:#b02a37;
}

img.preview{
  width:150px;
  border-radius:10px;
  margin-top:10px;
}

@media(max-width:992px){
  .cms-editor{
    margin-left:0;
    padding:20px;
  }
}

.save-btn{
  transition: all 0.3s ease;
}

.save-btn:hover{
  transform: translateY(-2px);
}

.section-card{
  transition: all 0.3s ease;
}

.section-card:hover{
  box-shadow:0 8px 20px rgba(0,0,0,0.08);
}

.editor-card{
  transition: all 0.3s ease;
}

.editor-card:hover{
  box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

</style>
</head>

<body>

<%- include("../common/header.ejs") %>
<%- include("../common/sidebar.ejs") %>

<div class="cms-editor">

<div class="editor-card">
  <h1 class="editor-title">
    📄 <%= page.title || page.pageKey %>
  </h1>

  <p style="color:#666;">
    Manage content for this page
  </p>
</div>

<div class="editor-card">

<form
action="/cms/<%= page.pageKey %>/update"
method="POST"
>
<h2>Page Information</h2>
<div class="form-group">
<label>Page Title</label>

<input
type="text"
name="title"
class="form-control"
value="<%= page.title || '' %>"
>
</div>


<div class="form-group">
<label>Intro Text</label>

<textarea
name="introText"
class="form-control"
><%= page.introText || '' %></textarea>
</div>

<button
type="submit"
class="save-btn"
>
💾 Save Page Information
</button>

</form>

</div>


<div class="editor-card">

<h2>➕ Add New Section</h2>

<form
action="/cms/<%= page.pageKey %>/section/add"
method="POST"
enctype="multipart/form-data"
>

<div class="form-group">
<label>Section Heading</label>

<input
type="text"
name="heading"
class="form-control"
required
>
</div>

<div class="form-group">
<label>Description</label>

<textarea
name="description"
class="form-control"
required
></textarea>
</div>

<div class="form-group">
<label>Section Image</label>

<input
type="file"
name="image"
class="form-control"
accept="image/*"
>
</div>

<div class="form-group">
<label>Display Order</label>

<input
type="number"
name="order"
class="form-control"
value="0"
>
</div>

<button
type="submit"
class="save-btn"
>
➕ Add Section
</button>

</form>

</div>

<h2 class="editor-title">
📚 Existing Sections
</h2>

<% if(page.sections && page.sections.length){ %>

<% page.sections.forEach(section=>{ %>

<div class="section-card">

<h3>
<%= section.heading %>
</h3>

<p>
<%= section.description %>
</p>

<% if(section.image){ %>

<img
src="<%= section.image %>"
class="preview"
>

<% } %>

<br><br>



<div
id="edit-<%= section._id %>"
style="display:none;margin-top:20px;"
>
<h3 style="margin-bottom:15px;">
✏️ Edit Section
</h3>
<form
action="/cms/<%= page.pageKey %>/section/edit/<%= section._id %>"
method="POST"
enctype="multipart/form-data"
>

<div class="form-group">
<label>Heading</label>

<input
type="text"
name="heading"
value="<%= section.heading %>"
class="form-control"
required
>
</div>

<div class="form-group">
<label>Description</label>

<textarea
name="description"
class="form-control"
required
><%= section.description %></textarea>
</div>

<div class="form-group">
<label>Change Image</label>

<input
type="file"
name="image"
class="form-control"
accept="image/*"
>
</div>

<div class="form-group">
<label>Display Order</label>

<input
type="number"
name="order"
value="<%= section.order %>"
class="form-control"
>
</div>

<button
type="submit"
class="save-btn"
>
Update Section
</button>

</form>


</div>



<button
type="button"
class="save-btn"
onclick="toggleEdit('<%= section._id %>')"
style="margin-right:10px;"
>
Edit Section
</button>

<button
type="button"
class="save-btn"
onclick="toggleEdit('<%= section._id %>')"
style="
margin-right:10px;
background:#0d6efd;
"
>
✏️ Edit Section
</button>
<a
href="/cms/<%= page.pageKey %>/section/delete/<%= section._id %>"
class="delete-btn"
onclick="return confirm('Are you sure you want to delete this section?')"
>
🗑 Delete Section
</a>

</div>

<% }) %>

<% } %>

</div>

<script>
function toggleEdit(id){

const box =
document.getElementById(
"edit-" + id
);

if(box.style.display==="none"){
box.style.display="block";
}else{
box.style.display="none";
}

}
</script>

</body>
</html>