<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> - Vikassheel Insaan Party</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- VIP Admin Styles -->
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/sidebar.css">

  <style>
    :root {
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --surface: #ffffff;
      --bg: #f8fafc;
      --border: #e2e8f0;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --radius: 12px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 16px -2px rgba(0,0,0,0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text-main);
      -webkit-font-smoothing: antialiased;
    }

    .agent-page-container {
      padding: 24px 30px;
      width: 100%;
      box-sizing: border-box;
      max-width: 1500px;
      margin: 0 auto;
    }

    /* Page Header */
    .page-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    .page-title-group h1 {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .page-title-group h1 i {
      color: var(--primary);
    }

    .page-subtitle {
      color: var(--text-muted);
      font-size: 13.5px;
      margin-top: 4px;
    }

    .count-badge-pill {
      background: #eff6ff;
      color: #1e40af;
      border: 1px solid #bfdbfe;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 13px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .count-badge-pill .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #2563eb;
      box-shadow: 0 0 8px #2563eb;
    }

    /* Toolbar / Search Card */
    .toolbar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
      margin-bottom: 24px;
      box-shadow: var(--shadow-sm);
    }

    .toolbar-form {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }

    .search-input-box {
      position: relative;
      flex: 1;
      min-width: 260px;
      max-width: 500px;
    }

    .search-input-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 14px;
    }

    .search-input-box input {
      width: 100%;
      padding: 10px 14px 10px 38px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13.5px;
      font-family: inherit;
      color: var(--text-main);
      outline: none;
      transition: border-color 0.16s ease, box-shadow 0.16s ease;
      background: #ffffff;
    }

    .search-input-box input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .btn-search {
      padding: 10px 20px;
      background: var(--primary);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.16s ease, transform 0.1s ease;
    }

    .btn-search:hover {
      background: var(--primary-hover);
    }

    .btn-reset {
      padding: 10px 16px;
      background: #f1f5f9;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-reset:hover {
      background: #e2e8f0;
      color: var(--text-main);
    }

    /* Section Card */
    .section-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      margin-bottom: 28px;
      overflow: hidden;
    }

    .section-card-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .section-card-header.pending-header {
      background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
      border-bottom: 1px solid #fde68a;
    }

    .section-card-title {
      font-size: 15.5px;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pending-header .section-card-title {
      color: #92400e;
    }

    /* Table Styles */
    .table-responsive {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .vip-data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
      white-space: nowrap;
    }

    .vip-data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 650;
      padding: 12px 18px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 12.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .vip-data-table td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      color: var(--text-main);
      vertical-align: middle;
    }

    .vip-data-table tbody tr {
      transition: background 0.12s ease;
    }

    .vip-data-table tbody tr:hover {
      background: #f8fafc;
    }

    .vip-data-table tbody tr:last-child td {
      border-bottom: none;
    }

    .cell-primary {
      font-weight: 600;
      color: #0f172a;
    }

    .cell-uid {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12.5px;
      background: #f1f5f9;
      padding: 3px 8px;
      border-radius: 6px;
      color: #334155;
      display: inline-block;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 650;
    }

    .badge.agent {
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
    }

    .badge.pending {
      background: #fffbeb;
      color: #b45309;
      border: 1px solid #fde68a;
    }

    .badge.member {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #e2e8f0;
    }

    /* Action Buttons */
    .actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .actions form {
      margin: 0;
      display: inline-flex;
    }

    .btn-action {
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12.5px;
      font-weight: 600;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.14s ease;
      font-family: inherit;
    }

    .btn-make {
      background: #eff6ff;
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    .btn-make:hover {
      background: #1d4ed8;
      color: #ffffff;
    }

    .btn-remove {
      background: #fef2f2;
      color: #dc2626;
      border-color: #fecaca;
    }

    .btn-remove:hover {
      background: #dc2626;
      color: #ffffff;
    }

    .btn-approve {
      background: #10b981;
      color: #ffffff;
    }

    .btn-approve:hover {
      background: #059669;
    }

    .btn-reject {
      background: #ef4444;
      color: #ffffff;
    }

    .btn-reject:hover {
      background: #dc2626;
    }

    /* Empty State */
    .empty-state {
      padding: 48px 24px;
      text-align: center;
      color: var(--text-muted);
    }

    .empty-state i {
      font-size: 38px;
      color: #cbd5e1;
      margin-bottom: 12px;
      display: block;
    }

    .empty-state h3 {
      font-size: 16px;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    /* Pagination */
    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin: 20px 0 32px;
    }

    .pagination-btn {
      padding: 8px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-main);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: var(--shadow-sm);
      transition: background 0.14s ease;
    }

    .pagination-btn:hover {
      background: #f1f5f9;
    }

    .pagination-info {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 500;
    }

    @media (max-width: 768px) {
      .agent-page-container {
        padding: 16px;
      }
      .page-header-row {
        flex-direction: column;
        align-items: flex-start;
      }
      .toolbar-form {
        flex-direction: column;
        align-items: stretch;
      }
      .search-input-box {
        max-width: 100%;
      }
    }
  </style>
</head>
<body>

  <!-- ==================== HEADER ==================== -->
  <%- include("common/header.ejs") %>

  <!-- ==================== SIDEBAR ==================== -->
  <%- include("common/sidebar.ejs") %>

  <!-- ==================== MAIN CONTENT ==================== -->
  <main class="main-content">
    <div class="agent-page-container">

      <!-- Page Header -->
      <div class="page-header-row">
        <div class="page-title-group">
          <h1>
            <i class="fa-solid fa-user-shield"></i>
            Admin & Agent Management
          </h1>
          <p class="page-subtitle">Manage agent statuses, user roles, and pending verification requests</p>
        </div>

        <div class="count-badge-pill">
          <span class="pulse-dot"></span>
          <span><%= totalUsers %> Total Users</span>
        </div>
      </div>

      <!-- Toolbar / Search -->
      <div class="toolbar-card">
        <form class="toolbar-form" method="GET" action="/AdminAgent">
          <div class="search-input-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= search %>" 
              placeholder="Search by name, email, phone, or UID..." 
              autocomplete="off"
            />
          </div>
          <button type="submit" class="btn-search">
            <i class="fa-solid fa-filter"></i> Search
          </button>
          <% if (search) { %>
            <a href="/AdminAgent" class="btn-reset">
              <i class="fa-solid fa-rotate-left"></i> Reset
            </a>
          <% } %>
        </form>
      </div>

      <!-- Pending Agent Requests Section -->
      <% if (pendingRequests && pendingRequests.length > 0) { %>
        <div class="section-card">
          <div class="section-card-header pending-header">
            <div class="section-card-title">
              <i class="fa-solid fa-clock-rotate-left" style="color: #d97706;"></i>
              Pending Agent Verification Requests (<%= pendingRequests.length %>)
            </div>
            <span style="font-size: 12px; color: #b45309; font-weight: 600;">Requires Administrative Action</span>
          </div>

          <div class="table-responsive">
            <table class="vip-data-table">
              <thead>
                <tr>
                  <th>Applicant Name</th>
                  <th>Email</th>
                  <th>Phone Number</th>
                  <th>User ID (UID)</th>
                  <th>Status</th>
                  <th>Review Decision</th>
                </tr>
              </thead>
              <tbody>
                <% pendingRequests.forEach(function(u) { %>
                  <tr>
                    <td class="cell-primary"><%= u.name || "N/A" %></td>
                    <td><%= u.email || "N/A" %></td>
                    <td><%= u.phone || "N/A" %></td>
                    <td><span class="cell-uid"><%= u.uid %></span></td>
                    <td>
                      <span class="badge pending">
                        <i class="fa-regular fa-clock"></i> Pending
                      </span>
                    </td>
                    <td class="actions">
                      <form method="POST" action="/AdminAgent/<%= u._id %>/approve-request">
                        <input type="hidden" name="search" value="<%= search %>" />
                        <input type="hidden" name="page" value="<%= page %>" />
                        <button type="submit" class="btn-action btn-approve" title="Approve Agent Request">
                          <i class="fa-solid fa-check"></i> Approve
                        </button>
                      </form>
                      <form method="POST" action="/AdminAgent/<%= u._id %>/reject-request">
                        <input type="hidden" name="search" value="<%= search %>" />
                        <input type="hidden" name="page" value="<%= page %>" />
                        <button type="submit" class="btn-action btn-reject" title="Reject Agent Request">
                          <i class="fa-solid fa-xmark"></i> Reject
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- All Users Section -->
      <div class="section-card">
        <div class="section-card-header">
          <div class="section-card-title">
            <i class="fa-solid fa-users" style="color: var(--primary);"></i>
            All Registered Users
          </div>
          <span style="font-size: 12.5px; color: var(--text-muted);">Page <%= page %> of <%= totalPages %></span>
        </div>

        <% if (!users || users.length === 0) { %>
          <div class="empty-state">
            <i class="fa-solid fa-user-slash"></i>
            <h3>No users found</h3>
            <p>Try searching with a different term or keyword.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="vip-data-table">
              <thead>
                <tr>
                  <th>User Name</th>
                  <th>Email</th>
                  <th>Phone Number</th>
                  <th>UID</th>
                  <th>Role / Status</th>
                  <th>Referral Code</th>
                  <th>Agent Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td class="cell-primary"><%= u.name || "N/A" %></td>
                    <td><%= u.email || "N/A" %></td>
                    <td><%= u.phone || "N/A" %></td>
                    <td><span class="cell-uid"><%= u.uid %></span></td>
                    <td>
                      <% if (u.isAgent) { %>
                        <span class="badge agent">
                          <i class="fa-solid fa-shield-check"></i> Agent
                        </span>
                      <% } else if (u.agentRequestPending) { %>
                        <span class="badge pending">
                          <i class="fa-regular fa-clock"></i> Pending
                        </span>
                      <% } else { %>
                        <span class="badge member">
                          <i class="fa-solid fa-user"></i> Member
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <% if (u.referralCode) { %>
                        <span class="cell-uid" style="color: #1e40af; background: #eff6ff;"><%= u.referralCode %></span>
                      <% } else { %>
                        <span style="color: #94a3b8;">&mdash;</span>
                      <% } %>
                    </td>
                    <td class="actions">
                      <form method="POST" action="/AdminAgent/<%= u._id %>/toggle-agent">
                        <input type="hidden" name="search" value="<%= search %>" />
                        <input type="hidden" name="page" value="<%= page %>" />
                        <% if (u.isAgent) { %>
                          <button type="submit" class="btn-action btn-remove" title="Demote to regular member">
                            <i class="fa-solid fa-user-minus"></i> Remove Agent
                          </button>
                        <% } else { %>
                          <button type="submit" class="btn-action btn-make" title="Promote to verified agent">
                            <i class="fa-solid fa-user-plus"></i> Make Agent
                          </button>
                        <% } %>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <div class="pagination-bar">
        <div>
          <% if (page > 1) { %>
            <a href="/AdminAgent?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>" class="pagination-btn">
              <i class="fa-solid fa-chevron-left"></i> Previous
            </a>
          <% } %>
        </div>

        <div class="pagination-info">
          Showing page <strong><%= page %></strong> of <strong><%= totalPages %></strong>
        </div>

        <div>
          <% if (page < totalPages) { %>
            <a href="/AdminAgent?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>" class="pagination-btn">
              Next <i class="fa-solid fa-chevron-right"></i>
            </a>
          <% } %>
        </div>
      </div>

    </div>
  </main>

</body>
</html>
