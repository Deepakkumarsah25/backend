<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/sidebar.css">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7fc;
      margin: 0;
      padding: 24px;
      color: #222;
    }
    h1 { color: #1565c0; margin-bottom: 20px; }
    h2.section-title { color: #b8860b; margin: 0 0 12px; font-size: 18px; }
    .main-content{
      margin-left:270px;
      padding:24px;
    }

    @media(max-width:1100px){
      .main-content{
        margin-left:0;
        padding:80px 15px 20px;
      }
    }

    .toolbar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }
    .toolbar input {
      padding: 8px 10px;
      border: 1px solid #d9e2ef;
      border-radius: 8px;
      font-size: 14px;
      flex: 1;
      max-width: 320px;
    }
    .toolbar button {
      padding: 8px 16px;
      background: #1565c0;
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      margin-bottom: 32px;
    }
    th, td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid #eef1f6;
      font-size: 14px;
    }
    th {
      background: #eef5ff;
      color: #1565c0;
    }

    .requests-table th {
      background: #fff4e0;
      color: #b8860b;
    }

    .badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      display: inline-block;
    }
    .badge.agent { background: #e3f9e5; color: #1a7f37; }
    .badge.member { background: #fff4e0; color: #b8860b; }
    .badge.pending { background: #fde8e8; color: #b91c1c; }

    .actions form { display: inline-block; margin: 0; margin-right: 6px; }
    .actions button {
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      color: #fff;
    }
    .btn-make { background: #1565c0; }
    .btn-remove { background: #6b7280; }
    .btn-approve { background: #22c55e; }
    .btn-reject { background: #ef4444; }

    .empty {
      text-align: center;
      padding: 40px;
      color: #999;
    }
  </style>
</head>
<body>
  <%- include("common/sidebar") %>

  <div class="main-content">

    <h1><%= pageTitle %> (<%= totalUsers %> total)</h1>

    <form class="toolbar" method="GET" action="/AdminAgent">
      <input type="text" name="search" value="<%= search %>" placeholder="Search name / email / phone / uid" />
      <button type="submit">Search</button>
    </form>

    <% if (pendingRequests.length > 0) { %>
      <h2 class="section-title">Pending Agent Requests (<%= pendingRequests.length %>)</h2>
      <table class="requests-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>UID</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pendingRequests.forEach(function(u) { %>
            <tr>
              <td><%= u.name || "-" %></td>
              <td><%= u.email || "-" %></td>
              <td><%= u.phone || "-" %></td>
              <td><%= u.uid %></td>
              <td><span class="badge pending">Pending</span></td>
              <td class="actions">
                <form method="POST" action="/AdminAgent/<%= u._id %>/approve-request">
                  <input type="hidden" name="search" value="<%= search %>" />
                  <input type="hidden" name="page" value="<%= page %>" />
                  <button type="submit" class="btn-approve">Approve</button>
                </form>
                <form method="POST" action="/AdminAgent/<%= u._id %>/reject-request">
                  <input type="hidden" name="search" value="<%= search %>" />
                  <input type="hidden" name="page" value="<%= page %>" />
                  <button type="submit" class="btn-reject">Reject</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <h2 class="section-title" style="color:#1565c0;">All Users</h2>

    <% if (users.length === 0) { %>
      <div class="empty">No users found.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>UID</th>
            <th>Status</th>
            <th>Referral Code</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.name || "-" %></td>
              <td><%= u.email || "-" %></td>
              <td><%= u.phone || "-" %></td>
              <td><%= u.uid %></td>
              <td>
                <% if (u.isAgent) { %>
                  <span class="badge agent">Agent</span>
                <% } else if (u.agentRequestPending) { %>
                  <span class="badge pending">Pending</span>
                <% } else { %>
                  <span class="badge member">Member</span>
                <% } %>
              </td>
              <td><%= u.referralCode || "-" %></td>
              <td class="actions">
                <form method="POST" action="/AdminAgent/<%= u._id %>/toggle-agent">
                  <input type="hidden" name="search" value="<%= search %>" />
                  <input type="hidden" name="page" value="<%= page %>" />
                  <% if (u.isAgent) { %>
                    <button type="submit" class="btn-remove">Remove Agent</button>
                  <% } else { %>
                    <button type="submit" class="btn-make">Make Agent</button>
                  <% } %>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <nav aria-label="User pages" style="display:flex;gap:12px;align-items:center;margin:16px 0 32px;">
      <% if (page > 1) { %>
        <a href="/AdminAgent?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>">Previous</a>
      <% } %>
      <span>Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a href="/AdminAgent?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>">Next</a>
      <% } %>
    </nav>

  </div>
</body>
</html>
