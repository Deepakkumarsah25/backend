<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Banner Management · Vikassheel Insaan Party</title>
  
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/sidebar.css" />
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: #f8f9fc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ===== MAIN CONTENT AREA ===== */
    .main-content {
      margin-left: 280px;
      margin-top: 70px;
      padding: 30px 35px;
      min-height: calc(100vh - 70px);
      transition: margin-left 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      background: #f8f9fc;
    }

    .page-container {
      max-width: 1400px;
      margin: 0 auto;
    }

    /* ===== PAGE TITLE ===== */
    .page-title {
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(135deg, #1a1a2e 0%, #4a1a6b 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
      letter-spacing: -0.3px;
    }
    .page-title i {
      color: #4a1a6b;
      font-size: 2rem;
    }

    /* ===== UPLOAD CARD ===== */
    .upload-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 2rem 2.5rem 2.5rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      margin-bottom: 3rem;
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: box-shadow 0.3s ease;
    }
    .upload-card:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    /* ===== DROPZONE ===== */
    .dropzone {
      border: 2px dashed #cbd9eb;
      border-radius: 16px;
      padding: 2.8rem 1.8rem;
      text-align: center;
      background: #fafdff;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }
    .dropzone:hover {
      background: #f2f8ff;
      border-color: #4a1a6b;
    }
    .dropzone.drag {
      border-color: #4a1a6b;
      background: #f3edf7;
      box-shadow: 0 0 0 4px rgba(74, 26, 107, 0.10);
    }
    .dropzone .icon {
      font-size: 3.6rem;
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.4rem;
      display: block;
    }
    .dropzone h3 {
      font-weight: 600;
      font-size: 1.25rem;
      color: #1a1a2e;
      margin-bottom: 0.2rem;
    }
    .dropzone span {
      color: #7a7a8a;
      font-size: 0.95rem;
      font-weight: 400;
    }
    .dropzone input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }

    /* ===== FILE CHIPS ===== */
    .file-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1rem;
      margin-top: 1.4rem;
      padding: 0.2rem 0;
    }
    .file-chip {
      background: #f0ebf5;
      color: #2d1b3d;
      padding: 0.4rem 1.2rem 0.4rem 1.4rem;
      border-radius: 40px;
      font-size: 0.85rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid #d6c8e8;
    }
    .file-chip i {
      color: #4a1a6b;
      font-size: 0.9rem;
    }

    /* ===== PRIMARY BUTTON ===== */
    .btn-primary-upload {
      margin-top: 1.8rem;
      border: none;
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      color: white;
      padding: 0.9rem 2.8rem;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(74, 26, 107, 0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    .btn-primary-upload i {
      font-size: 1rem;
    }
    .btn-primary-upload:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(74, 26, 107, 0.35);
    }

    /* ===== GALLERY HEADER ===== */
    .gallery-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.8rem;
      flex-wrap: wrap;
    }
    .gallery-title {
      font-size: 20px;
      font-weight: 700;
      color: #1a1a2e;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .gallery-title i {
      color: #4a1a6b;
    }
    .badge-count {
      background: #f0ebf5;
      padding: 0.2rem 1rem;
      border-radius: 40px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #2d1b3d;
    }

    /* ===== GALLERY WRAPPER ===== */
    .gallery-wrapper {
      overflow-x: auto;
      padding: 0.4rem 0.2rem 0.8rem 0.2rem;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: #c8b8d8 #f0ebf5;
    }
    .gallery-wrapper::-webkit-scrollbar {
      height: 6px;
    }
    .gallery-wrapper::-webkit-scrollbar-track {
      background: #f0ebf5;
      border-radius: 20px;
    }
    .gallery-wrapper::-webkit-scrollbar-thumb {
      background: #c8b8d8;
      border-radius: 20px;
    }

    .gallery {
      display: flex;
      flex-wrap: nowrap;
      gap: 1.8rem;
      align-items: stretch;
      min-width: max-content;
      padding-bottom: 0.2rem;
    }

    /* ===== BANNER CARD ===== */
    .banner-card {
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      width: 280px;
      flex-shrink: 0;
    }
    .banner-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
      border-color: rgba(74, 26, 107, 0.15);
    }

    .banner-card img {
      width: 100%;
      height: 170px;
      object-fit: cover;
      background: #f0ebf5;
      display: block;
      border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .card-footer {
      padding: 0.9rem 1.2rem 1.2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem 0.6rem;
      background: #fafdff;
    }
    .banner-id {
      color: #7a7a8a;
      font-size: 0.7rem;
      font-weight: 500;
      background: #f0ebf5;
      padding: 0.2rem 0.9rem;
      border-radius: 30px;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      letter-spacing: 0.1px;
    }
    .banner-id i {
      font-size: 0.7rem;
      color: #4a1a6b;
    }

    .delete-btn {
      background: #fee9e7;
      color: #b81c1c;
      padding: 0.3rem 1.1rem;
      border-radius: 40px;
      font-size: 0.75rem;
      font-weight: 600;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: none;
      cursor: pointer;
    }
    .delete-btn i {
      font-size: 0.75rem;
    }
    .delete-btn:hover {
      background: #fcd8d4;
      color: #a11616;
      transform: scale(0.95);
    }
    .delete-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* ===== EMPTY STATE ===== */
    .empty {
      background: white;
      padding: 3rem 2.5rem;
      border-radius: 16px;
      text-align: center;
      color: #7a7a8a;
      font-size: 1rem;
      border: 2px dashed #d0ddee;
      min-width: 300px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .empty i {
      font-size: 2.8rem;
      color: #c8b8d8;
    }

    /* ===== TOAST ===== */
    .toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: #1a1a2e;
      color: white;
      padding: 0.9rem 1.8rem;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.95rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      transform: translateY(80px);
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }
    .toast.success { background: #0f7b3a; }
    .toast.error { background: #b22234; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 992px) {
      .main-content {
        margin-left: 0 !important;
        padding: 20px;
      }
    }

    @media (max-width: 700px) {
      .page-container {
        padding: 0;
      }
      .upload-card {
        padding: 1.5rem 1.2rem;
      }
      .dropzone {
        padding: 2rem 1rem;
      }
      .btn-primary-upload {
        width: 100%;
        justify-content: center;
      }
      .gallery {
        gap: 1.2rem;
      }
      .banner-card {
        width: 240px;
      }
      .page-title {
        font-size: 22px;
      }
    }

    @media (max-width: 500px) {
      .banner-card {
        width: 210px;
      }
      .banner-card img {
        height: 140px;
      }
    }
  </style>
</head>
<body>
  
  <!-- ===== HEADER ===== -->
  <%- include("../common/header.ejs") %>

  <!-- ===== SIDEBAR ===== -->
  <%- include("../common/sidebar.ejs") %>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main-content">
    <div class="page-container">
      
      <!-- Page Title -->
      <div class="page-title">
        <i class="fas fa-images"></i> 
        Live Updates Banner Management
      </div>

      <!-- Upload Card -->
      <div class="upload-card">
        <form action="/banner/add" method="POST" enctype="multipart/form-data" id="bannerForm">
          <div class="dropzone" id="dropzone">
            <span class="icon"><i class="fas fa-cloud-upload-alt"></i></span>
            <h3>Drag & drop banner images</h3>
            <span>or click to browse — multiple images supported</span>
            <input type="file" name="banner" id="bannerInput" multiple required accept="image/*" />
          </div>

          <div class="file-list" id="fileList"></div>

          <button type="submit" class="btn-primary-upload">
            <i class="fas fa-upload"></i> Upload Banner
          </button>
        </form>
      </div>

      <!-- Gallery Header -->
      <div class="gallery-header">
        <h2 class="gallery-title">
          <i class="fas fa-th-large"></i> Uploaded Banners
          <span class="badge-count" id="bannerCount"><%= (typeof banners !== 'undefined' && banners.length) ? banners.length : 0 %></span>
        </h2>
      </div>

      <!-- Horizontal Scroll Gallery -->
      <div class="gallery-wrapper">
        <div class="gallery" id="galleryContainer">
          <% if (typeof banners !== 'undefined' && banners.length) { %>
            <% banners.forEach(banner => { %>
              <div class="banner-card" data-id="<%= banner._id %>">
                <img src="<%= banner.imageUrl %>" alt="Banner" loading="lazy" />
                <div class="card-footer">
                  <span class="banner-id"><i class="far fa-id-card"></i> ID: <%= banner._id %></span>
                  <button class="delete-btn" data-id="<%= banner._id %>">
                    <i class="fas fa-trash-alt"></i> Delete
                  </button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty" id="emptyState">
              <i class="fas fa-box-open"></i>
              <span>No banners uploaded yet.</span>
              <span style="font-size: 0.9rem; color: #8ba0b9;">Drop your images above to get started.</span>
            </div>
          <% } %>
        </div>
      </div>
      
    </div>
  </main>

  <!-- Toast Notification -->
  <div class="toast" id="toast"></div>

  <script>
    (function() {
      const dropzone = document.getElementById('dropzone');
      const input = document.getElementById('bannerInput');
      const fileList = document.getElementById('fileList');
      const galleryContainer = document.getElementById('galleryContainer');
      const bannerCount = document.getElementById('bannerCount');
      const toast = document.getElementById('toast');

      // ---------- Toast ----------
      let toastTimer;
      function showToast(message, type = 'success') {
        toast.textContent = message;
        toast.className = 'toast ' + type;
        void toast.offsetWidth;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('show');
        }, 2800);
      }

      // ---------- Render File Chips ----------
      function renderFiles(files) {
        fileList.innerHTML = '';
        if (!files || files.length === 0) return;
        Array.from(files).forEach((file) => {
          const chip = document.createElement('span');
          chip.className = 'file-chip';
          chip.innerHTML = `<i class="fas fa-image"></i> ${file.name}`;
          fileList.appendChild(chip);
        });
      }

      // ---------- Update UI (Badge + Empty State) ----------
      function updateUI() {
        const cards = galleryContainer.querySelectorAll('.banner-card');
        const count = cards.length;
        if (bannerCount) bannerCount.textContent = count;

        const existingEmpty = galleryContainer.querySelector('.empty');
        if (existingEmpty) existingEmpty.remove();

        if (count === 0) {
          const emptyDiv = document.createElement('div');
          emptyDiv.className = 'empty';
          emptyDiv.id = 'emptyState';
          emptyDiv.innerHTML = `
            <i class="fas fa-box-open"></i>
            <span>No banners uploaded yet.</span>
            <span style="font-size: 0.9rem; color: #8ba0b9;">Drop your images above to get started.</span>
          `;
          galleryContainer.appendChild(emptyDiv);
        }
      }

      // ---------- Delete Handler (AJAX) ----------
      async function handleDelete(btn) {
        const id = btn.getAttribute('data-id');
        if (!id) return;

        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
          const response = await fetch(`/banner/delete/${id}`, {
            method: 'DELETE',
            headers: { 
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            }
          });

          let result;
          const contentType = response.headers.get('content-type');
          if (contentType && contentType.includes('application/json')) {
            result = await response.json();
          } else {
            const text = await response.text();
            console.warn('Server returned non-JSON:', text);
            if (response.redirected) {
              const card = btn.closest('.banner-card');
              if (card) card.remove();
              updateUI();
              showToast('Banner deleted successfully', 'success');
              return;
            }
            throw new Error('Unexpected server response');
          }

          if (result && result.success) {
            const card = btn.closest('.banner-card');
            if (card) card.remove();
            updateUI();
            showToast('Banner deleted successfully', 'success');
          } else {
            throw new Error(result?.message || 'Delete failed');
          }
        } catch (err) {
          console.error('Delete error:', err);
          const card = btn.closest('.banner-card');
          if (card) {
            try {
              const checkRes = await fetch(`/banner/check/${id}`, {
                method: 'HEAD',
                headers: { 'Accept': 'application/json' }
              });
              if (checkRes.status === 404) {
                if (card) card.remove();
                updateUI();
                showToast('Banner deleted successfully', 'success');
                return;
              }
            } catch (checkErr) {
              // If we can't check, assume it's still there
            }
          }
          showToast('Failed to delete banner: ' + err.message, 'error');
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      }

      // ---------- Attach Delete Events (Delegation) ----------
      galleryContainer.addEventListener('click', function(e) {
        const btn = e.target.closest('.delete-btn');
        if (btn) {
          e.preventDefault();
          e.stopPropagation();
          handleDelete(btn);
        }
      });

      // ---------- File Input Change ----------
      input.addEventListener('change', function(e) {
        renderFiles(this.files);
      });

      // ---------- Drag/Drop ----------
      ['dragenter', 'dragover'].forEach((ev) => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('drag');
        });
      });
      ['dragleave', 'drop'].forEach((ev) => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.remove('drag');
        });
      });
      dropzone.addEventListener('drop', (e) => {
        const files = e.dataTransfer.files;
        if (files.length) {
          input.files = files;
          renderFiles(files);
        }
      });

      // ---------- On Load ----------
      window.addEventListener('load', function() {
        updateUI();
      });

      console.log('Banner management UI (AJAX delete) ready.');
    })();
  </script>
</body>
</html>