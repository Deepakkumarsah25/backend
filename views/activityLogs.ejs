<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>10-Day Admin Activity Audit Log - Vikassheel Insaan Party</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/activityLogs.css">
</head>
<body>

    <!-- ==================== HEADER ==================== -->
    <%- include('common/header.ejs') %>

    <!-- ==================== SIDEBAR ==================== -->
    <%- include('common/sidebar.ejs') %>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="main-content">
        <div class="activity-logs-container">

            <!-- PAGE HEADER -->
            <div class="al-page-header">
                <div class="al-title-wrap">
                    <span class="al-badge-pill">
                        <span class="pulse-dot"></span> Live Audit & Governance &bull; Last 10 Days
                    </span>
                    <h1 class="al-title">
                        <i class="fa-solid fa-clock-rotate-left" style="color: #0b4ea2;"></i>
                        10-Day Admin Activity Audit Log
                    </h1>
                </div>

                <div class="al-header-actions">
                    <div class="date-window-chip">
                        <i class="fa-regular fa-calendar-days"></i>
                        <span>
                            <% 
                                const d10 = new Date(); 
                                d10.setDate(d10.getDate() - 10);
                                const d10Str = d10.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                                const todayStr = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                            %>
                            <%= d10Str %> &mdash; <%= todayStr %>
                        </span>
                    </div>

                    <a href="/dashboard" class="btn-filter-reset" style="background:#ffffff; border:1px solid #cbd5e1; text-decoration:none;">
                        <i class="fa-solid fa-arrow-left"></i> Dashboard
                    </a>
                </div>
            </div>

            <!-- SUMMARY KPI STRIP (SLEEK, COMPACT & MODERN) -->
            <div class="metrics-summary-bar">
                <div class="summary-kpi-item">
                    <div class="kpi-icon-pill kpi-blue">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div class="kpi-text-wrap">
                        <div class="kpi-value"><%= stats.total10Days %></div>
                        <div class="kpi-label">Total Modifications</div>
                    </div>
                </div>

                <div class="kpi-separator"></div>

                <div class="summary-kpi-item">
                    <div class="kpi-icon-pill kpi-green">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div class="kpi-text-wrap">
                        <div class="kpi-value"><%= stats.activeAdminsCount %> <span class="kpi-sub-num">/ 4</span></div>
                        <div class="kpi-label">Active Admins</div>
                    </div>
                </div>

                <div class="kpi-separator"></div>

                <div class="summary-kpi-item">
                    <div class="kpi-icon-pill kpi-amber">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <div class="kpi-text-wrap">
                        <div class="kpi-value"><%= stats.todayCount %></div>
                        <div class="kpi-label">Today's Updates</div>
                    </div>
                </div>

                <div class="kpi-separator"></div>

                <div class="summary-kpi-item">
                    <div class="kpi-icon-pill kpi-purple">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <div class="kpi-text-wrap">
                        <div class="kpi-value kpi-title-value" title="<%= stats.topSection %>"><%= stats.topSection %></div>
                        <div class="kpi-label">Top Active Section</div>
                    </div>
                </div>
            </div>

            <!-- 4 ADMIN PROFILES OVERVIEW SECTION (COMPACT & BEAUTIFUL) -->
            <section class="admin-overview-section">
                <div class="section-label-bar">
                    <h3>
                        <i class="fa-solid fa-users-gear" style="color: #0b4ea2;"></i>
                        4 Admin Accounts Activity Overview (Last 10 Days)
                    </h3>
                    <span style="font-size: 12.5px; color: #64748b;">
                        Click <strong>View Activity</strong> on any card to isolate that admin's changes instantly (No reload)
                    </span>
                </div>

                <div class="admin-cards-grid">
                    <% adminGroups.forEach(function(adm) { %>
                        <div 
                            class="admin-profile-card" 
                            id="admin-overview-card-<%= adm.email.replace(/[@.]/g, '-') %>"
                            onclick="selectAdminFilter('<%= adm.email %>')"
                        >
                            <div class="card-accent-bar" style="background: <%= adm.avatarBg %>;"></div>
                            
                            <div>
                                <div class="ap-header">
                                    <div class="ap-avatar" style="background: <%= adm.avatarBg %>;">
                                        <i class="<%= adm.icon %>"></i>
                                    </div>
                                    <div class="ap-info">
                                        <h4 class="ap-name"><%= adm.name %></h4>
                                        <div class="ap-email" title="<%= adm.email %>">
                                            <i class="fa-regular fa-envelope"></i> <%= adm.email %>
                                        </div>
                                        <span class="role-tag <%= adm.roleClass %>"><%= adm.role %></span>
                                    </div>
                                </div>

                                <div class="ap-stats-row">
                                    <div class="ap-stat-item">
                                        <div class="ap-stat-num" style="color: #0b4ea2;"><%= adm.totalActions %></div>
                                        <div class="ap-stat-label">Total</div>
                                    </div>
                                    <div class="ap-stat-item">
                                        <div class="ap-stat-num" style="color: #16a34a;"><%= adm.stats.creates %></div>
                                        <div class="ap-stat-label">Added</div>
                                    </div>
                                    <div class="ap-stat-item">
                                        <div class="ap-stat-num" style="color: #2563eb;"><%= adm.stats.updates %></div>
                                        <div class="ap-stat-label">Edited</div>
                                    </div>
                                    <div class="ap-stat-item">
                                        <div class="ap-stat-num" style="color: #dc2626;"><%= adm.stats.deletes %></div>
                                        <div class="ap-stat-label">Deleted</div>
                                    </div>
                                </div>
                            </div>

                            <div class="ap-footer">
                                <div class="ap-last-active">
                                    <span style="font-size: 10px; color: #94a3b8; display: block; font-weight: 700;">LAST ACTIVE:</span>
                                    <strong style="color: #334155; font-size: 11.5px;"><%= adm.lastActiveTime %></strong>
                                </div>
                                
                                <button 
                                    type="button" 
                                    class="btn-filter-admin" 
                                    id="btn-card-filter-<%= adm.email.replace(/[@.]/g, '-') %>"
                                    onclick="event.stopPropagation(); selectAdminFilter('<%= adm.email %>')"
                                >
                                    <i class="fa-solid fa-eye"></i> View Activity
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>

            <!-- FILTER & SEARCH TOOLBAR -->
            <div class="filter-toolbar-card" id="filterToolbarRoot">
                <div class="filter-form">
                    <div class="filters-left">
                        <!-- Filter by Admin Email -->
                        <div class="filter-group">
                            <label for="emailFilter"><i class="fa-solid fa-user"></i> Admin Account</label>
                            <select id="emailFilter" class="filter-select" onchange="handleFilterChange()">
                                <option value="all" <%= currentEmail === 'all' ? 'selected' : '' %>>All Admins (4 Accounts)</option>
                                <option value="admin@vipparty.com" <%= currentEmail === 'admin@vipparty.com' ? 'selected' : '' %>>Mukesh Sahani (admin@vipparty.com)</option>
                                <option value="editor@vipparty.com" <%= currentEmail === 'editor@vipparty.com' ? 'selected' : '' %>>Vikram Sharma (editor@vipparty.com)</option>
                                <option value="manager@vipparty.com" <%= currentEmail === 'manager@vipparty.com' ? 'selected' : '' %>>Pooja Dhakad (manager@vipparty.com)</option>
                                <option value="media@vipparty.com" <%= currentEmail === 'media@vipparty.com' ? 'selected' : '' %>>Ravi Verma (media@vipparty.com)</option>
                            </select>
                        </div>

                        <!-- Filter by Section -->
                        <div class="filter-group">
                            <label for="sectionFilter"><i class="fa-solid fa-folder-tree"></i> Section / Module</label>
                            <select id="sectionFilter" class="filter-select" onchange="handleFilterChange()">
                                <option value="all">All Sections</option>
                                <% if (allSections && allSections.length > 0) { %>
                                    <% allSections.forEach(function(sec) { %>
                                        <option value="<%= sec %>" <%= currentSection === sec ? 'selected' : '' %>><%= sec %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <!-- Filter by Action Type -->
                        <div class="filter-group">
                            <label for="actionTypeFilter"><i class="fa-solid fa-arrow-right-arrow-left"></i> Action Type</label>
                            <select id="actionTypeFilter" class="filter-select" onchange="handleFilterChange()">
                                <option value="all">All Actions</option>
                                <option value="create" <%= currentActionType === 'create' ? 'selected' : '' %>>Created / Added (+)</option>
                                <option value="update" <%= currentActionType === 'update' ? 'selected' : '' %>>Updated / Edited (✎)</option>
                                <option value="delete" <%= currentActionType === 'delete' ? 'selected' : '' %>>Deleted / Removed (✕)</option>
                            </select>
                        </div>

                        <!-- Search keyword (Debounced) -->
                        <div class="filter-group">
                            <label for="searchInput"><i class="fa-solid fa-magnifying-glass"></i> Search Details</label>
                            <div class="search-wrap">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input 
                                    type="text" 
                                    id="searchInput"
                                    class="search-input" 
                                    placeholder="Search changes, workers, banners..." 
                                    value="<%= currentSearch %>"
                                    oninput="handleSearchInput()"
                                >
                            </div>
                        </div>

                        <div class="filter-actions">
                            <button type="button" class="btn-filter-reset" onclick="resetAllClientFilters()">
                                <i class="fa-solid fa-rotate"></i> Reset Filters
                            </button>
                        </div>
                    </div>

                    <!-- View Switcher Tabs -->
                    <div class="view-tabs">
                        <button type="button" class="tab-btn active" id="tabFeedBtn" onclick="switchView('feed')">
                            <i class="fa-solid fa-list-check"></i> Activity Feed
                        </button>
                        <button type="button" class="tab-btn" id="tabTimelineBtn" onclick="switchView('timeline')">
                            <i class="fa-solid fa-timeline"></i> Timeline View
                        </button>
                    </div>
                </div>
            </div>

            <!-- LIVE STATUS STRIP -->
            <div class="filter-status-strip" id="filterStatusStrip">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <i class="fa-solid fa-circle-check" style="color: #10b981;"></i>
                    <span id="filterStatusText">
                        Showing <strong><%= pagination.startIndex %> - <%= pagination.endIndex %></strong> of <strong><%= pagination.totalCount %> activities</strong> (Page <%= pagination.page %> of <%= pagination.totalPages %>)
                    </span>
                    <span id="loadingIndicator" class="loading-indicator-pill" style="display: none;">
                        <i class="fa-solid fa-spinner fa-spin"></i> Fetching logs...
                    </span>
                </div>
                <button 
                    type="button" 
                    id="btnClearActiveFilter" 
                    onclick="resetAllClientFilters()" 
                    style="display: none; background: none; border: none; color: #0b4ea2; font-weight: 700; cursor: pointer; text-decoration: underline;"
                >
                    Show All Admins
                </button>
            </div>

            <div id="activityViewRoot"></div>

            <!-- ACTIVITIES LIST CONTAINER (10 ITEMS PER PAGE) -->
            <div id="activitiesListContainer" class="activities-list-container">
                <% if (activities && activities.length > 0) { %>
                    <% activities.forEach(function(act) { %>
                        <div class="activity-feed-card" id="activity-<%= act._id %>">
                            <div class="afc-header">
                                <div class="afc-user">
                                    <div class="afc-avatar" style="background: <%= act.avatarBg || 'linear-gradient(135deg, #0b4ea2 0%, #083d80 100%)' %>;">
                                        <i class="<%= act.adminIcon || 'fa-solid fa-user-shield' %>"></i>
                                    </div>
                                    <div class="afc-user-info">
                                        <div class="afc-name-wrap">
                                            <span class="afc-name"><%= act.adminName || 'Admin' %></span>
                                            <span class="role-tag <%= act.adminRoleClass || 'custom' %>"><%= act.adminRole || 'Administrator' %></span>
                                        </div>
                                        <div class="afc-email"><%= act.adminEmail %></div>
                                    </div>
                                </div>

                                <div class="afc-tags">
                                    <span class="act-section-badge">
                                        <i class="<%= act.sectionIcon || 'fa-solid fa-cube' %>" style="color: #0b4ea2;"></i>
                                        <%= act.section %>
                                    </span>
                                    <span class="act-type-tag <%= act.actionType %>">
                                        <% if (act.actionType === 'create') { %>+ Added
                                        <% } else if (act.actionType === 'update') { %>✎ Modified
                                        <% } else if (act.actionType === 'delete') { %>✕ Removed
                                        <% } else { %><%= act.actionType %><% } %>
                                    </span>
                                </div>
                            </div>

                            <div class="afc-body">
                                <h4 class="afc-title"><%= act.action %></h4>
                                <% if (act.details) { %>
                                    <p class="afc-details"><%= act.details %></p>
                                <% } %>
                            </div>

                            <div class="afc-footer">
                                <div class="afc-meta">
                                    <span class="afc-time-ago">
                                        <i class="fa-regular fa-clock"></i> <%= act.timeAgo %>
                                    </span>
                                    <span>&bull;</span>
                                    <span class="afc-exact-date">
                                        <i class="fa-regular fa-calendar"></i> <%= act.exactTime %>
                                    </span>
                                    <% if (act.ip) { %>
                                        <span>&bull;</span>
                                        <span class="afc-ip">
                                            <i class="fa-solid fa-network-wired"></i> IP: <%= act.ip %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- EMPTY RESULTS BOX -->
            <div class="empty-results-box" id="emptyNotice" style="<%= activities && activities.length > 0 ? 'display: none;' : 'display: block;' %>">
                <i class="fa-solid fa-folder-open"></i>
                <h4>No Activities Found</h4>
                <p>Try adjusting your search terms or filter dropdowns above.</p>
                <button type="button" class="btn-filter-reset" onclick="resetAllClientFilters()" style="background:#0b4ea2; color:#fff; border:none; padding:9px 18px;">
                    Reset All Filters
                </button>
            </div>

            <!-- =========================================================
                 PAGINATION & LOAD MORE CONTROLS
            ========================================================= -->
            <div class="pagination-section" id="paginationSection" style="<%= pagination.totalCount === 0 ? 'display: none;' : '' %>">
                <!-- Load More Button (+10 items) -->
                <div class="load-more-wrap">
                    <button 
                        type="button" 
                        class="btn-load-more" 
                        id="btnLoadMore" 
                        onclick="loadMoreActivities()"
                        <%= !pagination.hasNextPage ? 'disabled' : '' %>
                    >
                        <i class="fa-solid fa-angles-down" id="loadMoreIcon"></i>
                        <span id="loadMoreBtnText">
                            <%= pagination.hasNextPage ? 'Load More Activities (+10)' : 'All ' + pagination.totalCount + ' Activities Loaded' %>
                        </span>
                        <span class="load-more-badge" id="loadMoreCountBadge">
                            <%= pagination.endIndex %> / <%= pagination.totalCount %>
                        </span>
                    </button>
                </div>

                <!-- Pagination Page Navigation Bar -->
                <div class="pagination-bar">
                    <div class="pagination-info" id="paginationBarInfo">
                        Showing <strong><%= pagination.startIndex %> - <%= pagination.endIndex %></strong> of <strong><%= pagination.totalCount %></strong> activities
                    </div>

                    <div class="pagination-controls">
                        <button 
                            type="button" 
                            class="page-nav-btn" 
                            id="btnPrevPage" 
                            onclick="goToPage(state.page - 1)" 
                            <%= !pagination.hasPrevPage ? 'disabled' : '' %>
                        >
                            <i class="fa-solid fa-chevron-left"></i> Previous
                        </button>

                        <div class="page-numbers-list" id="pageNumbersList">
                            <!-- Injected by JavaScript -->
                        </div>

                        <button 
                            type="button" 
                            class="page-nav-btn" 
                            id="btnNextPage" 
                            onclick="goToPage(state.page + 1)" 
                            <%= !pagination.hasNextPage ? 'disabled' : '' %>
                        >
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- =========================================================
         PAGINATED ACTIVITY AUDIT LOG INTERACTION SCRIPT
    ========================================================= -->
    <script>
        // Central client state
        const state = {
            page: <%= pagination.page || 1 %>,
            limit: <%= pagination.limit || 10 %>,
            email: '<%= currentEmail || "all" %>',
            section: '<%= currentSection || "all" %>',
            actionType: '<%= currentActionType || "all" %>',
            search: '<%= currentSearch || "" %>',
            totalCount: <%= pagination.totalCount || 0 %>,
            totalPages: <%= pagination.totalPages || 1 %>,
            hasNextPage: <%= pagination.hasNextPage ? 'true' : 'false' %>,
            hasPrevPage: <%= pagination.hasPrevPage ? 'true' : 'false' %>,
            startIndex: <%= pagination.startIndex || 0 %>,
            endIndex: <%= pagination.endIndex || 0 %>,
            activities: <%- JSON.stringify(activities || []) %>,
            viewMode: 'feed', // 'feed' or 'timeline'
            isLoading: false,
        };

        let searchDebounceTimeout = null;

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Render individual card for Feed View
        function renderFeedCard(act) {
            let actionBadge = act.actionType;
            if (act.actionType === 'create') actionBadge = '+ Added';
            else if (act.actionType === 'update') actionBadge = '✎ Modified';
            else if (act.actionType === 'delete') actionBadge = '✕ Removed';

            return `
            <div class="activity-feed-card" id="activity-${act._id}">
                <div class="afc-header">
                    <div class="afc-user">
                        <div class="afc-avatar" style="background: ${act.avatarBg || 'linear-gradient(135deg, #0b4ea2 0%, #083d80 100%)'};">
                            <i class="${escapeHtml(act.adminIcon || 'fa-solid fa-user-shield')}"></i>
                        </div>
                        <div class="afc-user-info">
                            <div class="afc-name-wrap">
                                <span class="afc-name">${escapeHtml(act.adminName || 'Admin')}</span>
                                <span class="role-tag ${escapeHtml(act.adminRoleClass || 'custom')}">${escapeHtml(act.adminRole || 'Administrator')}</span>
                            </div>
                            <div class="afc-email">${escapeHtml(act.adminEmail || '')}</div>
                        </div>
                    </div>

                    <div class="afc-tags">
                        <span class="act-section-badge">
                            <i class="${escapeHtml(act.sectionIcon || 'fa-solid fa-cube')}" style="color: #0b4ea2;"></i>
                            ${escapeHtml(act.section || 'General')}
                        </span>
                        <span class="act-type-tag ${escapeHtml(act.actionType || 'update')}">
                            ${actionBadge}
                        </span>
                    </div>
                </div>

                <div class="afc-body">
                    <h4 class="afc-title">${escapeHtml(act.action || 'Activity Recorded')}</h4>
                    ${act.details ? `<p class="afc-details">${escapeHtml(act.details)}</p>` : ''}
                </div>

                <div class="afc-footer">
                    <div class="afc-meta">
                        <span class="afc-time-ago">
                            <i class="fa-regular fa-clock"></i> ${escapeHtml(act.timeAgo || 'Recently')}
                        </span>
                        <span>&bull;</span>
                        <span class="afc-exact-date">
                            <i class="fa-regular fa-calendar"></i> ${escapeHtml(act.exactTime || '')}
                        </span>
                        ${act.ip ? `<span>&bull;</span><span class="afc-ip"><i class="fa-solid fa-network-wired"></i> IP: ${escapeHtml(act.ip)}</span>` : ''}
                    </div>
                </div>
            </div>
            `;
        }

        // Render individual card for Timeline View
        function renderTimelineCard(act) {
            let actionBadge = act.actionType;
            if (act.actionType === 'create') actionBadge = '+ Added';
            else if (act.actionType === 'update') actionBadge = '✎ Modified';
            else if (act.actionType === 'delete') actionBadge = '✕ Removed';

            return `
            <div class="timeline-card">
                <div class="tl-user-badge">
                    <div class="tl-avatar" style="background: ${act.avatarBg || 'linear-gradient(135deg, #0b4ea2 0%, #083d80 100%)'};">
                        <i class="${escapeHtml(act.adminIcon || 'fa-solid fa-user-shield')}"></i>
                    </div>
                    <div>
                        <div class="tl-user-name">${escapeHtml(act.adminName || 'Admin')}</div>
                        <div class="tl-user-email">${escapeHtml(act.adminEmail || '')}</div>
                    </div>
                </div>

                <div class="tl-body">
                    <div class="act-header-line">
                        <span class="act-section-badge">
                            <i class="${escapeHtml(act.sectionIcon || 'fa-solid fa-cube')}" style="color: #0b4ea2;"></i>
                            ${escapeHtml(act.section || 'General')}
                        </span>
                        <h5 class="act-title">${escapeHtml(act.action || 'Activity')}</h5>
                        <span class="act-type-tag ${escapeHtml(act.actionType || 'update')}">
                            ${actionBadge}
                        </span>
                    </div>
                    ${act.details ? `<p class="act-details">${escapeHtml(act.details)}</p>` : ''}
                </div>

                <div class="tl-time-block">
                    <div style="font-weight: 700; color: #1e293b;">${escapeHtml(act.timeAgo || 'Recently')}</div>
                    <div style="font-size: 11px; color: #94a3b8; margin-top: 2px;">${escapeHtml(act.exactTime || '')}</div>
                </div>
            </div>
            `;
        }

        // Render activities to DOM
        function renderActivities() {
            const container = document.getElementById('activitiesListContainer');
            const emptyNotice = document.getElementById('emptyNotice');
            const paginationSection = document.getElementById('paginationSection');

            if (!state.activities || state.activities.length === 0) {
                container.innerHTML = '';
                if (emptyNotice) emptyNotice.style.display = 'block';
                if (paginationSection) paginationSection.style.display = 'none';
                return;
            }

            if (emptyNotice) emptyNotice.style.display = 'none';
            if (paginationSection) paginationSection.style.display = 'flex';

            if (state.viewMode === 'feed') {
                container.innerHTML = state.activities.map(renderFeedCard).join('');
            } else {
                // Group by dateKey
                const dateGroups = {};
                state.activities.forEach(act => {
                    const k = act.dateKey || 'Recent';
                    if (!dateGroups[k]) dateGroups[k] = [];
                    dateGroups[k].push(act);
                });

                let html = '';
                Object.keys(dateGroups).forEach(dateKey => {
                    html += `
                    <div class="timeline-date-block">
                        <div class="date-divider">
                            <span class="date-badge">
                                <i class="fa-regular fa-calendar-check"></i> ${escapeHtml(dateKey)}
                            </span>
                            <div class="date-line"></div>
                        </div>
                        ${dateGroups[dateKey].map(renderTimelineCard).join('')}
                    </div>
                    `;
                });
                container.innerHTML = html;
            }
        }

        // Render pagination buttons and info bar
        function renderPaginationControls() {
            // Status strip
            const statusText = document.getElementById('filterStatusText');
            const clearBtn = document.getElementById('btnClearActiveFilter');
            const hasActiveFilter = (state.email !== 'all' || state.section !== 'all' || state.actionType !== 'all' || state.search !== '');

            if (clearBtn) clearBtn.style.display = hasActiveFilter ? 'inline-block' : 'none';

            if (statusText) {
                if (state.totalCount === 0) {
                    statusText.innerHTML = `No activities found matching your filters.`;
                } else {
                    let desc = `Showing <strong>${state.startIndex} - ${state.endIndex}</strong> of <strong>${state.totalCount} activities</strong> (Page ${state.page} of ${state.totalPages})`;
                    if (state.email !== 'all') desc += ` for <strong>${escapeHtml(state.email)}</strong>`;
                    if (state.section !== 'all') desc += ` in <strong>${escapeHtml(state.section)}</strong>`;
                    if (state.actionType !== 'all') desc += ` (${escapeHtml(state.actionType.toUpperCase())})`;
                    if (state.search) desc += ` matching "<strong>${escapeHtml(state.search)}</strong>"`;
                    statusText.innerHTML = desc;
                }
            }

            // Load more button
            const btnLoadMore = document.getElementById('btnLoadMore');
            const loadMoreText = document.getElementById('loadMoreBtnText');
            const loadMoreBadge = document.getElementById('loadMoreCountBadge');

            if (btnLoadMore && loadMoreText && loadMoreBadge) {
                if (state.hasNextPage) {
                    btnLoadMore.disabled = false;
                    loadMoreText.textContent = 'Load More Activities (+10)';
                    loadMoreBadge.textContent = `${state.endIndex} / ${state.totalCount}`;
                } else {
                    btnLoadMore.disabled = true;
                    loadMoreText.textContent = state.totalCount > 0 ? `All ${state.totalCount} Activities Loaded` : 'No Activities to Load';
                    loadMoreBadge.textContent = `${state.totalCount} / ${state.totalCount}`;
                }
            }

            // Pagination info bar
            const barInfo = document.getElementById('paginationBarInfo');
            if (barInfo) {
                barInfo.innerHTML = `Showing <strong>${state.startIndex} - ${state.endIndex}</strong> of <strong>${state.totalCount}</strong> activities`;
            }

            const btnPrev = document.getElementById('btnPrevPage');
            const btnNext = document.getElementById('btnNextPage');
            if (btnPrev) btnPrev.disabled = !state.hasPrevPage || state.isLoading;
            if (btnNext) btnNext.disabled = !state.hasNextPage || state.isLoading;

            // Page numbers
            const pageList = document.getElementById('pageNumbersList');
            if (pageList) {
                let pagesHtml = '';
                const total = state.totalPages;
                const current = state.page;

                if (total <= 7) {
                    for (let i = 1; i <= total; i++) {
                        pagesHtml += `<button type="button" class="page-num-btn ${i === current ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
                    }
                } else {
                    pagesHtml += `<button type="button" class="page-num-btn ${1 === current ? 'active' : ''}" onclick="goToPage(1)">1</button>`;

                    let start = Math.max(2, current - 1);
                    let end = Math.min(total - 1, current + 1);

                    if (start > 2) pagesHtml += `<span class="page-num-btn ellipsis">&hellip;</span>`;

                    for (let i = start; i <= end; i++) {
                        pagesHtml += `<button type="button" class="page-num-btn ${i === current ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
                    }

                    if (end < total - 1) pagesHtml += `<span class="page-num-btn ellipsis">&hellip;</span>`;

                    pagesHtml += `<button type="button" class="page-num-btn ${total === current ? 'active' : ''}" onclick="goToPage(${total})">${total}</button>`;
                }
                pageList.innerHTML = pagesHtml;
            }
        }

        // Fetch page from API (Zero full reload)
        async function fetchPage(pageNum, isAppend = false) {
            if (state.isLoading) return;
            state.isLoading = true;

            const loadingIndicator = document.getElementById('loadingIndicator');
            const loadMoreIcon = document.getElementById('loadMoreIcon');
            if (loadingIndicator) loadingIndicator.style.display = 'inline-flex';
            if (loadMoreIcon) loadMoreIcon.className = 'fa-solid fa-spinner fa-spin';

            try {
                const params = new URLSearchParams({
                    page: pageNum,
                    limit: state.limit,
                    email: state.email,
                    section: state.section,
                    actionType: state.actionType,
                    search: state.search,
                });

                const res = await fetch(`/api/activity-logs?${params.toString()}`);
                const data = await res.json();

                if (data.success) {
                    state.page = data.pagination.page;
                    state.totalCount = data.pagination.totalCount;
                    state.totalPages = data.pagination.totalPages;
                    state.hasNextPage = data.pagination.hasNextPage;
                    state.hasPrevPage = data.pagination.hasPrevPage;

                    if (isAppend) {
                        state.activities = [...state.activities, ...data.activities];
                        state.startIndex = 1;
                        state.endIndex = Math.min(state.activities.length, state.totalCount);
                    } else {
                        state.activities = data.activities;
                        state.startIndex = data.pagination.startIndex;
                        state.endIndex = data.pagination.endIndex;
                    }

                    renderActivities();
                    renderPaginationControls();

                    if (!isAppend) {
                        const target = document.getElementById('activityViewRoot');
                        if (target) {
                            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }
                }
            } catch (err) {
                console.error('Error fetching activity logs:', err);
            } finally {
                state.isLoading = false;
                if (loadingIndicator) loadingIndicator.style.display = 'none';
                if (loadMoreIcon) loadMoreIcon.className = 'fa-solid fa-angles-down';
            }
        }

        // Go to specific page
        function goToPage(pageNum) {
            if (pageNum < 1 || pageNum > state.totalPages || state.isLoading) return;
            fetchPage(pageNum, false);
        }

        // Load next 10 items
        function loadMoreActivities() {
            if (!state.hasNextPage || state.isLoading) return;
            fetchPage(state.page + 1, true);
        }

        // Handle dropdown filter changes
        function handleFilterChange() {
            const emailSelect = document.getElementById('emailFilter');
            const sectionSelect = document.getElementById('sectionFilter');
            const actionTypeSelect = document.getElementById('actionTypeFilter');

            state.email = emailSelect ? emailSelect.value : 'all';
            state.section = sectionSelect ? sectionSelect.value : 'all';
            state.actionType = actionTypeSelect ? actionTypeSelect.value : 'all';

            updateOverviewCardsActive();
            state.page = 1;
            fetchPage(1, false);
        }

        // Handle search input with debounce
        function handleSearchInput() {
            clearTimeout(searchDebounceTimeout);
            searchDebounceTimeout = setTimeout(() => {
                const searchInput = document.getElementById('searchInput');
                state.search = searchInput ? searchInput.value.trim() : '';
                state.page = 1;
                fetchPage(1, false);
            }, 350);
        }

        // One-click filter from the 4 Overview Cards
        function selectAdminFilter(email) {
            const emailSelect = document.getElementById('emailFilter');

            if (state.email.toLowerCase() === email.toLowerCase()) {
                state.email = 'all';
                if (emailSelect) emailSelect.value = 'all';
            } else {
                state.email = email;
                if (emailSelect) emailSelect.value = email;
            }

            updateOverviewCardsActive();
            state.page = 1;
            fetchPage(1, false);
        }

        // Sync card active states
        function updateOverviewCardsActive() {
            const allAdminCards = document.querySelectorAll('.admin-profile-card');
            allAdminCards.forEach(card => {
                card.classList.remove('active-filtered');
                const btn = card.querySelector('.btn-filter-admin');
                if (btn) {
                    btn.classList.remove('btn-active-state');
                    btn.innerHTML = '<i class="fa-solid fa-eye"></i> View Activity';
                }
            });

            if (state.email !== 'all') {
                const activeCardId = 'admin-overview-card-' + state.email.replace(/[@.]/g, '-');
                const activeCard = document.getElementById(activeCardId);
                if (activeCard) {
                    activeCard.classList.add('active-filtered');
                    const btn = activeCard.querySelector('.btn-filter-admin');
                    if (btn) {
                        btn.classList.add('btn-active-state');
                        btn.innerHTML = '<i class="fa-solid fa-check"></i> Viewing';
                    }
                }
            }
        }

        // Reset all filters
        function resetAllClientFilters() {
            const emailSelect = document.getElementById('emailFilter');
            const sectionSelect = document.getElementById('sectionFilter');
            const actionTypeSelect = document.getElementById('actionTypeFilter');
            const searchInput = document.getElementById('searchInput');

            if (emailSelect) emailSelect.value = 'all';
            if (sectionSelect) sectionSelect.value = 'all';
            if (actionTypeSelect) actionTypeSelect.value = 'all';
            if (searchInput) searchInput.value = '';

            state.email = 'all';
            state.section = 'all';
            state.actionType = 'all';
            state.search = '';

            updateOverviewCardsActive();
            state.page = 1;
            fetchPage(1, false);
        }

        // Switch View Tab (Feed vs Timeline)
        function switchView(view) {
            state.viewMode = view;
            const tabFeedBtn = document.getElementById('tabFeedBtn');
            const tabTimelineBtn = document.getElementById('tabTimelineBtn');

            if (view === 'timeline') {
                if (tabFeedBtn) tabFeedBtn.classList.remove('active');
                if (tabTimelineBtn) tabTimelineBtn.classList.add('active');
            } else {
                if (tabTimelineBtn) tabTimelineBtn.classList.remove('active');
                if (tabFeedBtn) tabFeedBtn.classList.add('active');
            }

            renderActivities();
        }

        // Initial setup on page load
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('responsiveSidebar');
            const isMobile = window.innerWidth <= 992;
            
            if (!isMobile) {
                document.body.classList.remove('sidebar-collapsed');
            } else {
                if (sidebar) {
                    sidebar.classList.remove('sidebar-open');
                }
            }

            updateOverviewCardsActive();
            renderPaginationControls();
        });
    </script>
</body>
</html>
