<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/sidebar.css">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f4f7fc;
      margin: 0;
      padding: 0;
      color: #222;
    }
    .main-content {
      margin-left: 270px;
      padding: 24px 30px;
    }
    @media(max-width: 1100px) {
      .main-content {
        margin-left: 0;
        padding: 80px 15px 20px;
      }
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }
    h1 {
      color: #0d47a1;
      margin: 0;
      font-size: 26px;
      font-weight: 700;
    }

    /* Stats Cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: #fff;
      padding: 16px 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      border-left: 4px solid #1565c0;
    }
    .stat-card.pending { border-left-color: #f59e0b; }
    .stat-card.approved { border-left-color: #10b981; }
    .stat-card.rejected { border-left-color: #ef4444; }
    .stat-title {
      font-size: 13px;
      color: #64748b;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: #1e293b;
      margin-top: 6px;
    }

    /* Toolbar */
    .toolbar-card {
      background: #fff;
      padding: 16px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }
    .toolbar-card input, .toolbar-card select {
      padding: 9px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
      background: #fff;
    }
    .toolbar-card input:focus, .toolbar-card select:focus {
      border-color: #1565c0;
      box-shadow: 0 0 0 2px rgba(21, 101, 192, 0.15);
    }
    .toolbar-card input {
      flex: 1;
      min-width: 220px;
    }
    .btn-filter {
      padding: 9px 18px;
      background: #1565c0;
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s;
    }
    .btn-filter:hover {
      background: #0d47a1;
    }
    .btn-reset {
      padding: 9px 14px;
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
    }

    /* Table */
    .table-responsive {
      background: #fff;
      border-radius: 12px;
      overflow-x: auto;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      min-width: 850px;
    }
    th, td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }
    th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    tbody tr:hover {
      background: #f8fafc;
    }

    /* Badges */
    .badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      display: inline-block;
      text-align: center;
    }
    .badge-pending { background: #fef3c7; color: #b45309; }
    .badge-approved { background: #d1fae5; color: #047857; }
    .badge-rejected { background: #fee2e2; color: #b91c1c; }
    .badge-type { background: #eff6ff; color: #1d4ed8; font-weight: 600; }
    .badge-blood { background: #fce7f3; color: #be185d; font-weight: 800; font-size: 11px; }

    .user-thumb {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
    }
    .user-initials {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #1e3a8a;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
    }

    /* Action Buttons */
    .actions {
      display: flex;
      gap: 6px;
      flex-wrap: nowrap;
    }
    .actions button {
      border: none;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      color: #fff;
      transition: opacity 0.2s;
    }
    .actions button:hover { opacity: 0.9; }
    .btn-view { background: #1565c0; }
    .btn-approve { background: #10b981; }
    .btn-reject { background: #f59e0b; }
    .btn-delete { background: #64748b; }

    /* Pagination */
    .pagination {
      margin-top: 18px;
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: flex-end;
    }
    .pagination button {
      padding: 7px 14px;
      border: 1px solid #cbd5e1;
      background: #fff;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      color: #334155;
    }
    .pagination button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    #pageLabel {
      font-size: 14px;
      color: #64748b;
      margin: 0 8px;
    }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(2px);
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #fff;
      border-radius: 16px;
      padding: 28px;
      width: 620px;
      max-width: 92vw;
      max-height: 88vh;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 14px;
      margin-bottom: 20px;
    }
    .modal-header h2 {
      margin: 0;
      color: #0d47a1;
      font-size: 20px;
      font-weight: 700;
    }
    .modal-close {
      cursor: pointer;
      font-size: 22px;
      color: #94a3b8;
      font-weight: bold;
      border: none;
      background: none;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
      margin-bottom: 20px;
    }
    @media(max-width: 500px) {
      .detail-grid { grid-template-columns: 1fr; }
    }
    .detail-item {
      font-size: 14px;
      line-height: 1.5;
    }
    .detail-label {
      color: #64748b;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .detail-val {
      color: #0f172a;
      font-weight: 600;
    }
    .modal-photo-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid #f1f5f9;
    }
    .modal-photo-img {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      object-fit: cover;
      border: 2px solid #1565c0;
    }
    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid #e2e8f0;
      justify-content: flex-end;
    }
    .modal-actions button {
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      color: #fff;
    }
  </style>
</head>
<body>
  <%- include("common/sidebar") %>

  <div class="main-content">
    <div class="page-header">
      <div>
        <h1><%= pageTitle %></h1>
        <p style="color: #64748b; margin: 4px 0 0; font-size: 14px;">Manage member applications, review details and approve membership cards.</p>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-title">Total Applications</div>
        <div class="stat-value" id="statTotal"><%= typeof total !== 'undefined' ? total : 0 %></div>
      </div>
      <div class="stat-card pending">
        <div class="stat-title">Pending Review</div>
        <div class="stat-value" id="statPending"><%= typeof pendingCount !== 'undefined' ? pendingCount : 0 %></div>
      </div>
      <div class="stat-card approved">
        <div class="stat-title">Approved Cards</div>
        <div class="stat-value" id="statApproved"><%= typeof approvedCount !== 'undefined' ? approvedCount : 0 %></div>
      </div>
      <div class="stat-card rejected">
        <div class="stat-title">Rejected</div>
        <div class="stat-value" id="statRejected"><%= typeof rejectedCount !== 'undefined' ? rejectedCount : 0 %></div>
      </div>
    </div>

    <!-- Separate, searchable, paginated submitter directory -->
    <section style="margin: 18px 0 24px; padding: 18px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px;">
        <div>
          <h2 style="margin: 0; color: #1e293b; font-size: 18px;">Users Who Added Members</h2>
          <p style="margin: 4px 0 0; color: #64748b; font-size: 13px;">Search users, see their totals, and open their complete member list.</p>
        </div>
        <div style="display: flex; gap: 8px;">
          <input id="agentSearchInput" type="search" placeholder="Search name, phone or email" onkeypress="if(event.key === 'Enter') loadAgents(1)" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; min-width: 240px;" />
          <button type="button" class="btn-filter" onclick="loadAgents(1)">Search users</button>
        </div>
      </div>
      <div class="table-responsive">
        <table style="min-width: 760px;">
          <thead><tr><th>User</th><th>Phone</th><th>Email</th><th>Account Type</th><th>Total Added</th><th>Actions</th></tr></thead>
          <tbody id="agentsTableBody"><tr><td colspan="6" style="text-align:center; padding:20px; color:#64748b;">Loading users...</td></tr></tbody>
        </table>
      </div>
      <div class="pagination">
        <button id="agentsPrevBtn" onclick="changeAgentPage(-1)" disabled>Previous</button>
        <span id="agentsPageLabel">Page 1</span>
        <button id="agentsNextBtn" onclick="changeAgentPage(1)" disabled>Next</button>
      </div>
    </section>

    <!-- Toolbar Filters -->
    <div class="toolbar-card" id="applicationsSection">
      <input type="text" id="searchInput" placeholder="Search name, mobile, email, member ID, blood group, PIN..." onkeypress="if(event.key === 'Enter') loadApplications(1)" />

      <select id="statusFilter" onchange="loadApplications(1)">
        <option value="">All Statuses</option>
        <option value="Pending">Pending Review</option>
        <option value="Approved">Approved</option>
        <option value="Rejected">Rejected</option>
      </select>

      <select id="typeFilter" onchange="loadApplications(1)">
        <option value="">All Categories</option>
        <option value="party_member">Party Member</option>
        <option value="student_member">Student Wing</option>
        <option value="volunteer_member">Volunteer</option>
        <option value="quick_member">Quick Member</option>
      </select>

      <select id="sourceFilter" onchange="onSourceFilterChange()">
        <option value="">All Applications</option>
        <option value="self">Self-added users</option>
        <option value="agent">Agent-added users</option>
      </select>

      <button class="btn-filter" onclick="loadApplications(1)">Search</button>
      <button class="btn-reset" onclick="resetFilters()">Reset</button>
    </div>
    <p id="applicationScopeNote" style="display:none; margin: -8px 0 12px; color:#475569; font-size:14px;"></p>

    <!-- Table -->
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Photo</th>
            <th>Applicant Name</th>
            <th>Mobile</th>
            <th>Category</th>
            <th>User Type</th>
            <th>Blood Group</th>
            <th>Status</th>
            <th>Member ID</th>
            <th>Applied On</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          <% if (applications && applications.length > 0) { %>
            <% applications.forEach(function(app) { %>
              <tr data-id="<%= app._id %>">
                <td>
                  <% if (app.profilePhoto) { %>
                    <img src="<%= app.profilePhoto %>" alt="Photo" class="user-thumb" />
                  <% } else { %>
                    <div class="user-initials"><%= (app.fullName || "VP").substring(0, 2).toUpperCase() %></div>
                  <% } %>
                </td>
                <td>
                  <strong style="color: #1e293b;"><%= app.fullName %></strong>
                  <% if (app.fatherName) { %><div style="font-size: 12px; color: #64748b;">S/D/W: <%= app.fatherName %></div><% } %>
                </td>
                <td><%= app.mobile %></td>
                <td><span class="badge badge-type"><%= (app.type || 'party_member').replace('_', ' ').toUpperCase() %></span></td>
                <td><span class="badge <%= app.addedBy ? 'badge-type' : 'badge-approved' %>"><%= app.addedBy ? 'Added by Agent' : 'Self User' %></span></td>
                <td>
                  <% if (app.bloodGroup) { %>
                    <span class="badge badge-blood"><%= app.bloodGroup %></span>
                  <% } else { %>
                    <span style="color: #94a3b8;">-</span>
                  <% } %>
                </td>
                <td>
                  <% const s = app.status || 'Pending'; %>
                  <span class="badge badge-<%= s.toLowerCase() %>"><%= s %></span>
                </td>
                <td>
                  <% if (app.memberId) { %>
                    <code style="background: #f1f5f9; padding: 3px 6px; border-radius: 4px; font-weight: bold; color: #1e3a8a;"><%= app.memberId %></code>
                  <% } else { %>
                    <span style="color: #94a3b8;">Pending Approval</span>
                  <% } %>
                </td>
                <td><%= new Date(app.createdAt).toLocaleDateString("en-GB") %></td>
                <td class="actions">
                  <button class="btn-view" onclick="viewApplication('<%= app._id %>')">View</button>
                  <% if (app.status !== 'Approved') { %>
                    <button class="btn-approve" onclick="approveApplication('<%= app._id %>')">Approve</button>
                  <% } %>
                  <% if (app.status === 'Pending') { %>
                    <button class="btn-reject" onclick="rejectApplication('<%= app._id %>')">Reject</button>
                  <% } %>
                  <button class="btn-delete" onclick="deleteApplication('<%= app._id %>')">Delete</button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="10" style="text-align:center; padding: 24px; color: #64748b;">No applications found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination">
      <button id="prevBtn" onclick="changePage(-1)">Previous</button>
      <span id="pageLabel">Page 1</span>
      <button id="nextBtn" onclick="changePage(1)">Next</button>
    </div>

    <!-- Detail Modal -->
    <div class="modal-overlay" id="viewModal">
      <div class="modal-box">
        <div class="modal-header">
          <h2>Application Details</h2>
          <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div id="modalContent">Loading...</div>
      </div>
    </div>
  </div>

  <script>
    let currentPage = 1;
    let totalPages = 1;
    let currentAgentPage = 1;
    let totalAgentPages = 1;
    let selectedAgentId = "";
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[char]);

    async function loadAgents(page = 1) {
      currentAgentPage = page;
      const search = document.getElementById("agentSearchInput").value.trim();
      const params = new URLSearchParams({ page, limit: 10, search });

      try {
        const res = await fetch(`/joinmember/agents?${params.toString()}`);
        const json = await res.json();
        if (!json.success) throw new Error(json.message || "Failed to load users.");

        const tbody = document.getElementById("agentsTableBody");
        if (!json.data.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px; color:#64748b;">No users have added members yet.</td></tr>';
        } else {
          tbody.innerHTML = json.data.map((agent) => `
            <tr data-agent-id="${agent._id}">
              <td><strong>${escapeHtml(agent.name || "Unnamed user")}</strong><div style="font-size:12px;color:#64748b;">${escapeHtml(agent.uid || "")}</div></td>
              <td>${escapeHtml(agent.phone || "-")}</td>
              <td>${escapeHtml(agent.email || "-")}</td>
              <td><span class="badge ${agent.isAgent ? "badge-approved" : "badge-type"}">${agent.isAgent ? "Verified agent" : "Member submitter"}</span></td>
              <td><strong>${agent.memberCount}</strong></td>
              <td><button type="button" class="btn-view" onclick="filterByAgent('${agent._id}')">View members</button></td>
            </tr>
          `).join("");
        }

        currentAgentPage = json.pagination.page;
        totalAgentPages = json.pagination.totalPages;
        document.getElementById("agentsPageLabel").textContent = `Page ${currentAgentPage} of ${totalAgentPages} (${json.pagination.total} users)`;
        document.getElementById("agentsPrevBtn").disabled = currentAgentPage <= 1;
        document.getElementById("agentsNextBtn").disabled = currentAgentPage >= totalAgentPages;
      } catch (err) {
        console.error(err);
        document.getElementById("agentsTableBody").innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px; color:#b91c1c;">Could not load users. Try again.</td></tr>';
      }
    }

    function changeAgentPage(delta) {
      const next = currentAgentPage + delta;
      if (next < 1 || next > totalAgentPages) return;
      loadAgents(next);
    }

    function resetFilters() {
      document.getElementById("searchInput").value = "";
      document.getElementById("statusFilter").value = "";
      document.getElementById("typeFilter").value = "";
      document.getElementById("sourceFilter").value = "";
      selectedAgentId = "";
      document.getElementById("applicationScopeNote").style.display = "none";
      loadApplications(1);
    }

    function onSourceFilterChange() {
      const source = document.getElementById("sourceFilter").value;
      if (source !== "agent") selectedAgentId = "";
      const note = document.getElementById("applicationScopeNote");
      if (source === "agent" && selectedAgentId) {
        const agentRow = document.querySelector(`#agentsTableBody tr[data-agent-id="${selectedAgentId}"]`);
        const agentName = agentRow?.querySelector("td strong")?.textContent?.trim() || "selected user";
        note.textContent = `Showing all applications added by ${agentName}.`;
      } else {
        note.textContent = source === "self"
          ? "Showing self-added applications."
          : source === "agent"
            ? "Showing all agent-added applications."
            : "Showing all applications.";
      }
      note.style.display = "block";
      loadApplications(1);
    }

    async function loadApplications(page = 1) {
      currentPage = page;
      const type = document.getElementById("typeFilter").value;
      const status = document.getElementById("statusFilter").value;
      const search = document.getElementById("searchInput").value;
      const source = document.getElementById("sourceFilter").value;
      const params = new URLSearchParams({
        page,
        limit: 20,
        type,
        status,
        search,
        source,
        addedBy: selectedAgentId
      });

      try {
        const res = await fetch(`/joinmember/data?${params.toString()}`);
        const json = await res.json();

        if (!json.success) {
          alert(json.message || "Failed to load applications.");
          return;
        }

        renderTable(json.data);

        if (json.counts) {
          if (json.counts.total !== undefined) document.getElementById("statTotal").textContent = json.counts.total;
          if (json.counts.pending !== undefined) document.getElementById("statPending").textContent = json.counts.pending;
          if (json.counts.approved !== undefined) document.getElementById("statApproved").textContent = json.counts.approved;
          if (json.counts.rejected !== undefined) document.getElementById("statRejected").textContent = json.counts.rejected;
        }

        totalPages = json.pagination.totalPages || 1;
        document.getElementById("pageLabel").textContent = `Page ${json.pagination.page} of ${totalPages}`;
        document.getElementById("prevBtn").disabled = json.pagination.page <= 1;
        document.getElementById("nextBtn").disabled = json.pagination.page >= totalPages;
      } catch (err) {
        console.error(err);
      }
    }

    function renderTable(rows) {
      const tbody = document.getElementById("tableBody");
      tbody.innerHTML = "";

      if (!rows || rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding: 24px; color: #64748b;">No applications match your filter.</td></tr>`;
        return;
      }

      rows.forEach((app) => {
        const tr = document.createElement("tr");
        const status = app.status || "Pending";
        const statusClass = status.toLowerCase();
        const typeDisplay = (app.type || "party_member").replace(/_/g, " ").toUpperCase();

        const photoHtml = app.profilePhoto
          ? `<img src="${app.profilePhoto}" alt="Photo" class="user-thumb" />`
          : `<div class="user-initials">${(app.fullName || "VP").substring(0, 2).toUpperCase()}</div>`;

        tr.innerHTML = `
          <td>${photoHtml}</td>
          <td>
            <strong style="color: #1e293b;">${app.fullName}</strong>
            ${app.fatherName ? `<div style="font-size: 12px; color: #64748b;">S/D/W: ${app.fatherName}</div>` : ""}
          </td>
          <td>${app.mobile}</td>
          <td><span class="badge badge-type">${typeDisplay}</span></td>
          <td><span class="badge ${app.addedBy ? "badge-type" : "badge-approved"}">${app.addedBy ? "Added by Agent" : "Self User"}</span></td>
          <td>${app.bloodGroup ? `<span class="badge badge-blood">${app.bloodGroup}</span>` : `<span style="color: #94a3b8;">-</span>`}</td>
          <td><span class="badge badge-${statusClass}">${status}</span></td>
          <td>
            ${app.memberId ? `<code style="background: #f1f5f9; padding: 3px 6px; border-radius: 4px; font-weight: bold; color: #1e3a8a;">${app.memberId}</code>` : `<span style="color: #94a3b8;">Pending Approval</span>`}
          </td>
          <td>${new Date(app.createdAt).toLocaleDateString("en-GB")}</td>
          <td class="actions">
            <button class="btn-view" onclick="viewApplication('${app._id}')">View</button>
            ${status !== "Approved" ? `<button class="btn-approve" onclick="approveApplication('${app._id}')">Approve</button>` : ""}
            ${status === "Pending" ? `<button class="btn-reject" onclick="rejectApplication('${app._id}')">Reject</button>` : ""}
            <button class="btn-delete" onclick="deleteApplication('${app._id}')">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }
    function filterByAgent(agentId) {
      document.getElementById("searchInput").value = "";
      document.getElementById("statusFilter").value = "";
      document.getElementById("typeFilter").value = "";
      document.getElementById("sourceFilter").value = "agent";
      selectedAgentId = agentId;
      const agentRow = document.querySelector(`#agentsTableBody tr[data-agent-id="${agentId}"]`);
      const agentName = agentRow?.querySelector("td strong")?.textContent?.trim() || "selected user";
      const note = document.getElementById("applicationScopeNote");
      note.textContent = `Showing all applications added by ${agentName}.`;
      note.style.display = "block";
      loadApplications(1);
      document.getElementById("applicationsSection").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function changePage(delta) {
      const next = currentPage + delta;
      if (next < 1 || next > totalPages) return;
      loadApplications(next);
    }

    async function viewApplication(id) {
      const modal = document.getElementById("viewModal");
      const content = document.getElementById("modalContent");
      modal.classList.add("open");
      content.innerHTML = '<div style="text-align:center; padding: 30px;">Loading application details...</div>';

      try {
        const res = await fetch(`/joinmember/${id}`);
        const json = await res.json();

        if (!json.success || !json.data) {
          content.innerHTML = '<p style="color:red;">Failed to load application details.</p>';
          return;
        }

        const a = json.data;
        const status = a.status || "Pending";
        const statusClass = status.toLowerCase();

        content.innerHTML = `
          <div class="modal-photo-row">
            ${a.profilePhoto ? `<img src="${a.profilePhoto}" class="modal-photo-img" />` : `<div class="user-initials" style="width: 80px; height: 80px; font-size: 28px; border-radius: 12px;">${(a.fullName || "VP").substring(0, 2).toUpperCase()}</div>`}
            <div>
              <h3 style="margin: 0 0 6px; color: #1e293b; font-size: 20px;">${a.fullName}</h3>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <span class="badge badge-${statusClass}">${status}</span>
                <span class="badge badge-type">${(a.type || "party_member").replace(/_/g, " ").toUpperCase()}</span>
                ${a.bloodGroup ? `<span class="badge badge-blood">Blood: ${a.bloodGroup}</span>` : ""}
              </div>
              ${a.memberId ? `<div style="margin-top: 8px; font-size: 14px;"><strong>Member ID:</strong> <code style="color: #1e3a8a; font-weight: bold;">${a.memberId}</code></div>` : ""}
            </div>
          </div>

          <h4 style="margin: 16px 0 10px; color: #0d47a1; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;">Personal Information</h4>
          <div class="detail-grid">
            <div class="detail-item"><div class="detail-label">Mobile Number</div><div class="detail-val">${a.mobile}</div></div>
            <div class="detail-item"><div class="detail-label">Father's / Husband's Name</div><div class="detail-val">${a.fatherName || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Gender</div><div class="detail-val">${a.gender || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Date of Birth</div><div class="detail-val">${a.dob ? new Date(a.dob).toLocaleDateString("en-GB") : "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Blood Group</div><div class="detail-val" style="color: #be185d;">${a.bloodGroup || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Email Address</div><div class="detail-val">${a.email || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Alternate Mobile</div><div class="detail-val">${a.alternateMobile || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">WhatsApp Number</div><div class="detail-val">${a.whatsappNumber || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Occupation</div><div class="detail-val">${a.occupation || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Application Source</div><div class="detail-val">${a.addedBy ? `Added by ${a.addedBy.name || a.addedBy.phone || a.addedBy.email || a.addedBy.uid}` : "Self application"}</div></div>
          </div>

          <h4 style="margin: 16px 0 10px; color: #0d47a1; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;">Address & Constituency</h4>
          <div class="detail-grid">
            <div class="detail-item"><div class="detail-label">Full Address</div><div class="detail-val">${a.address || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">State / District</div><div class="detail-val">${a.state || "-"} / ${a.district || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Block / Tehsil</div><div class="detail-val">${a.block || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Police Station</div><div class="detail-val">${a.policeStation || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">Assembly Constituency</div><div class="detail-val">${a.assembly || "-"}</div></div>
            <div class="detail-item"><div class="detail-label">PIN Code</div><div class="detail-val" style="color: #0d47a1;">${a.pinCode || "-"}</div></div>
          </div>

          ${a.type === "student_member" ? `
            <h4 style="margin: 16px 0 10px; color: #0d47a1; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;">Student Wing Details</h4>
            <div class="detail-grid">
              <div class="detail-item"><div class="detail-label">College / University</div><div class="detail-val">${a.collegeName || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Course</div><div class="detail-val">${a.course || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Year / Semester</div><div class="detail-val">${a.yearSemester || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Student ID</div><div class="detail-val">${a.studentId || "-"}</div></div>
            </div>
          ` : ""}

          ${a.type === "volunteer_member" ? `
            <h4 style="margin: 16px 0 10px; color: #0d47a1; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;">Volunteer Details</h4>
            <div class="detail-grid">
              <div class="detail-item"><div class="detail-label">Relevant Skill</div><div class="detail-val">${a.skills || a.profession || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Area of Interest</div><div class="detail-val">${a.areaOfInterest || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Available Time</div><div class="detail-val">${a.availableTime || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Previous Experience</div><div class="detail-val">${a.previousExperience || "-"}</div></div>
              ${a.previousExperienceDetails ? `<div class="detail-item"><div class="detail-label">Experience Details</div><div class="detail-val">${a.previousExperienceDetails}</div></div>` : ""}
              <div class="detail-item"><div class="detail-label">Volunteer Types</div><div class="detail-val">${Array.isArray(a.volunteerTypes) && a.volunteerTypes.length ? a.volunteerTypes.join(", ") : "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Other Type</div><div class="detail-val">${a.otherTypeDetail || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Availability</div><div class="detail-val">${a.availability || "-"}</div></div>
              <div class="detail-item"><div class="detail-label">Ground Activity</div><div class="detail-val">${a.groundActivity ? "Yes" : "No"}</div></div>
            </div>
          ` : ""}

          ${a.remarks ? `
            <div style="background: #fff1f2; border: 1px solid #fecdd3; padding: 12px; border-radius: 8px; margin-top: 14px;">
              <strong style="color: #b91c1c;">Rejection Reason / Remarks:</strong>
              <div style="color: #4c0519; margin-top: 4px;">${a.remarks}</div>
            </div>
          ` : ""}

          <div class="modal-actions">
            ${status !== "Approved" ? `
              <button style="background: #10b981;" onclick="approveApplication('${a._id}')">Approve & Generate Card</button>
            ` : ""}
            ${status === "Pending" ? `
              <button style="background: #f59e0b;" onclick="rejectApplication('${a._id}')">Reject Application</button>
            ` : ""}
            <button style="background: #ef4444;" onclick="deleteApplication('${a._id}')">Delete Application</button>
            <button style="background: #64748b;" onclick="closeModal()">Close</button>
          </div>
        `;
      } catch (err) {
        console.error(err);
        content.innerHTML = '<p style="color:red;">Error loading details.</p>';
      }
    }

    function closeModal() {
      document.getElementById("viewModal").classList.remove("open");
    }

    async function approveApplication(id) {
      if (!confirm("Approve this membership application? A unique Membership Card and ID will be generated.")) return;

      try {
        const res = await fetch(`/joinmember/${id}/approve`, {
          method: "POST",
          headers: { "Content-Type": "application/json" }
        });
        const json = await res.json();

        if (!json.success) {
          alert(json.message || "Failed to approve application.");
          return;
        }

        alert("Application approved successfully! Member ID generated: " + json.memberId);
        closeModal();
        loadApplications(currentPage);
      } catch (err) {
        console.error(err);
        alert("Something went wrong while approving.");
      }
    }

    async function rejectApplication(id) {
      const reason = prompt("Enter rejection reason (optional):", "Incomplete details or criteria not met");
      if (reason === null) return; // user cancelled

      try {
        const res = await fetch(`/joinmember/${id}/reject`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ remarks: reason })
        });
        const json = await res.json();

        if (!json.success) {
          alert(json.message || "Failed to reject application.");
          return;
        }

        alert("Application marked as Rejected.");
        closeModal();
        loadApplications(currentPage);
      } catch (err) {
        console.error(err);
        alert("Something went wrong while rejecting.");
      }
    }

    async function deleteApplication(id) {
      if (!confirm("Are you sure you want to delete this application permanently?")) return;

      try {
        const res = await fetch(`/joinmember/${id}`, { method: "DELETE" });
        const json = await res.json();

        if (!json.success) {
          alert(json.message || "Failed to delete application.");
          return;
        }

        alert("Application deleted.");
        closeModal();
        loadApplications(currentPage);
      } catch (err) {
        console.error(err);
        alert("Something went wrong while deleting.");
      }
    }

    loadAgents(1);
  </script>
</body>
</html>
