<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Party Worker · VIP</title>

  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <!-- Google Font (Inter) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <style>
    /* ---------- reset & base ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f4f8fe;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      color: #0b1e33;
    }

    /* ---------- header simulation (will be replaced by include) ---------- */
    .demo-header {
      background: #0b1e33;
      color: white;
      padding: 0.9rem 2.5rem;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      flex-shrink: 0;
    }
    .demo-header h2 {
      font-weight: 500;
      font-size: 1.2rem;
      letter-spacing: -0.2px;
    }
    .demo-header i {
      font-size: 1.5rem;
      color: #5b9aff;
    }

    /* ---------- main container ---------- */
    .worker-container {
      max-width: 1280px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
      flex: 1;
      width: 100%;
      margin-right: 78px;
    }

    /* ---------- card ---------- */
    .worker-card {
      background: #ffffff;
      border-radius: 36px;
      padding: 2.5rem 2.8rem 3rem;
      box-shadow: 0 20px 48px -12px rgba(0, 20, 40, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.5);
      transition: box-shadow 0.25s ease;
    }
    .worker-card:hover {
      box-shadow: 0 28px 56px -14px rgba(0, 30, 60, 0.18);
    }

    .worker-card h2 {
      font-size: 1.8rem;
      font-weight: 600;
      color: #0b1e33;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-bottom: 2.2rem;
      letter-spacing: -0.3px;
      border-bottom: 2px solid #eef4fa;
      padding-bottom: 1.2rem;
    }
    .worker-card h2 i {
      color: #2563eb;
      font-size: 1.9rem;
    }

    /* ---------- TWO COLUMN LAYOUT: form left, map right ---------- */
    .form-columns {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.5rem;
      align-items: start;
    }

    /* left column: normal form fields grid */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 2rem;
      align-content: start;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-group label {
      font-weight: 500;
      font-size: 0.85rem;
      color: #1e3a5f;
      letter-spacing: 0.2px;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .form-group label i {
      color: #2563eb;
      font-size: 0.8rem;
      width: 1.1rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1.5px solid #dfe8f2;
      border-radius: 16px;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      background: #fafdff;
      transition: all 0.2s ease;
      color: #0b1e33;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: #2563eb;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: #9bb0c9;
      font-weight: 400;
      font-size: 0.9rem;
    }

    .form-group select:disabled {
      background: #f1f5fa;
      color: #9bb0c9;
      cursor: not-allowed;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 80px;
      border-radius: 16px;
    }

    /* file input */
    .file-upload-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex-wrap: wrap;
    }
    .file-upload-wrapper input[type="file"] {
      padding: 0.5rem 0;
      border: none;
      background: transparent;
      font-size: 0.9rem;
      color: #1e3a5f;
    }
    .file-upload-wrapper input[type="file"]::file-selector-button {
      padding: 0.5rem 1.2rem;
      border-radius: 40px;
      border: none;
      background: #e9eff8;
      color: #1a3b6b;
      font-weight: 500;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.2s;
      margin-right: 0.8rem;
    }
    .file-upload-wrapper input[type="file"]::file-selector-button:hover {
      background: #d6e3ff;
    }

    /* ---------- RIGHT COLUMN: map + search ---------- */
    .map-column {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      position: sticky;
      top: 1.5rem;
    }

    .map-column label {
      font-weight: 500;
      font-size: 0.85rem;
      color: #1e3a5f;
      letter-spacing: 0.2px;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .map-column label i {
      color: #2563eb;
      font-size: 0.8rem;
    }

    /* custom search bar + live suggestions */
    .location-search-wrap {
      position: relative;
    }

    #locationSearch {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.6rem;
      border: 1.5px solid #dfe8f2;
      border-radius: 16px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      background: #fafdff url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%232563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>') no-repeat 0.9rem center;
      background-size: 1rem;
      color: #0b1e33;
      outline: none;
      transition: all 0.2s ease;
    }
    #locationSearch:focus {
      border-color: #2563eb;
      background-color: #ffffff;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
    }

    #searchSuggestions {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      background: #ffffff;
      border: 1.5px solid #dfe8f2;
      border-radius: 16px;
      box-shadow: 0 12px 28px -8px rgba(0, 20, 40, 0.18);
      max-height: 240px;
      overflow-y: auto;
      z-index: 1000;
      display: none;
    }
    #searchSuggestions.active {
      display: block;
    }
    #searchSuggestions .suggestion-item {
      padding: 0.7rem 1rem;
      font-size: 0.88rem;
      color: #1e3a5f;
      cursor: pointer;
      border-bottom: 1px solid #f1f5fa;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      line-height: 1.35;
    }
    #searchSuggestions .suggestion-item:last-child {
      border-bottom: none;
    }
    #searchSuggestions .suggestion-item:hover,
    #searchSuggestions .suggestion-item.highlighted {
      background: #eef4fa;
    }
    #searchSuggestions .suggestion-item i {
      color: #2563eb;
      margin-top: 0.15rem;
      flex-shrink: 0;
    }
    #searchSuggestions .suggestion-empty {
      padding: 0.9rem 1rem;
      font-size: 0.85rem;
      color: #9bb0c9;
      text-align: center;
    }

    #workerMap {
      height: 420px;
      width: 100%;
      border-radius: 20px;
      border: 1.5px solid #dfe8f2;
      z-index: 1;
    }

    .selected-coords {
      font-size: 0.8rem;
      color: #6c8299;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .selected-coords i {
      color: #2563eb;
    }

    /* ---------- save button ---------- */
    .save-btn {
      grid-column: 1 / -1;
      margin-top: 0.8rem;
      border: none;
      background: #2563eb;
      color: white;
      padding: 0.9rem 2.8rem;
      border-radius: 60px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: 0.2s ease;
      box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.30);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      width: 100%;
      font-family: 'Inter', sans-serif;
      letter-spacing: -0.2px;
    }
    .save-btn i {
      font-size: 1rem;
    }
    .save-btn:hover {
      background: #1a4fc3;
      transform: scale(0.98);
      box-shadow: 0 10px 24px -8px rgba(37, 99, 235, 0.45);
    }
    .save-btn:active {
      transform: scale(0.96);
    }

    .submit-row {
      margin-top: 2rem;
    }

    /* ---------- responsive ---------- */
    @media (max-width: 900px) {
      .form-columns {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .map-column {
        position: static;
        order: -1; /* map/search shows above form on mobile so it's easy to pick location first; remove this line if you want form first */
      }
      #workerMap {
        height: 320px;
      }
    }

    @media (max-width: 700px) {
      .worker-card {
        padding: 1.8rem 1.5rem 2.2rem;
      }
      .form-grid {
        grid-template-columns: 1fr;
        gap: 1.2rem;
      }
      .worker-card h2 {
        font-size: 1.5rem;
        gap: 0.6rem;
      }
      .worker-container {
        padding: 0 1rem;
        margin: 1.5rem auto;
      }
      .save-btn {
        padding: 0.8rem 1.5rem;
        font-size: 0.95rem;
      }
    }

    @media (max-width: 480px) {
      .worker-card {
        border-radius: 24px;
        padding: 1.2rem 1rem 1.8rem;
      }
      .worker-card h2 {
        font-size: 1.3rem;
        padding-bottom: 0.8rem;
        margin-bottom: 1.5rem;
      }
      .form-group input,
      .form-group select,
      .form-group textarea {
        padding: 0.6rem 0.9rem;
        font-size: 0.9rem;
        border-radius: 14px;
      }
      #workerMap {
        height: 260px;
      }
    }

    /* small helper */
    .mt-1 {
      margin-top: 0.4rem;
    }
  </style>
</head>
<body>

  <!-- header include (replaced by server) -->
  <%- include('../common/sidebar') %>


  <div class="worker-container">

    <div class="worker-card">

      <h2>
        <i class="fa-solid fa-users"></i>
        Add Party Worker
      </h2>

      <form action="/worker/add" method="POST" enctype="multipart/form-data">

        <div class="form-columns">

          <!-- ================= LEFT: FORM FIELDS ================= -->
          <div class="form-grid">

            <!-- Worker Name -->
            <div class="form-group full-width">
              <label><i class="fa-regular fa-user"></i> Member Name *</label>
              <input
                type="text"
                name="fullName"
                placeholder="Enter full name"
                required
              />
            </div>

            <!-- Phone -->
            <div class="form-group">
              <label><i class="fa-solid fa-phone"></i> Phone</label>
              <input
                type="tel"
                name="phone"
                placeholder="10-digit number"
                maxlength="10"
                required
              />
            </div>
            <div class="form-group ">
            <label><i class="fa-regular fa-envelope"></i> Worker Email</label>
            <input
                type="email"
                name="email"
                placeholder="Enter worker email"
                required
            />
            </div>
            <!-- State -->
            <div class="form-group">
              <label><i class="fa-solid fa-location-dot"></i> State</label>
              <select id="state" name="state" required>
                <option value="">Select State</option>
              </select>
            </div>

            <!-- District -->
            <div class="form-group">
              <label><i class="fa-regular fa-map"></i> District</label>
              <select id="district" name="district" required disabled>
                <option value="">Select District</option>
              </select>
            </div>

            <!-- Village -->
            <div class="form-group">
              <label><i class="fa-regular fa-building"></i> Village</label>
              <input
                type="text"
                name="village"
                placeholder="Village name"
                required
              />
            </div>

            <!-- Ward No -->
            <div class="form-group">
              <label><i class="fa-regular fa-hashtag"></i> Ward No.</label>
              <input
                type="text"
                name="wardNo"
                placeholder="Ward number"
                required
              />
            </div>

            <!-- Address (full width) -->
            <!-- <div class="form-group full-width">
              <label><i class="fa-regular fa-address-book"></i> Address</label>
              <textarea
                name="address"
                rows="3"
                placeholder="Full address (street, landmark, etc.)"
              ></textarea>
            </div> -->

            <!-- Photo (full width) -->
            <div class="form-group full-width">
              <label><i class="fa-regular fa-image"></i> Worker Photo</label>
              <div class="file-upload-wrapper">
                <input
                  type="file"
                  name="photo"
                  accept="image/*"
                />
                <span style="font-size: 0.8rem; color: #8aa3be;">(optional)</span>
              </div>
            </div>

          </div><!-- /form-grid (LEFT) -->

          <!-- ================= RIGHT: MAP + SEARCH ================= -->
          <div class="map-column">

            <input type="hidden" name="lat" id="lat" />
            <input type="hidden" name="lng" id="lng" />

            <label><i class="fa-solid fa-map-location-dot"></i> Select Worker Location</label>

            <div class="location-search-wrap">
              <input
                type="text"
                id="locationSearch"
                placeholder="Search Village, City, District..."
                autocomplete="off"
              />
              <div id="searchSuggestions"></div>
            </div>

            <div id="workerMap"></div>

            <div class="selected-coords">
              <i class="fa-solid fa-crosshairs"></i>
              <span id="coordsDisplay">No location selected yet — search above or click/tap on the map.</span>
            </div>

          </div><!-- /map-column (RIGHT) -->

        </div><!-- /form-columns -->

        <div class="submit-row">
          <!-- Submit -->
          <button type="submit" class="save-btn">
            <i class="fa-solid fa-floppy-disk"></i> Save Worker
          </button>
        </div>

      </form>

    </div><!-- /worker-card -->

  </div><!-- /worker-container -->

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

