<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>VIP Admin Login</title>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

height:100vh;

display:flex;

justify-content:center;

align-items:center;

background:linear-gradient(135deg,#0B4EA2,#1565c0);

}

.login-card{

width:380px;

background:#fff;

border-radius:18px;

padding:40px;

box-shadow:0 20px 60px rgba(0,0,0,.2);

}

.logo{

width:70px;

height:70px;

margin:auto;

border-radius:50%;

background:#0B4EA2;

display:flex;

justify-content:center;

align-items:center;

color:#fff;

font-size:30px;

margin-bottom:20px;

}

h2{

text-align:center;

margin-bottom:8px;

color:#0B4EA2;

}

p{

text-align:center;

color:#777;

margin-bottom:30px;

}

.input-group{

margin-bottom:18px;

}

.input-group label{

display:block;

margin-bottom:8px;

font-size:14px;

font-weight:bold;

}

.input-group input{

width:100%;

padding:13px;

border:1px solid #ddd;

border-radius:10px;

font-size:15px;

outline:none;

transition:.3s;

}

.input-group input:focus{

border-color:#0B4EA2;

box-shadow:0 0 8px rgba(11,78,162,.2);

}

button{

width:100%;

padding:14px;

background:#0B4EA2;

color:#fff;

border:none;

border-radius:10px;

font-size:16px;

cursor:pointer;

transition:.3s;

}

button:hover{

background:#083d80;

}

.footer{

margin-top:20px;

text-align:center;

font-size:13px;

color:#999;

}

</style>

</head>

<body>

<div class="login-card">

<div class="logo">

<i class="fa-solid fa-user-shield"></i>

</div>

<h2>VIP Admin Panel</h2>

<p>Sign in to continue</p>

<form action="/login" method="POST">

<div class="input-group">

<label>Email</label>

<input
type="email"
name="email"
placeholder="Enter email"
required>

</div>

<div class="input-group">

<label>Password</label>

<input
type="password"
name="password"
placeholder="Enter password"
required>

</div>

<button type="submit">

<i class="fa-solid fa-right-to-bracket"></i>

Login

</button>

</form>

<div class="footer">

© 2026 VIP Admin Dashboard

</div>

</div>

</body>

</html>