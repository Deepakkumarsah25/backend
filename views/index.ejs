<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VIP Admin Panel - Multi-Admin Login</title>

  <!-- Google Fonts & Font Awesome -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle at 10% 20%, #072a5a 0%, #0B4EA2 55%, #1565c0 100%);
      padding: 24px;
      color: #1e293b;
    }

    .login-wrapper {
      width: 100%;
      max-width: 480px;
    }

    .login-card {
      background: #ffffff;
      border-radius: 24px;
      padding: 38px 36px;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.2);
      position: relative;
      overflow: hidden;
    }

    .card-top-accent {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: linear-gradient(90deg, #f59e0b, #0B4EA2, #3b82f6);
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .logo-container {
      width: 72px;
      height: 72px;
      margin: 0 auto 16px;
      border-radius: 20px;
      background: linear-gradient(135deg, #0B4EA2 0%, #1565c0 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      font-size: 32px;
      box-shadow: 0 10px 25px rgba(11, 78, 162, 0.35);
      border: 3px solid #e0f2fe;
    }

    h2 {
      font-size: 24px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }

    h2 span {
      color: #0B4EA2;
    }

    .subtitle {
      font-size: 13.5px;
      color: #64748b;
      line-height: 1.5;
    }

    /* Error Alert */
    .error-alert {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 12px;
      padding: 12px 14px;
      color: #dc2626;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      font-weight: 500;
    }

    /* Form Fields */
    .input-group {
      margin-bottom: 18px;
    }

    .input-group label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      color: #94a3b8;
      font-size: 14px;
      pointer-events: none;
    }

    .input-wrapper input {
      width: 100%;
      padding: 13px 14px 13px 40px;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      font-size: 14px;
      color: #0f172a;
      outline: none;
      transition: all 0.25s ease;
      background: #f8fafc;
    }

    .input-wrapper input:focus {
      background: #ffffff;
      border-color: #0B4EA2;
      box-shadow: 0 0 0 4px rgba(11, 78, 162, 0.12);
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #0B4EA2 0%, #1565c0 100%);
      color: #ffffff;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      transition: all 0.25s ease;
      box-shadow: 0 8px 20px rgba(11, 78, 162, 0.3);
      margin-top: 10px;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(11, 78, 162, 0.4);
      background: linear-gradient(135deg, #083d80 0%, #0B4EA2 100%);
    }

    .card-footer {
      margin-top: 24px;
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
    }

    @media (max-width: 480px) {
      .login-card {
        padding: 28px 20px;
      }
    }
  </style>
</head>
<body>

<div class="login-wrapper">
  <div class="login-card">
    <div class="card-top-accent"></div>

    <div class="brand-header">
      <div class="logo-container">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h2>Vikassheel <span>Insaan Party</span></h2>
      <p class="subtitle">Administrative Control Panel &bull; Secure Login</p>
    </div>

    <% if (locals.error) { %>
      <div class="error-alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" id="loginForm">
      <div class="input-group">
        <label for="adminEmail">
          <span>Admin Email</span>
        </label>
        <div class="input-wrapper">
          <i class="fa-solid fa-envelope input-icon"></i>
          <input
            type="email"
            id="adminEmail"
            name="email"
            placeholder="Enter your registered email"
            required
            autocomplete="email"
          >
        </div>
      </div>

      <div class="input-group">
        <label for="adminPassword">
          <span>Password</span>
        </label>
        <div class="input-wrapper">
          <i class="fa-solid fa-lock input-icon"></i>
          <input
            type="password"
            id="adminPassword"
            name="password"
            placeholder="Enter your password"
            required
            autocomplete="current-password"
          >
        </div>
      </div>

      <button type="submit" class="btn-submit" id="loginBtn">
        <i class="fa-solid fa-right-to-bracket"></i>
        <span>Sign In to Admin Panel</span>
      </button>
    </form>

    <div class="card-footer">
      &copy; 2026 Vikassheel Insaan Party &bull; All Rights Reserved
    </div>
  </div>
</div>

</body>
</html>