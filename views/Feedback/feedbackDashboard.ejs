<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feedback — Dashboard</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
    --bg:#F5F6FA;
    --surface:#FFFFFF;
    --surface-alt:#FAFBFD;
    --border:#E7E9F2;
    --ink:#14162B;
    --ink-soft:#565973;
    --muted:#9396AC;

    --primary:#3730D9;
    --primary-dark:#2A21B8;
    --primary-soft:#EDECFC;

    --success:#0E9F6E;
    --success-soft:#E4F8F0;

    --warn:#F59E0B;
    --warn-soft:#FEF3E0;

    --tier2:#F2994A;
    --tier2-soft:#FDECDD;

    --danger:#E11D48;
    --danger-soft:#FCE7EC;

    --radius-lg:16px;
    --radius-md:12px;
    --radius-sm:8px;
    --shadow-card:0 1px 2px rgba(20,22,43,.04), 0 8px 24px rgba(20,22,43,.05);
    --shadow-hover:0 4px 10px rgba(20,22,43,.06), 0 14px 32px rgba(20,22,43,.08);
    --ease:cubic-bezier(.4,0,.2,1);
}

*{ box-sizing:border-box; margin:0; padding:0; }

body{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    background:var(--bg);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
}

.feedback-page{
    padding:32px;
    max-width:1440px;
    margin:0 auto;
}

/* ===================== HEADER ===================== */
.page-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:28px;
}

.brand{
    display:flex;
    align-items:center;
    gap:14px;
}

.brand-mark{
    width:44px;
    height:44px;
    border-radius:12px;
    background:linear-gradient(150deg,var(--primary),var(--primary-dark));
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
    box-shadow:0 6px 16px rgba(55,48,217,.28);
    flex-shrink:0;
}

.brand h1{
    font-family:'Manrope',sans-serif;
    font-weight:800;
    font-size:23px;
    letter-spacing:-.02em;
    color:var(--ink);
    line-height:1.2;
}

.brand p{
    color:var(--muted);
    font-size:13.5px;
    margin-top:2px;
}

.refresh-btn{
    border:1px solid transparent;
    background:var(--primary);
    color:#fff;
    padding:11px 20px;
    border-radius:10px;
    cursor:pointer;
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:14px;
    display:inline-flex;
    align-items:center;
    gap:8px;
    transition:background .15s var(--ease), transform .15s var(--ease), box-shadow .15s var(--ease);
    box-shadow:0 2px 8px rgba(55,48,217,.25);
    flex-shrink:0;
    white-space:nowrap;
}
.refresh-btn:hover{ background:var(--primary-dark); box-shadow:0 4px 14px rgba(55,48,217,.35); }
.refresh-btn:active{ transform:translateY(1px); }
.refresh-btn i{ transition:transform .4s var(--ease); }
.refresh-btn:hover i{ transform:rotate(180deg); }

/* ===================== STATS ===================== */
.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
    margin-bottom:20px;
}

.stat-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:20px;
    display:flex;
    align-items:flex-start;
    gap:14px;
    box-shadow:var(--shadow-card);
    transition:box-shadow .2s var(--ease), transform .2s var(--ease);
}
.stat-card:hover{ box-shadow:var(--shadow-hover); transform:translateY(-1px); }

.stat-icon{
    width:42px;
    height:42px;
    border-radius:11px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:17px;
    flex-shrink:0;
}
.stat-icon.primary{ background:var(--primary-soft); color:var(--primary); }
.stat-icon.warn{ background:var(--warn-soft); color:var(--warn); }
.stat-icon.success{ background:var(--success-soft); color:var(--success); }
.stat-icon.danger{ background:var(--danger-soft); color:var(--danger); }

.stat-card span{
    display:block;
    font-size:12.5px;
    font-weight:600;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:.03em;
    margin-bottom:6px;
}

.stat-card strong{
    font-family:'Manrope',sans-serif;
    font-size:26px;
    font-weight:800;
    color:var(--ink);
    letter-spacing:-.02em;
}
.stat-card strong small{
    font-family:'Inter',sans-serif;
    font-size:14px;
    font-weight:500;
    color:var(--muted);
    margin-left:2px;
}
.stat-caption{
    display:block;
    margin-top:4px;
    font-size:12px;
    color:var(--muted);
    font-weight:500;
}

/* ===================== RATING DISTRIBUTION ===================== */
.rating-section{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:22px 24px;
    margin-bottom:20px;
    box-shadow:var(--shadow-card);
}

.section-title{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom:18px;
}
.section-title h2{
    font-family:'Manrope',sans-serif;
    font-size:16px;
    font-weight:700;
    color:var(--ink);
}
.section-title p{
    font-size:12.5px;
    color:var(--muted);
}

.rating-row{
    display:grid;
    grid-template-columns:50px 1fr 34px;
    align-items:center;
    gap:12px;
    margin-bottom:12px;
}
.rating-row:last-child{ margin-bottom:0; }

.rating-row .rlabel{
    font-weight:700;
    font-size:13px;
    color:var(--ink-soft);
    display:flex;
    align-items:center;
    gap:3px;
}
.rating-row .rlabel i{ font-size:11px; color:var(--warn); }

.rating-row strong{
    text-align:right;
    font-size:13px;
    color:var(--ink);
    font-variant-numeric:tabular-nums;
}

.progress{
    height:8px;
    background:var(--surface-alt);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
}
.progress-fill{
    height:100%;
    width:0%;
    border-radius:20px;
    transition:width .6s var(--ease);
}
.fill-5{ background:var(--success); }
.fill-4{ background:var(--primary); }
.fill-3{ background:var(--warn); }
.fill-2{ background:var(--tier2); }
.fill-1{ background:var(--danger); }

/* ===================== TABLE CARD ===================== */
.table-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    overflow:hidden;
    box-shadow:var(--shadow-card);
}

.table-header{
    padding:20px 24px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    border-bottom:1px solid var(--border);
    flex-wrap:wrap;
}
.table-header h2{
    font-family:'Manrope',sans-serif;
    font-size:16.5px;
    font-weight:700;
    color:var(--ink);
}
.table-header p{
    color:var(--muted);
    margin-top:3px;
    font-size:12.5px;
}

.search-wrap{
    position:relative;
    width:300px;
    max-width:100%;
}
.search-wrap i{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    color:var(--muted);
    font-size:13px;
}
#searchInput{
    width:100%;
    border:1px solid var(--border);
    background:var(--surface-alt);
    border-radius:10px;
    padding:10px 13px 10px 36px;
    outline:none;
    font-size:13.5px;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    transition:border-color .15s var(--ease), background .15s var(--ease);
}
#searchInput::placeholder{ color:var(--muted); }
#searchInput:focus{ border-color:var(--primary); background:var(--surface); box-shadow:0 0 0 3px var(--primary-soft); }

.table-wrapper{ overflow-x:auto; }

table{ width:100%; border-collapse:collapse; min-width:820px; }

thead{ background:var(--surface-alt); }
th{
    text-align:left;
    padding:13px 24px;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.05em;
    color:var(--muted);
    white-space:nowrap;
    border-bottom:1px solid var(--border);
}

td{
    padding:16px 24px;
    border-top:1px solid var(--border);
    font-size:13.5px;
    vertical-align:middle;
    color:var(--ink-soft);
}

tbody tr{ transition:background .12s var(--ease); }
tbody tr:hover{ background:var(--surface-alt); }

.idx-cell{ color:var(--muted); font-weight:600; font-variant-numeric:tabular-nums; }

.user-cell{ display:flex; align-items:center; gap:12px; }

.user-avatar{
    width:38px;
    height:38px;
    border-radius:10px;
    color:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:700;
    font-size:14px;
    flex-shrink:0;
    font-family:'Manrope',sans-serif;
}

.user-name{ font-weight:600; color:var(--ink); font-size:13.5px; line-height:1.35; }
.email{ color:var(--muted); font-size:12px; }

.rating-pill{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:5px 10px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:700;
    white-space:nowrap;
}
.rating-pill i{ font-size:10px; }
.rp-5{ background:var(--success-soft); color:var(--success); }
.rp-4{ background:var(--primary-soft); color:var(--primary); }
.rp-3{ background:var(--warn-soft); color:#B4740A; }
.rp-2{ background:var(--tier2-soft); color:#C06A22; }
.rp-1{ background:var(--danger-soft); color:var(--danger); }

.feedback-text{
    max-width:320px;
    line-height:1.5;
    color:var(--ink-soft);
    font-size:13.5px;
}

.date-text{ color:var(--muted); white-space:nowrap; font-size:13px; }

.action-buttons{ display:flex; gap:6px; }

.view-btn, .delete-btn{
    width:32px; height:32px;
    border:1px solid var(--border);
    border-radius:8px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    background:var(--surface);
    transition:background .15s var(--ease), border-color .15s var(--ease), color .15s var(--ease);
}
.view-btn{ color:var(--primary); }
.view-btn:hover{ background:var(--primary-soft); border-color:var(--primary); }
.delete-btn{ color:var(--danger); }
.delete-btn:hover{ background:var(--danger-soft); border-color:var(--danger); }

/* ===================== LOADING / EMPTY ===================== */
.loading, .no-data{
    text-align:center;
    padding:56px 20px;
    color:var(--muted);
    font-size:13.5px;
}
.spinner{
    width:26px; height:26px;
    border:3px solid var(--border);
    border-top-color:var(--primary);
    border-radius:50%;
    margin:0 auto 12px;
    animation:spin .7s linear infinite;
}
@keyframes spin{ to{ transform:rotate(360deg); } }

.empty-icon{
    width:52px; height:52px;
    border-radius:14px;
    background:var(--surface-alt);
    border:1px solid var(--border);
    color:var(--muted);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
    margin:0 auto 14px;
}
.no-data strong{ display:block; color:var(--ink-soft); font-size:14px; margin-bottom:3px; font-weight:600; }

/* ===================== MODAL ===================== */
.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(15,17,38,.5);
    backdrop-filter:blur(2px);
    z-index:9999;
    justify-content:center;
    align-items:center;
    padding:20px;
}
.modal.show{ display:flex; }

.modal-content{
    width:100%;
    max-width:520px;
    background:var(--surface);
    border-radius:18px;
    padding:26px;
    position:relative;
    box-shadow:0 24px 64px rgba(15,17,38,.28);
    animation:modalIn .18s var(--ease);
}
@keyframes modalIn{ from{ opacity:0; transform:translateY(6px) scale(.98);} to{ opacity:1; transform:none; } }

.close-btn{
    position:absolute;
    right:16px; top:16px;
    width:32px; height:32px;
    border:none;
    background:var(--surface-alt);
    border-radius:8px;
    font-size:16px;
    color:var(--muted);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:background .15s var(--ease), color .15s var(--ease);
}
.close-btn:hover{ background:var(--danger-soft); color:var(--danger); }

.modal-user{
    display:flex;
    align-items:center;
    gap:14px;
    padding-bottom:18px;
    border-bottom:1px solid var(--border);
    padding-right:30px;
}

.avatar{
    width:52px; height:52px;
    border-radius:14px;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:19px;
    font-weight:700;
    font-family:'Manrope',sans-serif;
    flex-shrink:0;
}

.modal-user h2{ font-family:'Manrope',sans-serif; font-size:17px; font-weight:700; color:var(--ink); }
.modal-user p{ margin-top:3px; color:var(--muted); font-size:13px; }

.modal-rating{
    padding:16px 0;
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.modal-rating span{ color:var(--muted); font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.03em; }

.modal-message{
    background:var(--surface-alt);
    border:1px solid var(--border);
    padding:16px;
    border-radius:12px;
}
.modal-message h3{ font-size:12.5px; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.04em; font-weight:700; }
.modal-message p{ line-height:1.6; color:var(--ink-soft); white-space:pre-wrap; font-size:13.5px; }

.modal-date{
    margin-top:16px;
    color:var(--muted);
    font-size:12.5px;
    display:flex;
    gap:7px;
    align-items:center;
}

/* ===================== RESPONSIVE ===================== */
@media (max-width:1100px){
    .stats-grid{ grid-template-columns:repeat(2,1fr); }
}

@media (max-width:720px){
    .feedback-page{ padding:16px; }

    .page-header{ flex-wrap:wrap; }
    .brand h1{ font-size:19px; }

    .stats-grid{ grid-template-columns:1fr 1fr; gap:10px; }
    .stat-card{ padding:14px; flex-direction:column; }
    .stat-icon{ width:36px; height:36px; }
    .stat-card strong{ font-size:21px; }

    .rating-section{ padding:18px; }

    .table-header{ flex-direction:column; align-items:stretch; }
    .search-wrap{ width:100%; }

    /* card-style table */
    table{ min-width:0; }
    thead{ display:none; }
    tbody, tr, td{ display:block; width:100%; }
    tbody{ padding:10px; }
    tr{
        background:var(--surface);
        border:1px solid var(--border);
        border-radius:14px;
        margin-bottom:12px;
        padding:6px 4px;
        box-shadow:var(--shadow-card);
    }
    tr:hover{ background:var(--surface); }
    td{
        border-top:none;
        padding:10px 14px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
    }
    td.idx-cell{ display:none; }
    td[data-label]::before{
        content:attr(data-label);
        font-size:11px;
        font-weight:700;
        color:var(--muted);
        text-transform:uppercase;
        letter-spacing:.04em;
        flex-shrink:0;
    }
    td.user-td{ padding-bottom:6px; }
    td.user-td::before{ display:none; }
    td.user-td .user-cell{ width:100%; }
    td.feedback-td{ flex-direction:column; align-items:flex-start; }
    td.feedback-td::before{ margin-bottom:4px; }
    .feedback-text{ max-width:100%; }
    td.actions-td{ border-top:1px solid var(--border); margin-top:4px; padding-top:12px; }
    td.actions-td::before{ display:none; }
    .action-buttons{ width:100%; justify-content:flex-end; }
}

@media (max-width:420px){
    .stats-grid{ grid-template-columns:1fr; }
}

/* focus visibility for accessibility */
button:focus-visible, input:focus-visible{
    outline:2px solid var(--primary);
    outline-offset:2px;
}

@media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
}
</style>
</head>

<body>
<div class="feedback-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="brand">
            <div class="brand-mark"><i class="fa-solid fa-comments"></i></div>
            <div>
                <h1>Feedback</h1>
                <p>Manage user feedback, ratings and suggestions</p>
            </div>
        </div>

        <button class="refresh-btn" onclick="loadDashboard()">
            <i class="fa-solid fa-rotate"></i>
            Refresh
        </button>
    </div>

    <!-- STATS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon primary"><i class="fa-solid fa-comment-dots"></i></div>
            <div>
                <span>Total Feedback</span>
                <strong id="totalFeedback">0</strong>
                <span class="stat-caption">All time submissions</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warn"><i class="fa-solid fa-star"></i></div>
            <div>
                <span>Average Rating</span>
                <strong><span id="averageRating">0</span><small>/ 5</small></strong>
                <span class="stat-caption">Across all reviews</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success"><i class="fa-solid fa-face-smile"></i></div>
            <div>
                <span>5 Star</span>
                <strong id="fiveStar">0</strong>
                <span class="stat-caption">Most satisfied users</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon danger"><i class="fa-solid fa-face-frown"></i></div>
            <div>
                <span>1 Star</span>
                <strong id="oneStar">0</strong>
                <span class="stat-caption">Needs attention</span>
            </div>
        </div>

    </div>

    <!-- RATING DISTRIBUTION -->
    <div class="rating-section">
        <div class="section-title">
            <h2>Rating Distribution</h2>
            <p>Share of feedback per rating</p>
        </div>

        <div class="rating-row">
            <span class="rlabel">5 <i class="fa-solid fa-star"></i></span>
            <div class="progress"><div id="bar5" class="progress-fill fill-5"></div></div>
            <strong id="count5">0</strong>
        </div>
        <div class="rating-row">
            <span class="rlabel">4 <i class="fa-solid fa-star"></i></span>
            <div class="progress"><div id="bar4" class="progress-fill fill-4"></div></div>
            <strong id="count4">0</strong>
        </div>
        <div class="rating-row">
            <span class="rlabel">3 <i class="fa-solid fa-star"></i></span>
            <div class="progress"><div id="bar3" class="progress-fill fill-3"></div></div>
            <strong id="count3">0</strong>
        </div>
        <div class="rating-row">
            <span class="rlabel">2 <i class="fa-solid fa-star"></i></span>
            <div class="progress"><div id="bar2" class="progress-fill fill-2"></div></div>
            <strong id="count2">0</strong>
        </div>
        <div class="rating-row">
            <span class="rlabel">1 <i class="fa-solid fa-star"></i></span>
            <div class="progress"><div id="bar1" class="progress-fill fill-1"></div></div>
            <strong id="count1">0</strong>
        </div>
    </div>

    <!-- TABLE -->
    <div class="table-card">
        <div class="table-header">
            <div>
                <h2>All Feedback</h2>
                <p>Complete feedback submitted by users</p>
            </div>

            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Search user, email or feedback…" oninput="filterFeedback()">
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Rating</th>
                        <th>Feedback</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="feedbackTable">
                    <tr><td colspan="6" class="loading"><div class="spinner"></div>Loading feedback…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL -->
<div id="feedbackModal" class="modal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button>

        <div class="modal-user">
            <div class="avatar" id="modalAvatar">U</div>
            <div>
                <h2 id="modalName">User</h2>
                <p id="modalEmail">email</p>
            </div>
        </div>

        <div class="modal-rating">
            <span>Rating</span>
            <span id="modalRating" class="rating-pill">★★★★★</span>
        </div>

        <div class="modal-message">
            <h3>Feedback</h3>
            <p id="modalMessage">Feedback message</p>
        </div>

        <div class="modal-date">
            <i class="fa-regular fa-calendar"></i>
            <span id="modalDate">Date</span>
        </div>
    </div>
</div>

<script>
let allFeedbacks = [];

/* palette used for identity avatars — deterministic by name */
const AVATAR_PALETTE = [
    'linear-gradient(150deg,#3730D9,#2A21B8)',
    'linear-gradient(150deg,#0E9F6E,#0B7F58)',
    'linear-gradient(150deg,#F2994A,#D97E33)',
    'linear-gradient(150deg,#E11D48,#B91439)',
    'linear-gradient(150deg,#0EA5C4,#0B84A0)',
    'linear-gradient(150deg,#7C3AED,#6425C4)'
];

function avatarStyle(name){
    const str = (name || 'U');
    let hash = 0;
    for (let i = 0; i < str.length; i++){ hash = str.charCodeAt(i) + ((hash << 5) - hash); }
    const idx = Math.abs(hash) % AVATAR_PALETTE.length;
    return AVATAR_PALETTE[idx];
}

function ratingTier(rating){
    const r = Number(rating);
    return r >= 5 ? 5 : r <= 1 ? 1 : r;
}

/* ===================== LOAD DASHBOARD ===================== */
async function loadDashboard(){
    try{
        await Promise.all([loadStats(), loadFeedbacks()]);
    }catch(error){
        console.error("Dashboard Load Error:", error);
    }
}

/* ===================== LOAD STATISTICS ===================== */
async function loadStats(){
    try{
        const response = await fetch("/api/feedback/stats");
        const data = await response.json();

        if (!data.success){
            throw new Error(data.message || "Failed to load statistics");
        }

        const stats = data.stats;

        document.getElementById("totalFeedback").textContent = stats.totalFeedback;
        document.getElementById("averageRating").textContent = stats.averageRating;
        document.getElementById("fiveStar").textContent = stats.fiveStar;
        document.getElementById("oneStar").textContent = stats.oneStar;

        setRating(5, stats.fiveStar, stats.totalFeedback);
        setRating(4, stats.fourStar, stats.totalFeedback);
        setRating(3, stats.threeStar, stats.totalFeedback);
        setRating(2, stats.twoStar, stats.totalFeedback);
        setRating(1, stats.oneStar, stats.totalFeedback);

    }catch(error){
        console.error("Stats Error:", error);
    }
}

/* ===================== RATING BAR ===================== */
function setRating(rating, count, total){
    const countElement = document.getElementById(`count${rating}`);
    const barElement = document.getElementById(`bar${rating}`);

    if (countElement) countElement.textContent = count;

    let percentage = 0;
    if (total > 0) percentage = (count / total) * 100;

    if (barElement) barElement.style.width = `${percentage}%`;
}

/* ===================== LOAD ALL FEEDBACK ===================== */
async function loadFeedbacks(){
    const table = document.getElementById("feedbackTable");
    table.innerHTML = `<tr><td colspan="6" class="loading"><div class="spinner"></div>Loading feedback…</td></tr>`;

    try{
        const response = await fetch("/api/feedback");
        const data = await response.json();

        if (!data.success){
            throw new Error(data.message || "Failed to load feedback");
        }

        allFeedbacks = data.feedbacks || [];
        renderFeedbacks(allFeedbacks);

    }catch(error){
        console.error("Feedback Load Error:", error);
        table.innerHTML = `
            <tr><td colspan="6" class="no-data">
                <div class="empty-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <strong>Couldn't load feedback</strong>
                Check your connection and try refreshing.
            </td></tr>`;
    }
}

/* ===================== RENDER FEEDBACK ===================== */
function renderFeedbacks(feedbacks){
    const table = document.getElementById("feedbackTable");

    if (!feedbacks.length){
        table.innerHTML = `
            <tr><td colspan="6" class="no-data">
                <div class="empty-icon"><i class="fa-regular fa-comment-dots"></i></div>
                <strong>No feedback yet</strong>
                Submissions will show up here as users leave them.
            </td></tr>`;
        return;
    }

    table.innerHTML = feedbacks.map((item, index) => {

        const name = escapeHtml(item.name || "Unknown User");
        const email = escapeHtml(item.email || "-");
        const message = escapeHtml(item.message || "");
        const firstLetter = (item.name || "U").charAt(0).toUpperCase();
        const rating = Number(item.rating) || 0;
        const tier = ratingTier(rating);
        const date = formatDate(item.createdAt);
        const grad = avatarStyle(item.name);

        return `
            <tr>
                <td class="idx-cell">${index + 1}</td>

                <td class="user-td" data-label="User">
                    <div class="user-cell">
                        <div class="user-avatar" style="background:${grad}">${firstLetter}</div>
                        <div>
                            <div class="user-name">${name}</div>
                            <div class="email">${email}</div>
                        </div>
                    </div>
                </td>

                <td data-label="Rating">
                    <span class="rating-pill rp-${tier}"><i class="fa-solid fa-star"></i>${rating}.0</span>
                </td>

                <td class="feedback-td" data-label="Feedback">
                    <div class="feedback-text" title="${message}">${truncateText(message, 100)}</div>
                </td>

                <td data-label="Date">
                    <span class="date-text">${date}</span>
                </td>

                <td class="actions-td" data-label="Action">
                    <div class="action-buttons">
                        <button class="view-btn" title="View" onclick="viewFeedback('${item._id}')">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="delete-btn" title="Delete" onclick="deleteFeedback('${item._id}')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join("");
}

/* ===================== SEARCH ===================== */
function filterFeedback(){
    const search = document.getElementById("searchInput").value.toLowerCase().trim();

    if (!search){
        renderFeedbacks(allFeedbacks);
        return;
    }

    const filtered = allFeedbacks.filter((item) => {
        return (
            item.name?.toLowerCase().includes(search) ||
            item.email?.toLowerCase().includes(search) ||
            item.message?.toLowerCase().includes(search)
        );
    });

    renderFeedbacks(filtered);
}

/* ===================== VIEW FEEDBACK ===================== */
function viewFeedback(id){
    const feedback = allFeedbacks.find((item) => item._id === id);
    if (!feedback) return;

    const name = feedback.name || "Unknown User";
    const rating = Number(feedback.rating) || 0;
    const tier = ratingTier(rating);

    document.getElementById("modalAvatar").textContent = name.charAt(0).toUpperCase();
    document.getElementById("modalAvatar").style.background = avatarStyle(feedback.name);
    document.getElementById("modalName").textContent = name;
    document.getElementById("modalEmail").textContent = feedback.email || "-";

    const modalRating = document.getElementById("modalRating");
    modalRating.className = `rating-pill rp-${tier}`;
    modalRating.innerHTML = `<i class="fa-solid fa-star"></i> ${rating}.0 / 5`;

    document.getElementById("modalMessage").textContent = feedback.message || "-";
    document.getElementById("modalDate").textContent = formatDate(feedback.createdAt);

    document.getElementById("feedbackModal").classList.add("show");
}

/* ===================== CLOSE MODAL ===================== */
function closeModal(){
    document.getElementById("feedbackModal").classList.remove("show");
}

document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
});

/* ===================== DELETE ===================== */
async function deleteFeedback(id){
    const confirmed = confirm("Are you sure you want to delete this feedback?");
    if (!confirmed) return;

    try{
        const response = await fetch(`/api/feedback/${id}`, { method: "DELETE" });
        const data = await response.json();

        if (!data.success){
            alert(data.message || "Failed to delete feedback.");
            return;
        }

        alert("Feedback deleted successfully.");
        await loadDashboard();

    }catch(error){
        console.error("Delete Error:", error);
        alert("Unable to delete feedback.");
    }
}

/* ===================== DATE FORMAT ===================== */
function formatDate(date){
    if (!date) return "-";
    const d = new Date(date);
    return d.toLocaleString("en-IN", {
        day: "2-digit", month: "2-digit", year: "numeric",
        hour: "2-digit", minute: "2-digit"
    });
}

/* ===================== TRUNCATE TEXT ===================== */
function truncateText(text, length){
    if (!text) return "";
    if (text.length <= length) return text;
    return text.substring(0, length) + "…";
}

/* ===================== HTML ESCAPE ===================== */
function escapeHtml(text){
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
}

/* ===================== CLOSE MODAL OUTSIDE CLICK ===================== */
window.addEventListener("click", (event) => {
    const modal = document.getElementById("feedbackModal");
    if (event.target === modal) closeModal();
});

/* ===================== START ===================== */
document.addEventListener("DOMContentLoaded", () => {
    loadDashboard();
});
</script>

</body>
</html>