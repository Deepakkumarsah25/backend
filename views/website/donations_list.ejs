<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>प्राप्त सहयोग एवं दान सूची (Donations Hub) - VIP Admin</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <!-- Admin Styles -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    
    <style>
        :root {
            --primary: #0b4ea2;
            --primary-dark: #073570;
            --accent: #f59e0b;
            --success: #10b981;
            --danger: #ef4444;
            --card-border: #e2e8f0;
            --bg-gray: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: var(--bg-gray);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .main-content {
            margin-top: 72px;
            min-height: calc(100vh - 72px);
            padding: 24px clamp(14px, 2vw, 30px);
            background: #f3f6fb;
            box-sizing: border-box;
        }

        .donations-container {
            width: 100%;
            max-width: 1500px;
            margin: 0 auto;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-top: 68px;
                padding: 16px 14px 40px;
            }
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-box h1 {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            color: var(--text-muted);
            font-size: 14px;
            margin-top: 4px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px rgba(11, 78, 162, 0.25);
        }

        .btn-outline {
            background: #fff;
            color: var(--text-dark);
            border: 1px solid var(--card-border);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 18px 20px;
            border: 1px solid var(--card-border);
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .stat-info .stat-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .stat-info .stat-value {
            font-size: 24px;
            font-weight: 900;
            color: var(--text-dark);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        /* Toolbar Panel */
        .toolbar-panel {
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--card-border);
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .search-input-group {
            position: relative;
            flex: 1;
            min-width: 260px;
        }

        .search-input-group i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-input-group input {
            width: 100%;
            padding: 10px 14px 10px 42px;
            border-radius: 10px;
            border: 1px solid var(--card-border);
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .select-filter {
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid var(--card-border);
            font-size: 13.5px;
            font-weight: 600;
            background: #fff;
            cursor: pointer;
            outline: none;
        }

        /* Table Card */
        .table-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 14px rgba(0,0,0,0.02);
            overflow: hidden;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .donations-table {
            min-width: 1150px;
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13.5px;
        }

        .donations-table th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 700;
            padding: 14px 18px;
            text-transform: uppercase;
            font-size: 11.5px;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--card-border);
            white-space: nowrap;
        }

        .donations-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .donations-table tbody tr:hover {
            background-color: #f8fafc;
        }

        .receipt-pill {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-weight: 700;
            font-size: 12px;
            background: #f1f5f9;
            color: var(--primary);
            padding: 4px 9px;
            border-radius: 7px;
            border: 1px solid #cbd5e1;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap !important;
            word-break: keep-all !important;
        }

        .amount-badge {
            font-size: 15px;
            font-weight: 900;
            color: #065f46;
            background: #d1fae5;
            padding: 4px 10px;
            border-radius: 8px;
            display: inline-block;
        }

        .status-select {
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            outline: none;
        }

        .status-Pending-Verification { background: #fef3c7; color: #92400e; border-color: #fde68a; }
        .status-Verified { background: #d1fae5; color: #065f46; border-color: #a7f3d0; }
        .status-Receipt-Issued { background: #e0e7ff; color: #3730a3; border-color: #c7d2fe; }
        .status-Rejected { background: #fee2e2; color: #991b1b; border-color: #fecaca; }

        .btn-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--card-border);
            background: #fff;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s;
            font-size: 13px;
        }

        .btn-icon.btn-delete:hover {
            background: #fee2e2;
            color: var(--danger);
            border-color: var(--danger);
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <!-- Header -->
    <%- include('../common/header.ejs') %>

    <!-- Sidebar -->
    <%- include('../common/sidebar.ejs') %>

    <!-- Main Content -->
    <main class="main-content">
        <div class="donations-container">
            
            <!-- Page Header -->
            <div class="page-header">
                <div class="header-title-box">
                    <h1>
                        <i class="fa-solid fa-receipt" style="color: #10b981;"></i>
                        प्राप्त सहयोग एवं दान सूची (Received Donations)
                    </h1>
                    <p>वेबसाइट से दानदाताओं द्वारा दर्ज की गई रसीद व सहयोग प्रविष्टियों की सूची</p>
                </div>

                <div class="header-actions">
                    <a href="/admin/website/support-settings" class="btn-action btn-outline">
                        <i class="fa-solid fa-gear"></i>
                        <span>बैंक खाता सेटिंग्स (Settings)</span>
                    </a>
                    <a href="/admin/website/donations/export" class="btn-action btn-outline">
                        <i class="fa-solid fa-file-excel" style="color: #10b981;"></i>
                        <span>Export CSV</span>
                    </a>
                    <button type="button" onclick="window.location.reload();" class="btn-action btn-primary">
                        <i class="fa-solid fa-rotate"></i>
                        <span>रिफ्रेश</span>
                    </button>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <div class="stat-label">कुल प्रविष्टियां (Total)</div>
                        <div class="stat-value"><%= counts.total %></div>
                    </div>
                    <div class="stat-icon" style="background: #e0e7ff; color: #4338ca;">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <div class="stat-label">लंबित सत्यापन (Pending)</div>
                        <div class="stat-value" style="color: #d97706;"><%= counts.pending %></div>
                    </div>
                    <div class="stat-icon" style="background: #fef3c7; color: #b45309;">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <div class="stat-label">सत्यापित (Verified)</div>
                        <div class="stat-value" style="color: #059669;"><%= counts.verified %></div>
                    </div>
                    <div class="stat-icon" style="background: #d1fae5; color: #047857;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <div class="stat-label">रसीद जारी (Receipts)</div>
                        <div class="stat-value" style="color: #4f46e5;"><%= counts.receiptIssued %></div>
                    </div>
                    <div class="stat-icon" style="background: #ede9fe; color: #6d28d9;">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
            </div>

            <!-- Toolbar: Search & Filter -->
            <div class="toolbar-panel">
                <form method="GET" action="/admin/website/donations" style="display: flex; gap: 12px; width: 100%; flex-wrap: wrap;">
                    <div class="search-input-group">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="q" value="<%= searchQuery %>" placeholder="दाता का नाम, मोबाइल, UTR नंबर या रसीद से खोजें...">
                    </div>

                    <div style="display: flex; gap: 10px; align-items: center;">
                        <select name="status" class="select-filter" onchange="this.form.submit()">
                            <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>सभी स्थिति (All Status)</option>
                            <option value="Pending Verification" <%= selectedStatus === 'Pending Verification' ? 'selected' : '' %>>सत्यापन लंबित</option>
                            <option value="Verified" <%= selectedStatus === 'Verified' ? 'selected' : '' %>>सत्यापित (Verified)</option>
                            <option value="Receipt Issued" <%= selectedStatus === 'Receipt Issued' ? 'selected' : '' %>>रसीद जारी</option>
                            <option value="Rejected" <%= selectedStatus === 'Rejected' ? 'selected' : '' %>>अस्वीकृत (Rejected)</option>
                        </select>

                        <button type="submit" class="btn-action btn-primary">फ़िल्टर</button>
                        <% if (searchQuery || selectedStatus !== 'all') { %>
                            <a href="/admin/website/donations" class="btn-action btn-outline">क्लियर</a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Donations Table Card -->
            <div class="table-card">
                <div class="table-responsive">
                    <table class="donations-table">
                        <thead>
                            <tr>
                                <th># रसीद ID</th>
                                <th>दानदाता (Donor Details)</th>
                                <th>सहयोग राशि (Amount)</th>
                                <th>UTR / ट्रांजेक्शन ID</th>
                                <th>भुगतान माध्यम</th>
                                <th>तारीख</th>
                                <th>सत्यापन स्थिति</th>
                                <th style="text-align: right;">कार्रवाई</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (records && records.length > 0) { %>
                                <% records.forEach((r) => { %>
                                    <tr id="don-row-<%= r._id %>">
                                        <td>
                                            <span class="receipt-pill">
                                                <i class="fa-solid fa-ticket"></i>
                                                <%= r.receiptNumber || 'RCP-' + r._id.toString().slice(-6).toUpperCase() %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-dark);"><%= r.donorName %></div>
                                            <div style="font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                                                <a href="tel:<%= r.donorPhone %>" style="color: inherit; text-decoration: none;">
                                                    <i class="fa-solid fa-phone text-xs" style="color: var(--primary);"></i>
                                                    <%= r.donorPhone %>
                                                </a>
                                                <% if (r.panNumber) { %>
                                                    <span>&bull; PAN: <strong><%= r.panNumber %></strong></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="amount-badge">
                                                ₹<%= Number(r.amount).toLocaleString('en-IN') %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="font-family: monospace; font-weight: 700; color: #334155;">
                                                <%= r.utrNumber || 'N/A' %>
                                            </div>
                                        </td>
                                        <td>
                                            <span style="font-size: 12px; font-weight: 700; background: #f1f5f9; padding: 3px 8px; border-radius: 6px;">
                                                <%= r.paymentMode || 'UPI' %>
                                            </span>
                                        </td>
                                        <td style="white-space: nowrap;">
                                            <div style="font-weight: 600; white-space: nowrap; color: var(--text-dark);">
                                                <%= r.createdAt ? new Date(r.createdAt).toLocaleDateString('hi-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                                            </div>
                                            <div style="font-size: 11px; color: var(--text-muted); white-space: nowrap; margin-top: 2px;">
                                                <%= r.createdAt ? new Date(r.createdAt).toLocaleTimeString('hi-IN', { hour: '2-digit', minute: '2-digit' }) : '' %>
                                            </div>
                                        </td>
                                        <td>
                                            <select 
                                                class="status-select status-<%= (r.status || 'Pending Verification').replace(/\s+/g, '-') %>"
                                                onchange="changeDonationStatus('<%= r._id %>', this.value, this)"
                                            >
                                                <option value="Pending Verification" <%= r.status === 'Pending Verification' ? 'selected' : '' %>>सत्यापन लंबित</option>
                                                <option value="Verified" <%= r.status === 'Verified' ? 'selected' : '' %>>Verified (सत्यापित)</option>
                                                <option value="Receipt Issued" <%= r.status === 'Receipt Issued' ? 'selected' : '' %>>रसीद जारी</option>
                                                <option value="Rejected" <%= r.status === 'Rejected' ? 'selected' : '' %>>Rejected (अस्वीकृत)</option>
                                            </select>
                                        </td>
                                        <td style="text-align: right;">
                                            <button 
                                                type="button" 
                                                class="btn-icon btn-delete" 
                                                style="margin-left: auto;"
                                                onclick="deleteDonation('<%= r._id %>', '<%= r.donorName %>')"
                                                title="डिलीट करें"
                                            >
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="fa-solid fa-receipt" style="font-size: 40px; color: #cbd5e1; margin-bottom: 12px;"></i>
                                            <h3 style="font-size: 16px; font-weight: 700; color: #334155;">कोई दान प्रविष्टि नहीं मिली</h3>
                                            <p style="font-size: 13px;">वेबसाइट से दानदाताओं द्वारा सूचना दर्ज करने पर यहाँ रिकॉर्ड प्रदर्शित होंगे।</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <script>
        async function changeDonationStatus(id, newStatus, selectEl) {
            try {
                const res = await fetch('/admin/website/donations/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, newStatus })
                });
                const data = await res.json();
                if (data.success) {
                    selectEl.className = 'status-select status-' + newStatus.replace(/\s+/g, '-');
                } else {
                    alert('त्रुटि: ' + data.message);
                }
            } catch(e) {
                alert('त्रुटि: ' + e.message);
            }
        }

        async function deleteDonation(id, name) {
            if (!confirm(`क्या आप ${name || 'इस रिकॉर्ड'} को डिलीट करना चाहते हैं?`)) return;
            try {
                const res = await fetch('/admin/website/donations/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const data = await res.json();
                if (data.success) {
                    const row = document.getElementById('don-row-' + id);
                    if (row) row.remove();
                } else {
                    alert('त्रुटि: ' + data.message);
                }
            } catch(e) {
                alert('त्रुटि: ' + e.message);
            }
        }
    </script>
</body>
</html>
