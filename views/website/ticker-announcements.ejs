<!DOCTYPE html><html lang="hi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Upcoming Events Ticker · VIP Admin</title><link rel="stylesheet" href="/css/header.css"><link rel="stylesheet" href="/css/sidebar.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><style>
*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#14243a;font-family:Inter,Arial,sans-serif}.wrap{margin:92px 24px 30px 300px;padding:12px;max-width:1300px}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:22px}.top h1{margin:0;font-size:27px}.top p{color:#64748b;margin:7px 0}.btn{display:inline-flex;align-items:center;gap:8px;background:#0967b2;color:#fff;padding:11px 15px;border-radius:10px;text-decoration:none;border:0;font-weight:700;cursor:pointer}.msg{padding:12px 15px;background:#e9f8ef;color:#167343;border-radius:10px;margin:12px 0}.msg.err{background:#fff0ef;color:#a93226}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px}.card{background:white;border:1px solid #e2eaf3;border-radius:16px;padding:20px;box-shadow:0 8px 24px #143a5b0b}.card h2{font-size:19px;margin:0 0 10px}.ticker{background:#062f52;color:#fff;padding:11px 13px;border-radius:9px;font-size:13px;line-height:1.5}.slug{color:#0967b2;font:12px monospace;margin-top:10px}.foot{display:flex;justify-content:space-between;align-items:center;margin-top:15px}.badge{font-size:10px;font-weight:800;background:#e7f8ee;color:#167343;padding:5px 9px;border-radius:99px}.badge.off{background:#f1f3f6;color:#718096}.tools{display:flex;gap:7px}.icon{width:36px;height:36px;display:grid;place-items:center;border-radius:9px;background:#eff5fa;color:#245579;text-decoration:none;border:0;cursor:pointer}.icon.del{color:#ba3434;background:#fff0ef}@media(max-width:900px){.wrap{margin:82px 14px 24px;padding:4px}}@media(max-width:560px){.top{align-items:flex-start;flex-direction:column}.top h1{font-size:23px}}
</style></head><body><%- include('../common/header.ejs') %><%- include('../common/sidebar.ejs') %><main class="wrap"><div class="top"><div><h1><i class="fa-solid fa-bullhorn" style="color:#f59e0b"></i> Upcoming Events Ticker</h1><p>Top scrolling bar ka text, order aur click par khulne wala detail page manage karein.</p></div><a class="btn" href="/admin/website/ticker-announcements/new/edit"><i class="fa-solid fa-plus"></i> Naya announcement</a></div><% if(success){ %><div class="msg"><%= success %></div><% } %><% if(error){ %><div class="msg err"><%= error %></div><% } %><% if(!items.length){ %><div class="card"><h2>Koi announcement nahi hai</h2><p>New announcement add karke ticker par dikhayein.</p></div><% } else { %><div class="grid"><% items.forEach(item=>{ %><article class="card"><div style="display:flex;justify-content:space-between;gap:10px;margin-bottom:12px"><h2><%= item.title %></h2><span class="badge <%= item.active?'':'off' %>"><%= item.active?'LIVE':'HIDDEN' %></span></div><div class="ticker"><%= item.tickerText %></div><div class="slug">/announcements/<%= item.slug %></div><div class="foot"><small style="color:#64748b">Order: <%= item.displayOrder %></small><div class="tools"><a class="icon" title="Website par dekhein" target="_blank" href="<%= process.env.WEBSITE_URL || 'http://localhost:3000' %>/announcements/<%= item.slug %>"><i class="fa-solid fa-arrow-up-right-from-square"></i></a><a class="icon" title="Edit" href="/admin/website/ticker-announcements/<%= item._id %>/edit"><i class="fa-solid fa-pen"></i></a><form method="post" action="/admin/website/ticker-announcements/<%= item._id %>/delete" onsubmit="return confirm('Announcement delete karein?')"><button class="icon del" title="Delete"><i class="fa-solid fa-trash"></i></button></form></div></div></article><% }) %></div><% } %></main></body></html>
