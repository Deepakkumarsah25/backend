<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upcoming Events Ticker · VIP Admin</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;600;700;900&display=swap" rel="stylesheet">

    <!-- Admin Styles -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">

    <style>
        :root {
            --primary: #0b4ea2;
            --primary-dark: #073570;
            --accent: #f59e0b;
            --success: #10b981;
            --danger: #ef4444;
            --card-border: #e2e8f0;
            --bg-gray: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: var(--bg-gray);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .main-content {
            margin-top: 72px;
            min-height: calc(100vh - 72px);
            padding: 24px clamp(14px, 2vw, 30px);
            background: #f3f6fb;
            box-sizing: border-box;
        }

        .ticker-container {
            width: 100%;
            max-width: 1450px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-box h1 {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            color: var(--text-muted);
            font-size: 14px;
            margin-top: 4px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px rgba(11, 78, 162, 0.25);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        .alert-msg {
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-msg.success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .alert-msg.error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* Ticker Cards Grid */
        .ticker-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .ticker-card {
            background: #fff;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s ease;
        }

        .ticker-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border-color: #cbd5e1;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 14px;
        }

        .card-top h2 {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.35;
        }

        .status-badge {
            font-size: 11px;
            font-weight: 800;
            padding: 4px 9px;
            border-radius: 99px;
            white-space: nowrap;
            letter-spacing: 0.3px;
        }

        .status-badge.live {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .status-badge.hidden {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #e2e8f0;
        }

        .ticker-preview-box {
            background: #0f1c32;
            color: #f1f5f9;
            padding: 12px 14px;
            border-radius: 10px;
            font-size: 13.5px;
            line-height: 1.5;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .slug-tag {
            color: var(--primary);
            font-family: 'SFMono-Regular', Consolas, monospace;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 16px;
            word-break: break-all;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid #f1f5f9;
        }

        .order-badge {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            background: #f8fafc;
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
        }

        .card-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .action-icon-btn {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #f1f5f9;
            color: var(--text-dark);
            text-decoration: none;
            border: 1px solid var(--card-border);
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s ease;
        }

        .action-icon-btn:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .action-icon-btn.delete-btn:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

        .empty-card {
            background: #fff;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 48px 24px;
            text-align: center;
            color: var(--text-muted);
        }

        .empty-card i {
            font-size: 48px;
            color: #cbd5e1;
            margin-bottom: 14px;
        }

        .empty-card h2 {
            font-size: 18px;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-top: 68px;
                padding: 16px 14px 40px;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <%- include('../common/header.ejs') %>

    <!-- Sidebar -->
    <%- include('../common/sidebar.ejs') %>

    <!-- Main Content -->
    <main class="main-content">
        <div class="ticker-container">
            
            <div class="page-header">
                <div class="header-title-box">
                    <h1>
                        <i class="fa-solid fa-bullhorn" style="color: #f59e0b;"></i>
                        Upcoming Events Ticker (टॉप टिकर प्रबंधन)
                    </h1>
                    <p>वेबसाइट के शीर्ष पर चलने वाले टिकर का टेक्स्ट, क्रम एवं क्लिक करने पर खुलने वाला डिटेल पेज प्रबंधित करें।</p>
                </div>

                <a class="btn-action btn-primary" href="/admin/website/ticker-announcements/new/edit">
                    <i class="fa-solid fa-plus"></i>
                    <span>नया अनाउंसमेंट जोड़ें (Add New)</span>
                </a>
            </div>

            <% if (success) { %>
                <div class="alert-msg success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="alert-msg error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (!items || !items.length) { %>
                <div class="empty-card">
                    <i class="fa-solid fa-bullhorn"></i>
                    <h2>कोई सक्रिय अनाउंसमेंट नहीं है</h2>
                    <p>नया अनाउंसमेंट जोड़कर वेबसाइट के शीर्ष टिकर पर लाइव प्रदर्शित करें।</p>
                </div>
            <% } else { %>
                <div class="ticker-grid">
                    <% items.forEach(item => { %>
                        <article class="ticker-card">
                            <div>
                                <div class="card-top">
                                    <h2><%= item.title %></h2>
                                    <span class="status-badge <%= item.active ? 'live' : 'hidden' %>">
                                        <%= item.active ? 'LIVE (सक्रिय)' : 'HIDDEN (छिपा)' %>
                                    </span>
                                </div>

                                <div class="ticker-preview-box">
                                    <%= item.tickerText %>
                                </div>

                                <div class="slug-tag">
                                    <i class="fa-solid fa-link text-xs"></i>
                                    /announcements/<%= item.slug %>
                                </div>
                            </div>

                            <div class="card-footer">
                                <span class="order-badge">
                                    <i class="fa-solid fa-arrow-down-1-9 text-xs"></i>
                                    क्रम: <%= item.displayOrder %>
                                </span>

                                <div class="card-actions">
                                    <a class="action-icon-btn" title="वेबसाइट पर देखें" target="_blank" href="<%= process.env.WEBSITE_URL || 'http://localhost:3000' %>/announcements/<%= item.slug %>">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                    <a class="action-icon-btn" title="एडिट करें" href="/admin/website/ticker-announcements/<%= item._id %>/edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form method="post" action="/admin/website/ticker-announcements/<%= item._id %>/delete" onsubmit="return confirm('क्या आप इस अनाउंसमेंट को हटाना चाहते हैं?')">
                                        <button class="action-icon-btn delete-btn" title="हटाएं (Delete)" type="submit">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>

        </div>
    </main>

</body>
</html>
