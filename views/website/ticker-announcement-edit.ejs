<!DOCTYPE html><html lang="hi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Announcement edit · VIP Admin</title><link rel="stylesheet" href="/css/header.css"><link rel="stylesheet" href="/css/sidebar.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><style>
*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#14243a;font-family:Inter,Arial,sans-serif}.wrap{margin:92px 24px 30px 300px;padding:12px;max-width:1200px}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px}.top h1{font-size:26px;margin:0}.card{background:white;border:1px solid #e2eaf3;border-radius:16px;padding:23px;margin-bottom:18px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{margin-bottom:15px}.field label{display:block;font-size:13px;font-weight:750;margin-bottom:7px;color:#334155}.field input,.field textarea{width:100%;border:1px solid #d9e3ee;border-radius:10px;padding:12px 13px;font:inherit;background:#fff;color:#14243a}.field textarea{min-height:110px;resize:vertical;line-height:1.6}.hint{font-size:12px;color:#718096;margin-top:5px}.btn{display:inline-flex;gap:8px;align-items:center;padding:11px 15px;background:#0967b2;color:#fff;border-radius:10px;text-decoration:none;border:0;font-weight:700;cursor:pointer}.btn.light{background:#edf4fb;color:#17517d}.btn.red{background:#fff0ef;color:#ad3434}.error{background:#fff0ef;color:#a93226;padding:12px 15px;border-radius:9px;margin-bottom:15px}.section{background:#f7faff;border:1px solid #e1eaf4;padding:15px;border-radius:12px;margin:12px 0}.section-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.check{display:flex;align-items:center;gap:9px;font-weight:700;font-size:14px}.check input{width:18px;height:18px}.savebar{position:sticky;bottom:0;background:#fff;border-top:1px solid #e5ebf2;padding:14px 0;display:flex;justify-content:flex-end;gap:10px}@media(max-width:900px){.wrap{margin:82px 14px 24px;padding:4px}}@media(max-width:640px){.grid{grid-template-columns:1fr}.card{padding:17px}.top{align-items:flex-start;flex-direction:column}.top h1{font-size:22px}}
</style></head><body><%- include('../common/header.ejs') %><%- include('../common/sidebar.ejs') %><main class="wrap"><div class="top"><div><h1><i class="fa-solid fa-bullhorn" style="color:#f59e0b"></i> <%= item._id?'Announcement edit karein':'Naya announcement' %></h1><p style="color:#718096;margin:6px 0">Ticker par dikhne wala text aur click ke baad khulne wala page yahan set karein.</p></div><a class="btn light" href="/admin/website/ticker-announcements"><i class="fa-solid fa-arrow-left"></i> Wapas</a></div><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/admin/website/ticker-announcements/<%= item._id||'new' %>/save"><section class="card"><h2 style="margin-top:0">Ticker item aur page</h2><div class="field"><label>Ticker mein chalne wala text *</label><textarea name="tickerText" required maxlength="400" placeholder="Event / announcement ka scrolling text"><%= item.tickerText %></textarea><div class="hint">Emoji bhi use kar sakte hain. Ye top bar mein click-able hoga.</div></div><div class="grid"><div class="field"><label>Detail page ka title *</label><input name="title" required maxlength="160" value="<%= item.title %>"></div><div class="field"><label>Page URL slug *</label><input name="slug" required pattern="[a-zA-Z0-9-]+" value="<%= item.slug %>" placeholder="event-details"><div class="hint">Page URL: /announcements/slug</div></div><div class="field"><label>Chhota summary</label><input name="summary" maxlength="400" value="<%= item.summary %>"></div><div class="field"><label>Cover image URL (optional)</label><input name="coverImage" type="url" value="<%= item.coverImage %>" placeholder="https://..."></div><div class="field"><label>Display order</label><input name="displayOrder" type="number" value="<%= item.displayOrder||0 %>"></div></div><div class="field"><label>Page ka main content</label><textarea name="content" style="min-height:150px" placeholder="Detail page par dikhne wali jankari"><%= item.content %></textarea></div><label class="check"><input type="checkbox" name="active" <%= item.active?'checked':'' %>> Website ticker mein dikhayein</label></section><section class="card"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div><h2 style="margin:0">Extra content sections</h2><p style="color:#718096;margin:6px 0">Heading, details aur image add karein.</p></div><button type="button" id="add-section" class="btn light"><i class="fa-solid fa-plus"></i> Section add</button></div><div id="sections"><% (item.sections?.length?item.sections:[{}]).forEach(section=>{ %><div class="section"><div class="section-top"><strong>Content section</strong><button type="button" class="btn red remove-section"><i class="fa-solid fa-trash"></i></button></div><div class="field"><label>Heading</label><input name="sectionHeading" value="<%= section.heading||'' %>"></div><div class="field"><label>Details</label><textarea name="sectionContent"><%= section.content||'' %></textarea></div><div class="field" style="margin-bottom:0"><label>Image URL (optional)</label><input name="sectionImage" type="url" value="<%= section.imageUrl||'' %>"></div></div><% }) %></div></section><div class="savebar"><a class="btn light" href="/admin/website/ticker-announcements">Cancel</a><button class="btn"><i class="fa-solid fa-floppy-disk"></i> Save</button></div></form></main><script>
const list=document.getElementById('sections');document.getElementById('add-section').addEventListener('click',()=>{const box=document.createElement('div');box.className='section';box.innerHTML='<div class="section-top"><strong>Content section</strong><button type="button" class="btn red remove-section"><i class="fa-solid fa-trash"></i></button></div><div class="field"><label>Heading</label><input name="sectionHeading"></div><div class="field"><label>Details</label><textarea name="sectionContent"></textarea></div><div class="field" style="margin-bottom:0"><label>Image URL (optional)</label><input name="sectionImage" type="url"></div>';list.appendChild(box)});list.addEventListener('click',e=>{if(e.target.closest('.remove-section')){const nodes=list.querySelectorAll('.section');if(nodes.length>1)e.target.closest('.section').remove();else e.target.closest('.section').querySelectorAll('input,textarea').forEach(el=>el.value='')}});
</script></body></html>
