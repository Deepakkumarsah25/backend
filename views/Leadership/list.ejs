<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Leadership Management</title>

    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
       .content { padding: 24px 30px; width: 100%; box-sizing: border-box; max-width: 1500px; margin: 0 auto; }

    .top-bar{
        flex-direction:column;
        align-items:flex-start;
    }

    .top-bar h2{
        font-size:24px;
        margin:0;
    }

    .add-btn{
        width:100%;
        text-align:center;
        box-sizing:border-box;
    }

    table{
        min-width:650px;
    }

}
    </style>

</head>

<body>

<%- include("../common/header.ejs") %>
<%- include("../common/sidebar.ejs") %>

<main class="main-content">
<div class="content">

<div class="top-bar">

<h2>Leadership Management</h2>

<a href="/leadership/add" class="add-btn">
<i class="fa-solid fa-plus"></i>
Add Leadership
</a>

</div>

<table>

<thead>

<tr>

<th>Photo</th>
<th>Name</th>
<th>Designation</th>
<th>Category</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% if(leaders.length > 0){ %>

<% leaders.forEach(item=>{ %>
<tr>

<td>

<img src="<%= item.imageUrl %>">

</td>

<td>

<%= item.name %>

</td>

<td>

<%= item.designation %>

</td>

<td>

<td>
<%
let badgeClass = "";
let badgeText = "";

if (item.category === "founder") {
    badgeClass = "founder";
    badgeText = "Founder";
} else if (item.category === "leader") {
    badgeClass = "leader";
    badgeText = "MLA";
} else if (item.category === "leaderss") {
    badgeClass = "leader";
    badgeText = "Leaders";
} else {
    badgeClass = "";
    badgeText = item.category;
}
%>

<span class="badge <%= badgeClass %>">
    <%= badgeText %>
</span>

</td>

<td>

<a
href="/leadership/edit/<%= item._id %>"
class="edit"
>

<i class="fa-solid fa-pen"></i>

</a>

<a
href="#"
class="delete"
onclick="deleteLeadership('<%= item._id %>')"
>

<i class="fa-solid fa-trash"></i>

</a>

</td>

</tr>

<% }) %>

<% }else{ %>

<tr>

<td colspan="5" class="no-data">

No Leadership Found

</td>

</tr>

<% } %>

</tbody>

</table>

</div>
</main>

<script>

async function deleteLeadership(id){

const confirmDelete=confirm("Delete this record?");

if(!confirmDelete) return;

try{

const response=await fetch(`/leadership/delete/${id}`,{

method:"DELETE"

});

const data=await response.json();

if(data.success){

alert("Deleted Successfully");

location.reload();

}else{

alert(data.message);

}

}catch(error){

console.log(error);

alert("Something went wrong");

}

}

</script>

</body>

</html>