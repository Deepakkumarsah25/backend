<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Driver List · Vikassheel Insaan Party</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/sidebar.css">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    body {
      background: #f8f9fc;
      min-height: 100vh;
    }

    /* ===== MAIN CONTENT AREA ===== */
    .main-content {
      margin-left: 280px;
      margin-top: 70px;
      padding: 30px 35px;
      min-height: calc(100vh - 70px);
      transition: margin-left 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      background: #f8f9fc;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
    }

    /* ===== TOP BAR ===== */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .top-bar h2 {
      color: #1a1a2e;
      font-size: 24px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .top-bar h2 i {
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .driver-count {
      background: #f0ebf5;
      padding: 4px 14px;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 600;
      color: #2d1b3d;
    }

    .add-btn {
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      color: #fff;
      padding: 10px 22px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(74, 26, 107, 0.25);
    }

    .add-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(74, 26, 107, 0.35);
    }

    /* ===== TABLE WRAPPER ===== */
    .table-wrapper {
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(0, 0, 0, 0.04);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      color: #fff;
    }

    thead th {
      padding: 16px 18px;
      text-align: left;
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    tbody tr {
      border-bottom: 1px solid #f0ebf5;
      transition: all 0.3s ease;
    }

    tbody tr:hover {
      background: #faf8fc;
      transform: scale(1.002);
    }

    tbody td {
      padding: 14px 18px;
      font-size: 14px;
      color: #1e2229;
      vertical-align: middle;
    }

    /* ===== DRIVER NAME ===== */
    .driver-name {
      font-weight: 600;
      color: #1a1a2e;
    }

    .driver-name i {
      color: #4a1a6b;
      margin-right: 8px;
    }

    /* ===== PHONE ===== */
    .phone-number {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .phone-number i {
      color: #4a1a6b;
      font-size: 13px;
    }

    /* ===== VEHICLE NUMBER ===== */
    .vehicle-number {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f0ebf5;
      padding: 4px 12px;
      border-radius: 30px;
      font-weight: 500;
      font-size: 13px;
      color: #2d1b3d;
    }

    .vehicle-number i {
      color: #4a1a6b;
      font-size: 13px;
    }

    /* ===== SPEED INDICATOR ===== */
    .speed-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 13px;
    }

    .speed-indicator.slow {
      background: #dcfce7;
      color: #15803d;
    }

    .speed-indicator.medium {
      background: #fef3c7;
      color: #b45309;
    }

    .speed-indicator.fast {
      background: #fee9e7;
      color: #b81c1c;
    }

    .speed-indicator i {
      font-size: 13px;
    }

    /* ===== STATUS BADGE ===== */
    .status {
      padding: 5px 14px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 600;
      display: inline-block;
      text-transform: capitalize;
    }

    .status.active {
      background: #dcfce7;
      color: #15803d;
    }

    .status.inactive {
      background: #fee9e7;
      color: #b81c1c;
    }

    .status.on-duty {
      background: #dbeafe;
      color: #1a56db;
    }

    .status.off-duty {
      background: #e5e7eb;
      color: #4b5563;
    }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
      display: flex;
      gap: 8px;
    }

    .delete-btn {
      background: #fee9e7;
      color: #b81c1c;
      padding: 7px 12px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: none;
      cursor: pointer;
    }

    .delete-btn:hover {
      background: #fcd8d4;
      color: #a11616;
      transform: scale(0.95);
    }

    .edit-btn {
      background: #e8f0fe;
      color: #1a56db;
      padding: 7px 12px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .edit-btn:hover {
      background: #d4e2fc;
      transform: scale(0.95);
    }

    .view-btn {
      background: #f0ebf5;
      color: #2d1b3d;
      padding: 7px 12px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .view-btn:hover {
      background: #e4dceb;
      transform: scale(0.95);
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #7a7a8a;
    }

    .empty-state i {
      font-size: 48px;
      background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 15px;
    }

    .empty-state h3 {
      color: #1a1a2e;
      margin-bottom: 8px;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 992px) {
      .main-content {
        margin-left: 0 !important;
        padding: 20px;
      }
    }

    @media (max-width: 768px) {
      .top-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .top-bar h2 {
        font-size: 20px;
      }

      .add-btn {
        justify-content: center;
      }

      .table-wrapper {
        overflow-x: auto;
      }

      table {
        min-width: 900px;
      }
    }

    @media (max-width: 480px) {
      .main-content {
        padding: 14px;
      }

      .top-bar h2 {
        font-size: 18px;
      }

      .driver-count {
        font-size: 12px;
        padding: 3px 10px;
      }

      thead th {
        font-size: 11px;
        padding: 12px 14px;
      }

      tbody td {
        font-size: 13px;
        padding: 10px 14px;
      }

      .action-buttons {
        flex-direction: column;
      }

      .delete-btn, .edit-btn, .view-btn {
        padding: 5px 10px;
        font-size: 12px;
      }

      .vehicle-number {
        font-size: 11px;
        padding: 3px 8px;
      }

      .speed-indicator {
        font-size: 11px;
        padding: 3px 8px;
      }
    }

    /* ===== TOAST NOTIFICATION ===== */
    .toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: #1a1a2e;
      color: white;
      padding: 0.9rem 1.8rem;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.95rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      transform: translateY(80px);
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }
    .toast.success { background: #0f7b3a; }
    .toast.error { background: #b22234; }
  </style>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <%- include("../common/header.ejs") %>

  <!-- ===== SIDEBAR ===== -->
  <%- include("../common/sidebar.ejs") %>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main-content">
    <div class="container">

      <!-- Top Bar -->
      <div class="top-bar">
        <h2>
          <i class="fas fa-car"></i>
          Driver List
          <span class="driver-count"><%= drivers ? drivers.length : 0 %></span>
        </h2>

        <a href="/driver" class="add-btn">
          <i class="fas fa-plus"></i>
          Add Driver
        </a>
      </div>

      <!-- Table -->
      <div class="table-wrapper">
        <table>

          <thead>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th>Vehicle Number</th>
              <th>Current Speed</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% if (drivers && drivers.length > 0) { %>
              <% drivers.forEach(driver => { %>
                <tr>
                  <td>
                    <span class="driver-name">
                      <i class="fas fa-user-circle"></i>
                      <%= driver.name %>
                    </span>
                  </td>

                  <td>
                    <span class="phone-number">
                      <i class="fas fa-phone"></i>
                      <%= driver.phone %>
                    </span>
                  </td>

                  <td>
                    <span class="vehicle-number">
                      <i class="fas fa-truck"></i>
                      <%= driver.vehicleNumber %>
                    </span>
                  </td>

                  <td>
                    <% 
                      const speed = driver.speed || 0;
                      let speedClass = 'slow';
                      let speedIcon = 'fa-walking';
                      if (speed > 60) {
                        speedClass = 'fast';
                        speedIcon = 'fa-car';
                      } else if (speed > 30) {
                        speedClass = 'medium';
                        speedIcon = 'fa-car-side';
                      }
                    %>
                    <span class="speed-indicator <%= speedClass %>">
                      <i class="fas <%= speedIcon %>"></i>
                      <%= speed %> km/h
                    </span>
                  </td>

                  <td>
                    <span class="status <%= driver.status || 'active' %>">
                      <i class="fas fa-circle" style="font-size: 8px; margin-right: 4px;"></i>
                      <%= driver.status || 'Active' %>
                    </span>
                  </td>

                  <td>
                    <div class="action-buttons">
                      <!-- View Button -->
                      <a href="/driver/view/<%= driver._id %>" class="view-btn" title="View Driver Details">
                        <i class="fas fa-eye"></i>
                      </a>

                      <!-- Edit Button -->
                      <a href="/driver/edit/<%= driver._id %>" class="edit-btn" title="Edit Driver">
                        <i class="fas fa-pen"></i>
                      </a>

                      <!-- Delete Button -->
                      <a href="/driver/delete/<%= driver._id %>" 
                         class="delete-btn" 
                         onclick="return confirm('Are you sure you want to delete this driver?')"
                         title="Delete Driver">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">
                  <div class="empty-state">
                    <i class="fas fa-car-side"></i>
                    <h3>No Drivers Found</h3>
                    <p>Start by adding your first driver to the system.</p>
                    <a href="/driver" class="add-btn" style="display: inline-flex; margin-top: 15px;">
                      <i class="fas fa-plus"></i> Add Driver
                    </a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>

        </table>
      </div>

    </div>
  </main>

  <!-- Toast Notification -->
  <div class="toast" id="toast"></div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Show toast message if there's a query parameter
      const urlParams = new URLSearchParams(window.location.search);
      const message = urlParams.get('message');
      const type = urlParams.get('type') || 'success';

      if (message) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = 'toast ' + type;
        void toast.offsetWidth;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 3000);

        // Clean URL without reload
        const newUrl = window.location.pathname;
        window.history.replaceState({}, document.title, newUrl);
      }

      // Delete confirmation with AJAX
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (href) {
            e.preventDefault();
            if (confirm('Are you sure you want to delete this driver?')) {
              window.location.href = href;
            }
          }
        });
      });
    });
  </script>

</body>
</html>