<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Edit Category</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f7fc; margin: 0; padding: 24px; }
    .box { max-width: 500px; margin: auto; background: #fff; padding: 24px; border-radius: 10px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
    label { display: block; margin: 14px 0 6px; font-weight: bold; }
    input[type=text], input[type=number] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
    .chk { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
    button { margin-top: 20px; background: #0b4ea2; color: #fff; border: 0; padding: 10px 18px; border-radius: 6px; cursor: pointer; }
    a { margin-left: 12px; color: #555; }
    .err { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 6px; margin-bottom: 10px; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Edit Organisation Category</h2>
    <% if (error) { %><div class="err"><%= error %></div><% } %>

    <form method="POST" action="/organisation/categories/manage/update/<%= category._id %>">
      <label>Category Name (English)</label>
      <input type="text" name="title" value="<%= category.title %>" required />

      <label>Category Name (Hindi)</label>
      <input type="text" name="title_hi" value="<%= category.title_hi %>" />

      <label>Order</label>
      <input type="number" name="order" value="<%= category.order %>" />

      <div class="chk">
        <input type="checkbox" name="isActive" id="isActive" <%= category.isActive ? "checked" : "" %> />
        <label for="isActive" style="margin:0">App me dikhao (Active)</label>
      </div>

      <button type="submit">Update</button>
      <a href="/organisation/categories/manage">Cancel</a>
    </form>
  </div>
</body>
</html>