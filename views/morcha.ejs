<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Morcha / Wings Management</title>

    <link rel="stylesheet" href="/css/sidebar.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --primary-light: #eef0ff;
            --ink: #1e293b;
            --muted: #64748b;
            --border: #e2e8f0;
        }

        body {
            background: #f8fafc;
        }

        .main-content {
            margin-left: 270px;
            padding: 30px;
        }

        @media(max-width:1100px) {

            .main-content {
                margin-left: 0;
                padding: 80px 15px 20px;
            }

        }

        .page-title {

            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 6px;

        }

        .icon-box {

            width: 46px;
            height: 46px;
            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(135deg, var(--primary), var(--primary-dark));

            color: #fff;
            font-size: 18px;

        }

        .page-title h2 {

            font-size: 26px;
            font-weight: 800;
            color: var(--ink);

        }

        .page-header-wrap {

            margin-bottom: 26px;

        }

        .page-header-wrap p {

            margin-top: 6px;
            color: var(--muted);

        }

        .container-grid {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        @media(max-width:1100px) {

            .container-grid {

                grid-template-columns: 1fr;

            }

        }

        .card {

            background: #fff;
            border-radius: 16px;
            overflow: hidden;

            border: 1px solid var(--border);

            box-shadow: 0 8px 25px rgba(79, 70, 229, .08);

        }

        .card-header {

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;

            padding: 18px 22px;

            border-bottom: 1px solid var(--border);

            background: #fafbff;

        }

        .card-header-left {

            display: flex;
            align-items: center;
            gap: 10px;

        }

        .head-icon {

            color: var(--primary);

        }

        .card-header h3 {

            font-size: 16px;

        }

        .card-body {

            padding: 22px;

        }

        .form-row {

            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;

        }

        @media(max-width:700px) {

            .form-row {
                grid-template-columns: 1fr;
            }

        }

        .form-group {

            margin-bottom: 18px;

        }

        .form-group label {

            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--ink);

        }

        .form-control {

            width: 100%;
            padding: 11px 14px;

            border: 1.5px solid var(--border);
            border-radius: 10px;

            outline: none;

            transition: .2s;

        }

        .form-control:focus {

            border-color: var(--primary);

            box-shadow: 0 0 0 3px rgba(79, 70, 229, .15);

        }

        textarea.form-control {

            resize: vertical;
            min-height: 90px;

        }

        .btn {

            border: none;
            cursor: pointer;

            border-radius: 10px;

            padding: 12px 26px;

            font-weight: 600;

        }

        .btn-primary {

            background: linear-gradient(135deg, var(--primary), var(--primary-dark));

            color: #fff;

        }

        .btn-primary:hover {

            opacity: .95;

        }

        .btn-cancel {

            background: #f1f5f9;
            color: var(--ink);
            text-decoration: none;

            display: inline-flex;
            align-items: center;

            padding: 12px 22px;

            margin-left: 10px;

        }

        .badge-mode {

            font-size: 12px;
            font-weight: 700;

            padding: 5px 12px;
            border-radius: 20px;

        }

        .badge-add {

            background: #ecfdf5;
            color: #059669;

        }

        .badge-edit {

            background: #fff7ed;
            color: #ea580c;

        }

        .preview-box {

            padding: 18px 22px 22px;

            text-align: center;

        }

        .preview-box img {

            width: 100%;
            max-width: 320px;
            height: 220px;

            border-radius: 14px;

            object-fit: cover;

            border: 2px dashed #cbd5e1;

        }
    </style>

</head>

<body>

    <%- include("common/sidebar") %>

        <div class="main-content">

            <div class="page-header-wrap">

                <div class="page-title">

                    <div class="icon-box">

                        <i class="fa-solid fa-flag"></i>

                    </div>

                    <div>

                        <h2>Morcha / Wings</h2>

                        <p>
                            Manage Party Morcha & Wings
                        </p>

                    </div>

                </div>

            </div>

            <div class="container-grid">

                <!-- FORM -->

                <div class="card">

                    <div class="card-header">

                        <div class="card-header-left">

                            <i class="fa-solid <%= editWing ? 'fa-pen-to-square' : 'fa-circle-plus' %> head-icon"></i>

                            <h3><%= editWing ? 'Edit Wing' : 'Add Wing' %></h3>

                        </div>

                        <span class="badge-mode <%= editWing ? 'badge-edit' : 'badge-add' %>">
                            <%= editWing ? 'Editing' : 'New' %>
                        </span>

                    </div>

                    <div class="card-body">

                        <form
                            action="<%= editWing ? '/morcha/update/' + editWing._id : '/morcha/add' %>"
                            method="POST"
                            enctype="multipart/form-data"
                        >

                            <div class="form-row">

                                <div class="form-group">

                                    <label>Key (e.g. women_wing)</label>

                                    <input type="text" name="key" class="form-control"
                                        value="<%= editWing ? editWing.key : '' %>" required>

                                </div>

                                <div class="form-group">

                                    <label>Order</label>

                                    <input type="number" name="order" class="form-control"
                                        value="<%= editWing ? editWing.order : 0 %>">

                                </div>

                            </div>

                            <div class="form-row">

                                <div class="form-group">

                                    <label>Title (Hindi)</label>

                                    <input type="text" name="titleHi" class="form-control"
                                        value="<%= editWing ? editWing.titleHi : '' %>" required>

                                </div>

                                <div class="form-group">

                                    <label>Title (English)</label>

                                    <input type="text" name="titleEn" class="form-control"
                                        value="<%= editWing ? editWing.titleEn : '' %>" required>

                                </div>

                            </div>

                            <div class="form-row">

                                <div class="form-group">

                                    <label>Head Name</label>

                                    <input type="text" name="head" class="form-control"
                                        value="<%= editWing ? editWing.head : '' %>">

                                </div>

                                <div class="form-group">

                                    <label>Contact</label>

                                    <input type="text" name="contact" class="form-control"
                                        value="<%= editWing ? editWing.contact : '' %>">

                                </div>

                            </div>

                            <div class="form-row">

                                <div class="form-group">

                                    <label>Established Year</label>

                                    <input type="text" name="established" class="form-control"
                                        value="<%= editWing ? editWing.established : '' %>">

                                </div>

                                <div class="form-group">

                                    <label>Image</label>

                                    <input type="file" name="image" id="image" accept="image/*" class="form-control">

                                </div>

                            </div>

                            <div class="form-group">

                                <label>Description</label>

                                <textarea name="description" class="form-control"><%= editWing ? editWing.description : '' %></textarea>

                            </div>

                            <div class="form-group">

                                <label>

                                    <input type="checkbox" name="isPublished" <%= (!editWing || editWing.isPublished) ? 'checked' : '' %> >

                                    Published

                                </label>

                            </div>

                            <button class="btn btn-primary">

                                <i class="fa-solid fa-floppy-disk"></i>

                                <%= editWing ? 'Update Wing' : 'Save Wing' %>

                            </button>

                            <% if (editWing) { %>
                                <a href="/morcha" class="btn-cancel">Cancel</a>
                            <% } %>

                        </form>

                        <% if (editWing && editWing.image) { %>
                            <div class="preview-box">
                                <img src="<%= editWing.image %>">
                            </div>
                        <% } %>

                    </div>

                </div>

                <!-- LIST -->

                <div class="card">

                    <div class="card-header">

                        <div class="card-header-left">

                            <i class="fa-solid fa-people-group head-icon"></i>

                            <h3>All Wings</h3>

                        </div>

                    </div>

                    <div class="card-body">

                        <div
                            style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;gap:15px;flex-wrap:wrap;">

                            <input type="text" id="searchInput" class="form-control" placeholder="Search title..."
                                style="max-width:280px;">

                            <select id="statusFilter" class="form-control" style="max-width:220px;">
                                <option value="">All Status</option>
                                <option value="true">Published</option>
                                <option value="false">Draft</option>
                            </select>

                        </div>

                        <div style="overflow:auto;">

                            <table style="width:100%;border-collapse:collapse;">

                                <thead>

                                    <tr style="background:#f8fafc;">

                                        <th style="padding:14px;">Order</th>

                                        <th style="padding:14px;">Preview</th>

                                        <th style="padding:14px;">Title</th>

                                        <th style="padding:14px;">Key</th>

                                        <th style="padding:14px;">Head</th>

                                        <th style="padding:14px;">Status</th>

                                        <th style="padding:14px;">Action</th>

                                    </tr>

                                </thead>

                                <tbody id="wingTable">

                                    <% wings.forEach(w => { %>

                                        <tr data-status="<%= w.isPublished %>"
                                            data-title="<%= w.titleHi.toLowerCase() %>"
                                            style="border-top:1px solid #edf2f7;">

                                            <td style="padding:14px;"><%= w.order %></td>

                                            <td style="padding:14px;">

                                                <% if (w.image) { %>
                                                    <img src="<%= w.image %>"
                                                        style="width:70px;height:50px;border-radius:8px;object-fit:cover;cursor:pointer;"
                                                        onclick="previewImage('<%= w.image %>')">
                                                <% } else { %>
                                                    <span style="color:var(--muted);font-size:12px;">No image</span>
                                                <% } %>

                                            </td>

                                            <td style="padding:14px;font-weight:600;">
                                                <%= w.titleHi %>
                                            </td>

                                            <td style="padding:14px;">
                                                <%= w.key %>
                                            </td>

                                            <td style="padding:14px;">
                                                <%= w.head %>
                                            </td>

                                            <td style="padding:14px;">

                                                <% if (w.isPublished) { %>
                                                    <span style="color:#16a34a;font-weight:700;">Published</span>
                                                <% } else { %>
                                                    <span style="color:#dc2626;font-weight:700;">Draft</span>
                                                <% } %>

                                            </td>

                                            <td style="padding:14px;white-space:nowrap;">

                                                <a href="/morcha/edit/<%= w._id %>"
                                                    style="background:#4f46e5;color:#fff;padding:8px 14px;border-radius:8px;text-decoration:none;margin-right:6px;">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>

                                                <a href="/morcha/delete/<%= w._id %>"
                                                    onclick="return confirm('Delete this wing?')"
                                                    style="background:#ef4444;color:#fff;padding:8px 14px;border-radius:8px;text-decoration:none;">
                                                    <i class="fa-solid fa-trash"></i>
                                                </a>

                                            </td>

                                        </tr>

                                    <% }) %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div id="previewModal" style="
display:none;
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
background:rgba(0,0,0,.8);
justify-content:center;
align-items:center;
z-index:9999;
">

            <img id="previewImg" style="
max-width:85%;
max-height:85%;
border-radius:14px;
">

        </div>

        <script>

            const preview = document.getElementById("previewImg");

            const modal = document.getElementById("previewModal");

            function previewImage(src) {

                preview.src = src;

                modal.style.display = "flex";

            }

            modal.onclick = () => {

                modal.style.display = "none";

            }

            const imageInput = document.getElementById("image");

            if (imageInput) {

                imageInput.addEventListener("change", function (e) {

                    const file = e.target.files[0];

                    if (!file) return;

                    const reader = new FileReader();

                    reader.onload = function (ev) {

                        let img = document.querySelector(".preview-box img");

                        if (!img) {

                            const box = document.createElement("div");

                            box.className = "preview-box";

                            box.innerHTML = '<img>';

                            document.querySelector(".card").appendChild(box);

                            img = box.querySelector("img");

                        }

                        img.src = ev.target.result;

                    }

                    reader.readAsDataURL(file);

                });

            }

            const search = document.getElementById("searchInput");

            const filter = document.getElementById("statusFilter");

            function applyFilter() {

                const keyword = search.value.toLowerCase();

                const status = filter.value;

                document.querySelectorAll("#wingTable tr").forEach(row => {

                    const title = row.dataset.title;

                    const rowStatus = row.dataset.status;

                    const show =

                        title.includes(keyword)

                        &&

                        (status === "" || rowStatus === status);

                    row.style.display = show ? "" : "none";

                });

            }

            search.addEventListener("keyup", applyFilter);

            filter.addEventListener("change", applyFilter);

        </script>

</body>

</html>