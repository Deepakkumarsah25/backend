<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>फ़ॉर्म्स एवं आवेदन प्रबंधन (Forms Hub) - VIP Admin Panel</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    
    <style>
        :root {
            --primary: #0b4ea2;
            --primary-dark: #073570;
            --primary-light: #e8f1fc;
            --accent: #f59e0b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #0284c7;
            --bg-gray: #f8fafc;
            --card-border: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: var(--bg-gray);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .forms-dashboard {
            padding: 24px;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* Page Header */
        .page-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .header-title-box h1 {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box h1 .hub-badge {
            font-size: 13px;
            background: linear-gradient(135deg, #0b4ea2, #0284c7);
            color: #fff;
            padding: 4px 12px;
            border-radius: 999px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .header-title-box p {
            color: var(--text-muted);
            font-size: 14px;
            margin-top: 4px;
        }

        .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px rgba(11, 78, 162, 0.25);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        .btn-outline {
            background: #fff;
            color: var(--text-dark);
            border: 1px solid var(--card-border);
        }

        .btn-outline:hover {
            background: #f1f5f9;
        }

        /* Stats Cards Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 18px 20px;
            border: 1px solid var(--card-border);
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.25s ease;
            text-decoration: none;
            color: inherit;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border-color: var(--primary);
        }

        .stat-card.active {
            border-color: var(--primary);
            background: linear-gradient(to bottom, #ffffff, #f0f7ff);
            box-shadow: 0 0 0 2px var(--primary);
        }

        .stat-info .stat-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .stat-info .stat-value {
            font-size: 26px;
            font-weight: 900;
            color: var(--text-dark);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .stat-all .stat-icon { background: #e0e7ff; color: #4338ca; }
        .stat-vol .stat-icon { background: #dbeafe; color: #1d4ed8; }
        .stat-sch .stat-icon { background: #fef3c7; color: #b45309; }
        .stat-can .stat-icon { background: #ffe4e6; color: #e11d48; }
        .stat-joi .stat-icon { background: #d1fae5; color: #047857; }
        .stat-con .stat-icon { background: #ede9fe; color: #6d28d9; }
        .stat-usr .stat-icon { background: #cffafe; color: #0e7490; }

        /* Navigation Tabs */
        .tabs-nav-bar {
            background: #fff;
            border-radius: 14px;
            border: 1px solid var(--card-border);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            margin-bottom: 20px;
            scrollbar-width: thin;
        }

        .tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .tab-btn:hover {
            color: var(--primary);
            background: var(--primary-light);
        }

        .tab-btn.active {
            background: var(--primary);
            color: #fff;
        }

        .tab-count {
            background: rgba(0,0,0,0.08);
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

        .tab-btn.active .tab-count {
            background: rgba(255,255,255,0.25);
            color: #fff;
        }

        /* Filter & Search Bar */
        .toolbar-panel {
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--card-border);
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .search-input-group {
            position: relative;
            flex: 1;
            min-width: 260px;
        }

        .search-input-group i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-input-group input {
            width: 100%;
            padding: 10px 14px 10px 42px;
            border-radius: 10px;
            border: 1px solid var(--card-border);
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-input-group input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(11, 78, 162, 0.1);
        }

        .filter-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .select-filter {
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid var(--card-border);
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-dark);
            background: #fff;
            cursor: pointer;
            outline: none;
        }

        .select-filter:focus {
            border-color: var(--primary);
        }

        /* Table Card Container */
        .table-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 14px rgba(0,0,0,0.02);
            overflow: hidden;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .forms-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13.5px;
        }

        .forms-table th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 700;
            padding: 14px 18px;
            text-transform: uppercase;
            font-size: 11.5px;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--card-border);
            white-space: nowrap;
        }

        .forms-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .forms-table tbody tr {
            transition: background-color 0.15s ease;
        }

        .forms-table tbody tr:hover {
            background-color: #f8fafc;
        }

        /* Applicant Cell */
        .applicant-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .applicant-avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #0b4ea2, #0284c7);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0;
            text-transform: uppercase;
        }

        .applicant-meta .name {
            font-weight: 700;
            color: var(--text-dark);
            font-size: 14px;
        }

        .applicant-meta .subtext {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* Form Type Badge */
        .type-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 11px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .pill-volunteer { background: #dbeafe; color: #1e40af; }
        .pill-scholarship { background: #fef3c7; color: #92400e; }
        .pill-candidature { background: #ffe4e6; color: #9f1239; }
        .pill-join { background: #d1fae5; color: #065f46; }
        .pill-contact { background: #ede9fe; color: #5b21b6; }
        .pill-user { background: #cffafe; color: #155e75; }

        /* ID Pill */
        .id-pill {
            font-family: monospace;
            font-weight: 700;
            font-size: 12px;
            background: #f1f5f9;
            color: #334155;
            padding: 3px 8px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .id-pill:hover {
            background: #e2e8f0;
        }

        /* Status Select */
        .status-badge-select {
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            outline: none;
            transition: all 0.2s;
        }

        .status-Pending { background: #fef3c7; color: #92400e; border-color: #fde68a; }
        .status-Approved { background: #d1fae5; color: #065f46; border-color: #a7f3d0; }
        .status-Rejected { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
        .status-Under-Review { background: #e0e7ff; color: #3730a3; border-color: #c7d2fe; }
        .status-New { background: #ede9fe; color: #5b21b6; border-color: #ddd6fe; }
        .status-Active { background: #dcfce7; color: #166534; border-color: #bbf7d0; }

        /* Action Buttons */
        .action-btns {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--card-border);
            background: #fff;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s;
            font-size: 13px;
        }

        .btn-icon:hover {
            background: var(--primary-light);
            color: var(--primary);
            border-color: var(--primary);
        }

        .btn-icon.btn-delete:hover {
            background: #fee2e2;
            color: var(--danger);
            border-color: var(--danger);
        }

        /* Empty State */
        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 48px;
            color: #cbd5e1;
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        /* Detail Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: #fff;
            border-radius: 20px;
            max-width: 760px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: modalFadeIn 0.2s ease-out;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 10;
        }

        .modal-header h2 {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-close-modal {
            background: #f1f5f9;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 16px;
        }

        .btn-close-modal:hover {
            background: #e2e8f0;
            color: var(--text-dark);
        }

        .modal-body {
            padding: 24px;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        @media (max-width: 600px) {
            .detail-grid { grid-template-columns: 1fr; }
        }

        .detail-field {
            background: #f8fafc;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid #edf2f7;
        }

        .detail-field.full-width {
            grid-column: 1 / -1;
        }

        .field-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .field-val {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            word-break: break-word;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8fafc;
            border-radius: 0 0 20px 20px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #0f172a;
            color: #fff;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            z-index: 10000;
            display: none;
            animation: toastSlide 0.3s ease;
        }

        @keyframes toastSlide {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>
<body>

    <!-- ==================== HEADER ==================== -->
    <%- include('../common/header.ejs') %>

    <!-- ==================== SIDEBAR ==================== -->
    <%- include('../common/sidebar.ejs') %>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="main-content">
        <div class="forms-dashboard">
            
            <!-- Page Header -->
            <div class="page-header-row">
                <div class="header-title-box">
                    <h1>
                        <i class="fa-solid fa-clipboard-list" style="color: var(--primary);"></i>
                        फ़ॉर्म्स एवं आवेदन प्रबंधन
                        <span class="hub-badge"><i class="fa-solid fa-bolt"></i> Live Submissions</span>
                    </h1>
                    <p>वेबसाइट से भरे गए सभी फॉर्म्स (वालंटियर, छात्रवृत्ति, यूपी 2027 उम्मीदवारी, सदस्यता, संपर्क संदेश) की रियल-टाइम सूची</p>
                </div>

                <div class="header-actions">
                    <a href="/admin/forms/export/<%= selectedType %>" class="btn-action btn-outline" title="CSV में डाउनलोड करें">
                        <i class="fa-solid fa-file-excel" style="color: #10b981;"></i>
                        <span>Export CSV</span>
                    </a>
                    <button type="button" onclick="window.location.reload();" class="btn-action btn-primary">
                        <i class="fa-solid fa-rotate"></i>
                        <span>रिफ्रेश (Refresh)</span>
                    </button>
                </div>
            </div>

            <!-- Stats Metric Cards -->
            <div class="stats-grid">
                <!-- Total -->
                <a href="/admin/forms?type=all" class="stat-card stat-all <%= selectedType === 'all' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">कुल आवेदन (Total)</div>
                        <div class="stat-value"><%= counts.total %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </a>

                <!-- Volunteers -->
                <a href="/admin/forms?type=volunteers" class="stat-card stat-vol <%= selectedType === 'volunteers' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">वालंटियर (Volunteer)</div>
                        <div class="stat-value"><%= counts.volunteers %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-handshake-angle"></i>
                    </div>
                </a>

                <!-- Scholarships -->
                <a href="/admin/forms?type=scholarships" class="stat-card stat-sch <%= selectedType === 'scholarships' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">छात्रवृत्ति योजना</div>
                        <div class="stat-value"><%= counts.scholarships %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                </a>

                <!-- UP 2027 -->
                <a href="/admin/forms?type=candidatures" class="stat-card stat-can <%= selectedType === 'candidatures' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">यूपी 2027 दावेदारी</div>
                        <div class="stat-value"><%= counts.candidatures %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-vote-yea"></i>
                    </div>
                </a>

                <!-- Joins -->
                <a href="/admin/forms?type=joins" class="stat-card stat-joi <%= selectedType === 'joins' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">पार्टी सदस्यता</div>
                        <div class="stat-value"><%= counts.joins %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>
                </a>

                <!-- Contact Messages -->
                <a href="/admin/forms?type=contacts" class="stat-card stat-con <%= selectedType === 'contacts' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">संपर्क संदेश</div>
                        <div class="stat-value"><%= counts.contacts %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                </a>

                <!-- Users -->
                <a href="/admin/forms?type=users" class="stat-card stat-usr <%= selectedType === 'users' ? 'active' : '' %>">
                    <div class="stat-info">
                        <div class="stat-label">वेब यूजर (Signup)</div>
                        <div class="stat-value"><%= counts.users %></div>
                    </div>
                    <div class="stat-icon">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                </a>
            </div>

            <!-- Category Sub-Tabs -->
            <div class="tabs-nav-bar">
                <a href="/admin/forms?type=all" class="tab-btn <%= selectedType === 'all' ? 'active' : '' %>">
                    <i class="fa-solid fa-table-cells-large"></i>
                    <span>सभी फ़ॉर्म (All Forms)</span>
                    <span class="tab-count"><%= counts.total %></span>
                </a>
                <a href="/admin/forms?type=volunteers" class="tab-btn <%= selectedType === 'volunteers' ? 'active' : '' %>">
                    <i class="fa-solid fa-handshake-angle"></i>
                    <span>वालंटियर</span>
                    <span class="tab-count"><%= counts.volunteers %></span>
                </a>
                <a href="/admin/forms?type=scholarships" class="tab-btn <%= selectedType === 'scholarships' ? 'active' : '' %>">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>छात्रवृत्ति</span>
                    <span class="tab-count"><%= counts.scholarships %></span>
                </a>
                <a href="/admin/forms?type=candidatures" class="tab-btn <%= selectedType === 'candidatures' ? 'active' : '' %>">
                    <i class="fa-solid fa-vote-yea"></i>
                    <span>यूपी 2027 दावेदारी</span>
                    <span class="tab-count"><%= counts.candidatures %></span>
                </a>
                <a href="/admin/forms?type=joins" class="tab-btn <%= selectedType === 'joins' ? 'active' : '' %>">
                    <i class="fa-solid fa-id-card"></i>
                    <span>सदस्यता (Join VIP)</span>
                    <span class="tab-count"><%= counts.joins %></span>
                </a>
                <a href="/admin/forms?type=contacts" class="tab-btn <%= selectedType === 'contacts' ? 'active' : '' %>">
                    <i class="fa-solid fa-envelope"></i>
                    <span>संपर्क संदेश</span>
                    <span class="tab-count"><%= counts.contacts %></span>
                </a>
                <a href="/admin/forms?type=users" class="tab-btn <%= selectedType === 'users' ? 'active' : '' %>">
                    <i class="fa-solid fa-users"></i>
                    <span>पंजीकृत उपयोगकर्ता</span>
                    <span class="tab-count"><%= counts.users %></span>
                </a>
            </div>

            <!-- Toolbar: Search & Filter -->
            <div class="toolbar-panel">
                <form method="GET" action="/admin/forms" style="display: flex; gap: 12px; width: 100%; flex-wrap: wrap;">
                    <input type="hidden" name="type" value="<%= selectedType %>">
                    
                    <div class="search-input-group">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="q" value="<%= searchQuery %>" placeholder="नाम, मोबाइल, जिला या ID से खोजें..." autocomplete="off">
                    </div>

                    <div class="filter-controls">
                        <select name="status" class="select-filter" onchange="this.form.submit()">
                            <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>सभी स्थिति (All Status)</option>
                            <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>लंबित (Pending)</option>
                            <option value="Approved" <%= selectedStatus === 'Approved' ? 'selected' : '' %>>स्वीकृत (Approved)</option>
                            <option value="Under Review" <%= selectedStatus === 'Under Review' ? 'selected' : '' %>>समीक्षाधीन (Under Review)</option>
                            <option value="Rejected" <%= selectedStatus === 'Rejected' ? 'selected' : '' %>>अस्वीकृत (Rejected)</option>
                            <option value="New" <%= selectedStatus === 'New' ? 'selected' : '' %>>नया संदेश (New)</option>
                        </select>

                        <button type="submit" class="btn-action btn-primary" style="padding: 10px 18px;">
                            <i class="fa-solid fa-filter"></i>
                            <span>फ़िल्टर</span>
                        </button>

                        <% if (searchQuery || selectedStatus !== 'all') { %>
                            <a href="/admin/forms?type=<%= selectedType %>" class="btn-action btn-outline" title="Clear Filters">
                                <i class="fa-solid fa-xmark"></i>
                                <span>क्लियर</span>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Submissions Table Card -->
            <div class="table-card">
                <div class="table-responsive">
                    <table class="forms-table" id="formsTable">
                        <thead>
                            <tr>
                                <th># ID</th>
                                <th>आवेदक का नाम (Applicant)</th>
                                <th>फ़ॉर्म प्रकार (Form Type)</th>
                                <th>मोबाइल / संपर्क (Contact)</th>
                                <th>स्थान / क्षेत्र (Location)</th>
                                <th>आवेदन तिथि (Date)</th>
                                <th>स्थिति (Status)</th>
                                <th style="text-align: right;">कार्रवाई (Action)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (items && items.length > 0) { %>
                                <% items.forEach((item, index) => { %>
                                    <tr id="row-<%= item._formType %>-<%= item._id %>">
                                        <!-- ID -->
                                        <td>
                                            <span class="id-pill" onclick="copyId('<%= item._uniqueId %>')" title="Click to copy ID">
                                                <%= item._uniqueId %>
                                                <i class="fa-regular fa-copy" style="font-size: 10px;"></i>
                                            </span>
                                        </td>

                                        <!-- Applicant -->
                                        <td>
                                            <div class="applicant-info">
                                                <div class="applicant-avatar">
                                                    <%= (item._applicantName || 'U').charAt(0) %>
                                                </div>
                                                <div class="applicant-meta">
                                                    <div class="name"><%= item._applicantName %></div>
                                                    <div class="subtext">
                                                        <%= item.gender ? item.gender + ' • ' : '' %>
                                                        <%= item.age ? item.age + ' वर्ष' : (item.dob ? 'DOB: ' + item.dob : '') %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Form Type -->
                                        <td>
                                            <span class="type-pill pill-<%= item._formType %>">
                                                <i class="fa-solid <%= item._icon %>"></i>
                                                <%= item._typeLabel %>
                                            </span>
                                        </td>

                                        <!-- Mobile / Contact -->
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 6px;">
                                                <a href="tel:<%= item._mobile %>" style="color: inherit; text-decoration: none;">
                                                    <i class="fa-solid fa-phone text-xs" style="color: var(--primary);"></i>
                                                    <%= item._mobile %>
                                                </a>
                                                <% if (item._mobile && item._mobile !== 'N/A') { %>
                                                    <a href="https://wa.me/91<%= item._mobile.replace(/\D/g,'') %>" target="_blank" title="WhatsApp पर चैट करें" style="color: #25d366; font-size: 13px;">
                                                        <i class="fa-brands fa-whatsapp"></i>
                                                    </a>
                                                <% } %>
                                            </div>
                                            <% if (item._email) { %>
                                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                                                    <i class="fa-regular fa-envelope text-xs"></i>
                                                    <%= item._email %>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Location -->
                                        <td>
                                            <div style="font-weight: 600; color: var(--text-dark);">
                                                <i class="fa-solid fa-location-dot text-xs" style="color: #e11d48; margin-right: 4px;"></i>
                                                <%= item._location %>
                                            </div>
                                        </td>

                                        <!-- Date -->
                                        <td>
                                            <div style="font-weight: 600;">
                                                <%= item._date ? new Date(item._date).toLocaleDateString('hi-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                                            </div>
                                            <div style="font-size: 11px; color: var(--text-muted);">
                                                <%= item._date ? new Date(item._date).toLocaleTimeString('hi-IN', { hour: '2-digit', minute: '2-digit' }) : '' %>
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            <% if (item._formType !== 'user') { %>
                                                <select 
                                                    class="status-badge-select status-<%= (item._status || 'Pending').replace(/\s+/g, '-') %>" 
                                                    onchange="updateStatus('<%= item._formType %>', '<%= item._id %>', this.value, this)"
                                                >
                                                    <option value="Pending" <%= item._status === 'Pending' ? 'selected' : '' %>>Pending (लंबित)</option>
                                                    <option value="Approved" <%= item._status === 'Approved' ? 'selected' : '' %>>Approved (स्वीकृत)</option>
                                                    <option value="Under Review" <%= item._status === 'Under Review' ? 'selected' : '' %>>Under Review (समीक्षाधीन)</option>
                                                    <option value="Rejected" <%= item._status === 'Rejected' ? 'selected' : '' %>>Rejected (अस्वीकृत)</option>
                                                    <% if (item._formType === 'contact') { %>
                                                        <option value="Resolved" <%= item._status === 'Resolved' ? 'selected' : '' %>>Resolved (निस्तारित)</option>
                                                    <% } %>
                                                </select>
                                            <% } else { %>
                                                <span class="status-badge-select status-Active">Active</span>
                                            <% } %>
                                        </td>

                                        <!-- Action -->
                                        <td style="text-align: right;">
                                            <div class="action-btns" style="justify-content: flex-end;">
                                                <button 
                                                    type="button" 
                                                    class="btn-icon" 
                                                    onclick="viewDetails('<%= item._formType %>', '<%= item._id %>')"
                                                    title="पूरा विवरण देखें"
                                                >
                                                    <i class="fa-regular fa-eye"></i>
                                                </button>
                                                <button 
                                                    type="button" 
                                                    class="btn-icon btn-delete" 
                                                    onclick="deleteItem('<%= item._formType %>', '<%= item._id %>', '<%= item._applicantName %>')"
                                                    title="डिलीट करें"
                                                >
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="fa-regular fa-folder-open"></i>
                                            <h3>कोई आवेदन नहीं मिला</h3>
                                            <p>इस श्रेणी में अभी तक कोई फ़ॉर्म सबमिट नहीं किया गया है अथवा सर्च से कोई परिणाम मेल नहीं खा रहा।</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <!-- ==================== DETAIL INSPECTION MODAL ==================== -->
    <div class="modal-overlay" id="detailModal">
        <div class="modal-container">
            <div class="modal-header">
                <h2>
                    <span id="modalFormTypeBadge" class="type-pill pill-volunteer">Volunteer</span>
                    <span id="modalTitle">आवेदन संपूर्ण विवरण</span>
                </h2>
                <button type="button" class="btn-close-modal" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body" id="modalBody">
                <div style="text-align: center; padding: 40px;">
                    <i class="fa-solid fa-circle-notch fa-spin text-3xl text-primary"></i>
                    <p style="margin-top: 10px; color: var(--text-muted);">लोड हो रहा है...</p>
                </div>
            </div>
            <div class="modal-footer" id="modalFooter">
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="btn-action btn-outline" onclick="window.print()">
                        <i class="fa-solid fa-print"></i> प्रिंट (Print)
                    </button>
                </div>
                <div style="display: flex; gap: 8px;" id="modalActionBtns">
                    <!-- Dynamic status buttons -->
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="adminToast"></div>

    <!-- ==================== JAVASCRIPT ==================== -->
    <script>
        // Copy to clipboard
        function copyId(id) {
            navigator.clipboard.writeText(id).then(() => {
                showToast(`ID ${id} कॉपी हो गई!`);
            });
        }

        // Show Toast
        function showToast(msg) {
            const toast = document.getElementById('adminToast');
            toast.innerText = msg;
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 3000);
        }

        // Open Detail Modal
        async function viewDetails(formType, id) {
            const modal = document.getElementById('detailModal');
            const modalBody = document.getElementById('modalBody');
            const modalTitle = document.getElementById('modalTitle');
            const modalBadge = document.getElementById('modalFormTypeBadge');
            const modalActionBtns = document.getElementById('modalActionBtns');

            modal.classList.add('active');
            modalBody.innerHTML = `
                <div style="text-align: center; padding: 40px;">
                    <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 32px; color: var(--primary);"></i>
                    <p style="margin-top: 12px; color: var(--text-muted); font-weight: 600;">डेटा लोड किया जा रहा है...</p>
                </div>
            `;

            try {
                const res = await fetch(`/admin/forms/detail/${formType}/${id}`);
                const result = await res.json();

                if (!result.success || !result.data) {
                    modalBody.innerHTML = `<p style="color: var(--danger); text-align: center;">डेटा लोड नहीं हो सका।</p>`;
                    return;
                }

                const d = result.data;
                const r = result.raw;

                modalTitle.innerText = `${d._applicantName} (${d._uniqueId})`;
                modalBadge.className = `type-pill pill-${formType}`;
                modalBadge.innerHTML = `<i class="fa-solid ${d._icon}"></i> ${d._typeLabel}`;

                // Render fields based on formType
                let fieldsHtml = '';

                fieldsHtml += `
                    <div class="detail-field">
                        <div class="field-label">यूनिक ID (Unique ID)</div>
                        <div class="field-val" style="font-family: monospace; font-weight: 800; color: var(--primary);">${d._uniqueId}</div>
                    </div>
                    <div class="detail-field">
                        <div class="field-label">वर्तमान स्थिति (Status)</div>
                        <div class="field-val"><span class="status-badge-select status-${(d._status || 'Pending').replace(/\s+/g, '-')}">${d._status}</span></div>
                    </div>
                    <div class="detail-field">
                        <div class="field-label">आवेदक का पूरा नाम</div>
                        <div class="field-val">${d._applicantName}</div>
                    </div>
                    <div class="detail-field">
                        <div class="field-label">मोबाइल नंबर</div>
                        <div class="field-val">
                            <a href="tel:${d._mobile}" style="color: var(--primary); font-weight: 700; text-decoration: none;">${d._mobile}</a>
                            ${d.whatsapp ? ` &bull; WhatsApp: <a href="https://wa.me/91${d.whatsapp.replace(/\D/g,'')}" target="_blank" style="color: #10b981;">${d.whatsapp}</a>` : ''}
                        </div>
                    </div>
                    <div class="detail-field">
                        <div class="field-label">ईमेल (Email)</div>
                        <div class="field-val">${d._email || 'उपलब्ध नहीं'}</div>
                    </div>
                    <div class="detail-field">
                        <div class="field-label">लिंग एवं आयु / DOB</div>
                        <div class="field-val">${d.gender || 'N/A'} ${d.age ? ' &bull; ' + d.age + ' वर्ष' : ''} ${d.dob ? ' &bull; DOB: ' + d.dob : ''}</div>
                    </div>
                `;

                if (formType === 'volunteer') {
                    fieldsHtml += `
                        <div class="detail-field">
                            <div class="field-label">राज्य एवं जिला</div>
                            <div class="field-val">${r.state || 'Bihar'} &bull; ${r.district || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">विधानसभा / गांव / पिनकोड</div>
                            <div class="field-val">${r.assemblyConstituency || 'N/A'} &bull; ${r.village || ''} ${r.pinCode ? '(' + r.pinCode + ')' : ''}</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">वालंटियर कार्य क्षेत्र (Volunteer Roles)</div>
                            <div class="field-val">${Array.isArray(r.volunteerTypes) ? r.volunteerTypes.join(', ') : (r.volunteerTypes || 'General')}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">समय उपलब्धता (Availability)</div>
                            <div class="field-val">${r.availability || 'Full Time'}</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">विशेष कौशल एवं अनुभव (Skills)</div>
                            <div class="field-val">${r.skills || r.previousExperience || 'उल्लेखित नहीं'}</div>
                        </div>
                    `;
                } else if (formType === 'scholarship') {
                    fieldsHtml += `
                        <div class="detail-field">
                            <div class="field-label">पिता का नाम (Father's Name)</div>
                            <div class="field-val">${r.fatherName || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">सामाजिक वर्ग / श्रेणी (Category)</div>
                            <div class="field-val">${r.category || 'Nishad / Mallah'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">वर्तमान पाठ्यक्रम (Current Course)</div>
                            <div class="field-val" style="color: var(--primary);">${r.currentCourse || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">शिक्षण संस्थान (College / School)</div>
                            <div class="field-val">${r.institute || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">पिछली परीक्षा प्रतिशत (Percentage Marks)</div>
                            <div class="field-val">${r.percentageMarks || 'N/A'}%</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">परिवार की वार्षिक आय (Annual Income)</div>
                            <div class="field-val">${r.familyAnnualIncome || 'N/A'}</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">स्थाई पता (Full Address)</div>
                            <div class="field-val">${r.address || ''}, विधानसभा: ${r.assembly || ''}, जिला: ${r.district || ''}</div>
                        </div>
                    `;
                } else if (formType === 'candidature') {
                    fieldsHtml += `
                        <div class="detail-field">
                            <div class="field-label">पिता/पति का नाम</div>
                            <div class="field-val">${r.fatherOrHusbandName || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">दावेदारी विधानसभा (UP Assembly)</div>
                            <div class="field-val" style="color: #e11d48; font-weight: 800;">${r.assemblyConstituency || 'N/A'} (${r.district || 'N/A'})</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">जाति / समुदाय</div>
                            <div class="field-val">${r.casteCommunity || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">शैक्षणिक योग्यता एवं व्यवसाय</div>
                            <div class="field-val">${r.education || 'N/A'} &bull; ${r.profession || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">वीआईपी पार्टी में सक्रियता</div>
                            <div class="field-val">${r.activeInVipSince || 'N/A'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">आपराधिक मामले (Criminal Cases)</div>
                            <div class="field-val" style="${r.criminalCases && r.criminalCases !== 'None' ? 'color: red;' : 'color: green;'}">${r.criminalCases || 'None'}</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">राजनीतिक एवं सामाजिक अनुभव</div>
                            <div class="field-val">${r.politicalExperience || 'कोई विवरण नहीं दिया गया'}</div>
                        </div>
                    `;
                } else if (formType === 'join') {
                    fieldsHtml += `
                        <div class="detail-field">
                            <div class="field-label">सदस्यता प्रकार (Member Type)</div>
                            <div class="field-val">${r.type || 'party_member'}</div>
                        </div>
                        <div class="detail-field">
                            <div class="field-label">जिला एवं विधानसभा</div>
                            <div class="field-val">${r.district || ''} &bull; ${r.assembly || ''} (${r.state || 'Bihar'})</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">पता (Address)</div>
                            <div class="field-val">${r.address || ''} ${r.village ? 'गांव: ' + r.village : ''}</div>
                        </div>
                    `;
                } else if (formType === 'contact') {
                    fieldsHtml += `
                        <div class="detail-field full-width">
                            <div class="field-label">विषय (Subject)</div>
                            <div class="field-val" style="font-weight: 700; color: var(--primary);">${r.subject || 'General Inquiry'}</div>
                        </div>
                        <div class="detail-field full-width">
                            <div class="field-label">संदेश (Message)</div>
                            <div class="field-val" style="white-space: pre-wrap; background: #fff; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0;">${r.message || ''}</div>
                        </div>
                    `;
                }

                fieldsHtml += `
                    <div class="detail-field full-width">
                        <div class="field-label">सबमिशन का समय (Submitted At)</div>
                        <div class="field-val">${d._date ? new Date(d._date).toLocaleString('hi-IN') : 'N/A'}</div>
                    </div>
                `;

                modalBody.innerHTML = `<div class="detail-grid">${fieldsHtml}</div>`;

                // Status action buttons inside modal
                if (formType !== 'user') {
                    modalActionBtns.innerHTML = `
                        <button type="button" class="btn-action" style="background: #10b981; color: #fff;" onclick="quickModalStatus('${formType}', '${id}', 'Approved')">
                            <i class="fa-solid fa-check"></i> स्वीकृत करें (Approve)
                        </button>
                        <button type="button" class="btn-action" style="background: #ef4444; color: #fff;" onclick="quickModalStatus('${formType}', '${id}', 'Rejected')">
                            <i class="fa-solid fa-xmark"></i> अस्वीकृत करें (Reject)
                        </button>
                    `;
                } else {
                    modalActionBtns.innerHTML = '';
                }

            } catch (err) {
                console.error(err);
                modalBody.innerHTML = `<p style="color: var(--danger); text-align: center;">डेटा लोड करने में समस्या आई: ${err.message}</p>`;
            }
        }

        function closeModal() {
            document.getElementById('detailModal').classList.remove('active');
        }

        // Quick Modal Status
        async function quickModalStatus(formType, id, status) {
            await updateStatus(formType, id, status);
            closeModal();
            window.location.reload();
        }

        // Update Status API
        async function updateStatus(formType, id, newStatus, selectElement) {
            try {
                const res = await fetch('/admin/forms/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ formType, id, newStatus })
                });
                const result = await res.json();
                if (result.success) {
                    showToast(`स्थिति बदलकर "${newStatus}" कर दी गई`);
                    if (selectElement) {
                        selectElement.className = `status-badge-select status-${newStatus.replace(/\s+/g, '-')}`;
                    }
                } else {
                    alert('त्रुटि: ' + result.message);
                }
            } catch (err) {
                alert('त्रुटि: ' + err.message);
            }
        }

        // Delete Item API
        async function deleteItem(formType, id, name) {
            if (!confirm(`क्या आप सचमुच ${name || 'इस आवेदन'} को हमेशा के लिए डिलीट करना चाहते हैं?`)) {
                return;
            }

            try {
                const res = await fetch('/admin/forms/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ formType, id })
                });
                const result = await res.json();
                if (result.success) {
                    showToast('आवेदन सफलतापूर्वक हटा दिया गया');
                    const row = document.getElementById(`row-${formType}-${id}`);
                    if (row) row.remove();
                } else {
                    alert('त्रुटि: ' + result.message);
                }
            } catch (err) {
                alert('त्रुटि: ' + err.message);
            }
        }

        // Close modal on click outside
        document.getElementById('detailModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
</body>
</html>
